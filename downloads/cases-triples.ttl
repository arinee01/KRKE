        owl:NamedIndividual ;
    rdfs:label "Symphony No. 5 in D minor, Op. 47"@en ;
    cc:createdBy cc:DmitriShostakovich ;
    cc:creationYear 1937 ;
    cc:dataProvenance "documented case" ;
    cc:title "Symphony No. 5 in D minor, Op. 47" .

cc:SovietComposersUnion a cc:CensoringAgent,
        owl:NamedIndividual ;
    rdfs:label "Union of Soviet Composers and Party officials"@en ;
    cc:dataProvenance "documented case" .

