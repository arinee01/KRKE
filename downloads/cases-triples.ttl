cc:CON_Ballo_Regicide a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Ballo_RegicidePlot ;
    cc:dataProvenance "documented case" ;
    cc:description "A royal assassination and the sovereign status of the protagonist could not be represented in the proposed form." ;
    cc:hasConstraintType cc:DirectRepresentationRestriction,
        cc:SubjectRestriction .

cc:CON_Ballo_SovereignRepresentation a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Ballo_SettingCharacters ;
    cc:dataProvenance "documented case" ;
    cc:description "The central assassination plot could remain only after the sovereign and European political context were transformed." ;
    cc:hasConstraintType cc:DirectRepresentationRestriction,
        cc:SubjectRestriction .

cc:CON_Bulgakov_PoliticalExpression a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Bulgakov_PoliticalSatire ;
    cc:dataProvenance "documented case" ;
    cc:description "Political and satirical expression had to be developed in an environment in which Bulgakov could not expect normal publication of original fiction." ;
    cc:hasConstraintType cc:ExpressionRestriction,
        cc:PublicationRestriction .

cc:CON_MasterMargarita_PublicationCuts a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_MasterMargarita_CutPassages ;
    cc:dataProvenance "documented case" ;
    cc:description "Only a substantially abridged version of the novel could appear in the Soviet journal." ;
    cc:hasConstraintType cc:ContentRestriction .

cc:CON_Nolde_ProfessionalPractice a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Nolde_ArtMaking ;
    cc:dataProvenance "documented case" ;
    cc:description "The professional ban prevented Nolde from officially practising, exhibiting, and selling art and limited his access to normal artistic materials and channels." ;
    cc:hasConstraintType cc:MaterialRestriction,
        cc:ProfessionalPracticeRestriction .

cc:CON_Notorious_Kissing a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Notorious_KissScene ;
    cc:dataProvenance "documented case" ;
    cc:description "Production Code: 'Excessive and lustful kissing ... are not to be shown'; enforced through an unofficial rule of thumb that a screen kiss should not exceed about three seconds." ;
    cc:hasConstraintType cc:ContentRestriction,
        cc:DirectRepresentationRestriction .

cc:CON_Panahi_Filmmaking a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Panahi_FilmmakingActivity ;
    cc:dataProvenance "documented case" ;
    cc:description "Panahi was prohibited from making or directing films and from writing screenplays for twenty years." ;
    cc:hasConstraintType cc:ExpressionRestriction,
        cc:ProfessionalPracticeRestriction .

cc:CON_Streetcar_SexualContent a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Streetcar_SexualThemes ;
    cc:dataProvenance "documented case" ;
    cc:description "The adaptation could not directly represent or clearly state several sexual themes in the same form as the play, and the filmmakers were pressed to alter their treatment." ;
    cc:hasConstraintType cc:ContentRestriction,
        cc:DirectRepresentationRestriction,
        cc:SubjectRestriction .

