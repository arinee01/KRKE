        owl:NamedIndividual ;
    rdfs:label "Alfred Hitchcock"@en ;
    cc:dataProvenance "documented case" .

cc:CON_Notorious_Kissing a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Notorious_KissScene ;
    cc:dataProvenance "documented case" ;
    cc:description "Production Code: 'Excessive and lustful kissing ... are not to be shown'; enforced through an unofficial rule of thumb that a screen kiss should not exceed about three seconds." ;
    cc:hasConstraintType cc:ContentRestriction,
        cc:DirectRepresentationRestriction .

cc:EV_HKR_PrintApproval a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Four-year GDR print-approval process: manuscript submitted to Mitteldeutscher Verlag end 1981, passed to the Hauptverwaltung end 1983; negative expert report by Werner Neubert (July 1984); Höpcke changed 'refusal' to 'needs further work'; renewed unsuccessful attempts to obtain changes; approval early 1985." ;
    cc:documentedBy cc:SRC_Darnton1991,
        cc:SRC_GuibertYeche,
        cc:SRC_Hoepcke1985,
        cc:SRC_Lance_Metailie,
        cc:SRC_bpb_Selbstzensur ;
    cc:eventDate 1985 ;
    cc:hasResponse cc:RE_HKR_IronicNarration,
        cc:RE_HKR_Lesehilfe ;
    cc:imposedBy cc:HV_Verlage_Buchhandel ;
    cc:imposesConstraint cc:CON_HKR_Ideology ;
    cc:targetsWork cc:HinzeKunzeRoman ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

cc:EV_Notorious_PCAReview a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Production Code Administration review of the script: Joseph Breen called it 'definitely unacceptable' (25 May 1945); a further review (25 July 1945) listed 17 required changes, incl. removing five uses of 'tramp' for Alicia." ;
    cc:documentedBy cc:SRC_Billheimer2019,
        cc:SRC_HitchZone_PCA ;
    cc:eventDate 1945 ;
    cc:hasResponse cc:RE_Notorious_FragmentedKiss ;
    cc:imposedBy cc:PCA ;
    cc:imposesConstraint cc:CON_Notorious_Character,
        cc:CON_Notorious_Kissing ;
    cc:targetsWork cc:Notorious1946 ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

cc:RE_HKR_IronicNarration a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Braun frames the critique in an ironic, Diderot-like master-servant narrative with an intrusive narrator who comments on what 'cannot be said directly'." ;
    cc:documentedBy cc:SRC_Darnton1991,
        cc:SRC_Lance_Metailie ;
    cc:eventDate 1981 ;
    cc:hasOutcome cc:CreativeAdaptation ;
    cc:performedBy cc:VolkerBraun ;
    cc:respondsTo cc:CON_HKR_Ideology ;
    cc:usesStrategy cc:Allegory,
        cc:Irony .

cc:RE_HKR_Lesehilfe a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Dieter Schlenstedt, one of the manuscript's first reviewers, writes an appended 'schöngeistige Lesehilfe': five fictional letters that ironise the review process and guide readers; the text was meant both to placate the censors and to guide reading." ;
    cc:documentedBy cc:SRC_GuibertYeche,
        cc:SRC_Hoepcke1985,
        cc:SRC_Lance_Metailie,
        cc:SRC_bpb_Selbstzensur ;
    cc:eventDate 1985 ;
    cc:hasOutcome cc:AlternativeVersionProduced ;
    cc:performedBy cc:DieterSchlenstedt ;
    cc:producesVersion cc:HKR_GDR_1985 ;
    cc:respondsTo cc:CON_HKR_Ideology ;
    cc:usesStrategy cc:Irony,
        cc:ParatextualFraming .

cc:RE_Notorious_FragmentedKiss a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Hitchcock stages a scene of about two and a half to three minutes as a chain of short kisses (none longer than ~3 seconds), interrupted by talk and a telephone call, so the scene stays within the rule but reads as one continuous embrace." ;
    cc:documentedBy cc:SRC_Billheimer2019,
        cc:SRC_HitchZone_PCA ;
    cc:eventDate 1946 ;
    cc:hasOutcome cc:CreativeAdaptation ;
    cc:performedBy cc:AlfredHitchcock ;
    cc:respondsTo cc:CON_Notorious_Kissing ;
    cc:usesStrategy cc:Fragmentation,
        cc:IndirectRepresentation .

cc:RE_Shost_FifthSymphony a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Fifth Symphony (composed 18 April–20 July 1937; premiered 21 November 1937, Leningrad Philharmonic, Mravinsky): a turn 'towards greater accessibility, towards greater simplicity', classical form and tonal harmony, with a finale whose triumph has been heard as sincere or ironic." ;
    cc:documentedBy cc:SRC_FrolovaWalker2023,
        cc:SRC_Robinson_BSO,
        cc:SRC_Wiki_Muddle ;
    cc:eventDate 1937 ;
    cc:hasOutcome cc:CreativeAdaptation ;
    cc:performedBy cc:DmitriShostakovich ;
    cc:respondsTo cc:CON_Shost_Formalism ;
    cc:resultsInWork cc:ShostakovichSymphony5 ;
    cc:usesStrategy cc:Ambiguity .

cc:RE_Sym4_Withdrawal a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Shostakovich withdraws the Fourth Symphony; it remains unperformed until 1961." ;
    cc:documentedBy cc:SRC_FrolovaWalker2023,
        cc:SRC_Wiki_Sym4 ;
    cc:eventDate 1936 ;
    cc:hasOutcome cc:UnpublishedWork ;
    cc:performedBy cc:DmitriShostakovich ;
    cc:respondsTo cc:CON_Shost_Formalism .

cc:CON_HKR_Ideology a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_HKR_PartyPrivilegeSatire ;
    cc:dataProvenance "documented case" ;
    cc:description "Objections that the irony targets socialism, distorts the concept of freedom and represents the Liebknecht-Luxemburg commemoration unworthily (Neubert report, July 1984)." ;
    cc:hasConstraintType cc:SubjectRestriction .

