cc:RE_Ballo_LeaveNaples a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Verdi rejected the most drastic demanded alterations, broke the contract with Teatro San Carlo, and moved the project to Rome." ;
    cc:documentedBy cc:SRC_Giger1999_Ballo,
        cc:SRC_Ricordi_BalloCritical ;
    cc:eventDate 1858 ;
    cc:hasOutcome cc:Abandonment ;
    cc:performedBy cc:GiuseppeVerdi ;
    cc:respondsTo cc:CON_Ballo_Regicide ;
    cc:usesStrategy cc:InstitutionalCircumvention .

cc:RE_Ballo_Transposition a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Verdi and Somma transformed the setting and identities while preserving the dramatic structure: Sweden became colonial Boston, Gustav III became Governor Riccardo, and other characters were renamed." ;
    cc:documentedBy cc:SRC_Giger1999_Ballo,
        cc:SRC_Met_Ballo,
        cc:SRC_Ricordi_BalloCritical ;
    cc:eventDate 1859 ;
    cc:hasOutcome cc:CreativeAdaptation ;
    cc:performedBy cc:AntonioSomma,
        cc:GiuseppeVerdi ;
    cc:producesVersion cc:UnBalloInMaschera1859 ;
    cc:respondsTo cc:CON_Ballo_SovereignRepresentation ;
    cc:usesStrategy cc:CharacterTransformation,
        cc:HistoricalDisplacement,
        cc:NarrativeTransposition .

cc:RE_Bulgakov_AesopianExpression a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "The novel uses satire, ambiguity, fantastic displacement, and passages that scholars have discussed in terms of Aesopian language: indirect expression capable of carrying concealed political or social meanings." ;
    cc:documentedBy cc:SRC_Pope1977_Bulgakov,
        cc:SRC_Rosenshield1997_Bulgakov ;
    cc:eventDate 1930 ;
    cc:hasOutcome cc:CreativeAdaptation ;
    cc:performedBy cc:MikhailBulgakov ;
    cc:respondsTo cc:CON_Bulgakov_PoliticalExpression ;
    cc:resultsInWork cc:MasterAndMargarita ;
    cc:usesStrategy cc:AesopianLanguage,
        cc:Ambiguity,
        cc:IndirectRepresentation,
        cc:Satire .

cc:RE_HKR_IronicNarration a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Braun frames the critique in an ironic, Diderot-like master-servant narrative with an intrusive narrator who comments on what 'cannot be said directly'." ;
    cc:documentedBy cc:SRC_Darnton1991,
        cc:SRC_Lance_Metailie ;
    cc:eventDate 1981 ;
    cc:hasOutcome cc:CreativeAdaptation ;
    cc:performedBy cc:VolkerBraun ;
    cc:respondsTo cc:CON_HKR_Ideology ;
    cc:usesStrategy cc:Allegory,
        cc:Irony .

cc:RE_HKR_Lesehilfe a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Dieter Schlenstedt, one of the manuscript's first reviewers, writes an appended 'schöngeistige Lesehilfe': five fictional letters that ironise the review process and guide readers; the text was meant both to placate the censors and to guide reading." ;
    cc:documentedBy cc:SRC_GuibertYeche,
        cc:SRC_Hoepcke1985,
        cc:SRC_Lance_Metailie,
        cc:SRC_bpb_Selbstzensur ;
    cc:eventDate 1985 ;
    cc:hasOutcome cc:AlternativeVersionProduced ;
    cc:performedBy cc:DieterSchlenstedt ;
    cc:producesVersion cc:HKR_GDR_1985 ;
    cc:respondsTo cc:CON_HKR_Ideology ;
    cc:usesStrategy cc:Irony,
        cc:ParatextualFraming .

cc:RE_MasterMargarita_TextRestoration a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Elena Bulgakova preserved and prepared the text for publication; omitted passages circulated outside the censored journal version, and complete versions were subsequently published abroad, including a complete Russian text." ;
    cc:documentedBy cc:SRC_Curtis2019_Bulgakov,
        cc:SRC_Pope1977_Bulgakov ;
    cc:eventDate 1969 ;
    cc:hasOutcome cc:AlternativeVersionProduced ;
    cc:performedBy cc:ElenaBulgakova ;
    cc:producesVersion cc:MasterMargarita_FullRussian1969 ;
    cc:respondsTo cc:CON_MasterMargarita_PublicationCuts ;
    cc:usesStrategy cc:AlternativePublication,
        cc:TextualRestoration .

cc:RE_Nolde_UnpaintedPictures a cc:CreativeResponse,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Nolde continued working privately and produced further small-format watercolours in Seebüll. Museum accounts describe these works as being made secretly during the period of prohibition." ;
