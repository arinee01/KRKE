cc:EV_HKR_PrintApproval a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Four-year GDR print-approval process: manuscript submitted to Mitteldeutscher Verlag end 1981, passed to the Hauptverwaltung end 1983; negative expert report by Werner Neubert (July 1984); Höpcke changed 'refusal' to 'needs further work'; renewed unsuccessful attempts to obtain changes; approval early 1985." ;
    cc:documentedBy cc:SRC_Darnton1991,
        cc:SRC_GuibertYeche,
        cc:SRC_Hoepcke1985,
        cc:SRC_Lance_Metailie,
        cc:SRC_bpb_Selbstzensur ;
