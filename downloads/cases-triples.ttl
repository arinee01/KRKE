        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "The historical regicide plot based on the assassination of King Gustav III of Sweden." .

cc:EL_Ballo_SettingCharacters a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Historical setting, political status of the protagonist, character identities, and context of the assassination." .

cc:EL_Bulgakov_PoliticalSatire a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Satirical and political treatment of Soviet institutions and social life." .

cc:EL_HKR_PartyPrivilegeSatire a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Ironic portrayal of a Party functionary (Kunze) and his chauffeur (Hinze); apparatchik privilege at the heart of the plot." .

cc:EL_MasterMargarita_CutPassages a cc:TextualElement,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Politically sensitive passages, references to arrests and the secret police, attacks on the Soviet literary establishment, sexual/nudity material, and other excised text." .

cc:EL_Nolde_ArtMaking a cc:CreativeActivity,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Professional production and public circulation of visual art." .

cc:EL_Notorious_AliciaCharacter a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Characterisation of Alicia Huberman's sexual morality." .

cc:EL_Notorious_KissScene a cc:Scene,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Love scene between Devlin (Cary Grant) and Alicia (Ingrid Bergman) in her Rio apartment." .

cc:EL_Panahi_FilmmakingActivity a cc:CreativeActivity,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Film directing and screenplay writing." .

cc:EL_Shost_ModernistIdiom a cc:AudioElement,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Dissonant, modernist musical idiom of Lady Macbeth (and of the Fourth Symphony in progress)." .

cc:EL_Streetcar_CutScenes a cc:Scene,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Several scenes and lines, including the Stella stairway sequence and dialogue surrounding Stanley's attack on Blanche." .

cc:EL_Streetcar_SexualThemes a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Allan Grey's homosexuality, Blanche's sexuality, Stanley's rape of Blanche, and the moral consequences of Stanley's actions." .

cc:EV_Ballo_NaplesCensorship1858 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "The opera intended for Teatro San Carlo in Naples encountered censorial objections to a plot based on the assassination of a monarch. The demanded changes became so extensive that Verdi broke the contract with the Naples theatre and took the project elsewhere." ;
    cc:documentedBy cc:SRC_Giger1999_Ballo,
        cc:SRC_Ricordi_BalloCritical ;
    cc:eventDate 1858 ;
    cc:hasResponse cc:RE_Ballo_LeaveNaples ;
    cc:imposedBy cc:NeapolitanCensors ;
    cc:imposesConstraint cc:CON_Ballo_Regicide ;
    cc:targetsWork cc:GustavoIII_OperaProject ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

cc:EV_Ballo_RomeCensorship1858 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "The project also underwent censorship in papal Rome. The final compromise relocated the action outside Europe to colonial Boston and transformed the historical Swedish king into the fictional Governor Riccardo, with corresponding changes to character names and political context." ;
    cc:documentedBy cc:SRC_Giger1999_Ballo,
        cc:SRC_Met_Ballo,
        cc:SRC_Ricordi_BalloCritical ;
    cc:eventDate 1858 ;
    cc:hasResponse cc:RE_Ballo_Transposition ;
    cc:imposedBy cc:PapalRomanCensors ;
    cc:imposesConstraint cc:CON_Ballo_SovereignRepresentation ;
    cc:targetsWork cc:GustavoIII_OperaProject ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

cc:EV_Bulgakov_LiterarySuppression1930s a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "By the late 1920s and 1930s Bulgakov's prospects for publishing original fiction had sharply deteriorated; scholarly accounts describe him as no longer able to publish original fiction while he continued work on The Master and Margarita." ;
    cc:documentedBy cc:SRC_Pope1977_Bulgakov,
        cc:SRC_Rosenshield1997_Bulgakov ;
    cc:eventDate 1930 ;
    cc:hasResponse cc:RE_Bulgakov_AesopianExpression ;
    cc:imposedBy cc:SovietLiteraryEstablishment ;
    cc:imposesConstraint cc:CON_Bulgakov_PoliticalExpression ;
    cc:targetsWork cc:MasterAndMargarita ;
    cc:usesMechanism cc:PublicationRestriction .

cc:EV_HKR_DistributionStop a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "After publication and hostile reviews (Neues Deutschland; critic Anneliese Löffler), distribution of the novel in the GDR was stopped on 10 September 1985; Höpcke received a formal Party censure. A new GDR edition appeared only in 1988." ;
    cc:documentedBy cc:SRC_Darnton1991,
        cc:SRC_Lance_Metailie ;
    cc:eventDate 1985 ;
    cc:imposesConstraint cc:CON_HKR_Distribution ;
    cc:targetsWork cc:HinzeKunzeRoman ;
    cc:usesMechanism cc:DistributionRestriction .

cc:EV_MasterMargarita_MoskvaCensorship1966 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "The novel's first Soviet publication in Moskva (1966-1967) was authorised only in a heavily cut form. Political and ideological passages, references to the secret police and arrests, attacks on the Soviet literary establishment, and other material were removed." ;
    cc:documentedBy cc:SRC_Curtis2019_Bulgakov,
        cc:SRC_Pope1977_Bulgakov ;
    cc:eventDate 1967 ;
    cc:hasResponse cc:RE_MasterMargarita_TextRestoration ;
    cc:imposedBy cc:SovietCensorship_Moskva ;
    cc:imposesConstraint cc:CON_MasterMargarita_PublicationCuts ;
    cc:targetsWork cc:MasterAndMargarita ;
    cc:usesMechanism cc:PublicationRestriction,
        cc:Redaction .

cc:EV_Nolde_ProfessionalBan1941 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "In 1941 Nolde was expelled from the Reich Chamber of Fine Arts and subjected to a professional ban. Official museum sources record that he nevertheless continued producing small-format watercolours, the so-called Unpainted Pictures." ;
    cc:documentedBy cc:SRC_NGI_NoldeDegenerate,
        cc:SRC_NoldeMuseum_Artist ;
    cc:eventDate 1941 ;
    cc:hasResponse cc:RE_Nolde_UnpaintedPictures ;
    cc:imposedBy cc:ReichChamberFineArts ;
    cc:imposesConstraint cc:CON_Nolde_ProfessionalPractice ;
    cc:targetsPractice cc:NoldeArtisticPractice ;
    cc:usesMechanism cc:Ban .

cc:EV_Panahi_2010FilmmakingBan a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "On 20 December 2010, Panahi was sentenced to six years in prison and a 20-year ban on making films, writing screenplays, giving interviews, and travelling abroad. In 2011, Cannes described This Is Not a Film as made under semi-clandestine conditions while the ban was in force." ;
    cc:documentedBy cc:SRC_Cannes_Panahi2011,
        cc:SRC_Cannes_ThisIsNotAFilm2011,
        cc:SRC_CinemaIranica_TINAF,
        cc:SRC_IranHumanRights_Panahi2010 ;
    cc:eventDate 2010 ;
    cc:hasResponse cc:RE_Panahi_ThisIsNotAFilm ;
    cc:imposedBy cc:TehranRevolutionaryCourt_Branch26 ;
    cc:imposesConstraint cc:CON_Panahi_Filmmaking ;
    cc:targetsPractice cc:PanahiFilmmakingPractice ;
    cc:usesMechanism cc:Ban .

cc:EV_Pravda1936 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Unsigned Pravda editorial 'Muddle Instead of Music' (28 January 1936), two days after Stalin attended the opera; further Pravda attacks followed; the opera disappeared from the repertoire (last performance 11 March 1936)." ;
    cc:documentedBy cc:SRC_FrolovaWalker2023,
        cc:SRC_Robinson_BSO,
        cc:SRC_Wiki_Muddle ;
    cc:eventDate 1936 ;
    cc:hasResponse cc:RE_Shost_FifthSymphony ;
    cc:imposedBy cc:Pravda ;
    cc:imposesConstraint cc:CON_Shost_Formalism ;
    cc:targetsWork cc:LadyMacbethMtsensk ;
    cc:usesMechanism cc:Ban,
        cc:Removal .

cc:EV_Streetcar_LegionCuts1951 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "After the film was completed, the Catholic Legion of Decency condemned it. Warner Bros., working with the MPAA and without consulting Kazan, made twelve cuts totalling roughly three to four minutes to obtain an acceptable rating." ;
    cc:documentedBy cc:SRC_AFI_Streetcar1951,
        cc:SRC_Szabo2019_Streetcar ;
    cc:eventDate 1951 ;
    cc:hasOutcome cc:Suppression ;
    cc:imposedBy cc:CatholicLegionOfDecency ;
    cc:imposesConstraint cc:CON_Streetcar_ReleaseCuts ;
    cc:targetsWork cc:Streetcar1951 ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:Removal .

cc:EV_Streetcar_PCAReview1950 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "During Production Code Administration review in 1950, the screenplay was challenged over three principal issues: the homosexuality of Blanche's late husband, Blanche's sexual behaviour, and the rape. The PCA proposed plot and dialogue changes before approval." ;
    cc:documentedBy cc:SRC_AFI_Streetcar1951,
        cc:SRC_Szabo2019_Streetcar ;
    cc:eventDate 1950 ;
    cc:hasResponse cc:RE_Streetcar_ScreenplayRewrite ;
    cc:imposedBy cc:PCA ;
    cc:imposesConstraint cc:CON_Streetcar_SexualContent ;
    cc:targetsWork cc:Streetcar1951 ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

cc:EV_Sym4_Cancellation a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Premiere planned for 11 December 1936 (Leningrad Philharmonic, Stiedry) cancelled after rehearsals; officially presented as the composer's withdrawal, while other accounts (Glikman) report pressure from Party and Composers' Union officials." ;
    cc:documentedBy cc:SRC_FrolovaWalker2023,
        cc:SRC_Wiki_Sym4 ;
    cc:eventDate 1936 ;
    cc:hasResponse cc:RE_Sym4_Withdrawal ;
    cc:imposedBy cc:SovietComposersUnion ;
    cc:imposesConstraint cc:CON_Shost_Formalism ;
    cc:targetsWork cc:ShostakovichSymphony4 ;
    cc:usesMechanism cc:Ban,
        cc:SelfCensorship .

