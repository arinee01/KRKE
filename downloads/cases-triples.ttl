    cc:hasResponse cc:RE_HKR_IronicNarration,
        cc:RE_HKR_Lesehilfe ;
    cc:imposedBy cc:HV_Verlage_Buchhandel ;
    cc:imposesConstraint cc:CON_HKR_Ideology ;
    cc:targetsWork cc:HinzeKunzeRoman ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

cc:EV_Notorious_PCAReview a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Production Code Administration review of the script: Joseph Breen called it 'definitely unacceptable' (25 May 1945); a further review (25 July 1945) listed 17 required changes, incl. removing five uses of 'tramp' for Alicia." ;
    cc:documentedBy cc:SRC_Billheimer2019,
        cc:SRC_HitchZone_PCA ;
    cc:eventDate 1945 ;
    cc:hasResponse cc:RE_Notorious_FragmentedKiss ;
    cc:imposedBy cc:PCA ;
    cc:imposesConstraint cc:CON_Notorious_Character,
        cc:CON_Notorious_Kissing ;
    cc:targetsWork cc:Notorious1946 ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

