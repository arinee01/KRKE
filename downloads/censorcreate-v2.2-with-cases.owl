    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_HKR_DistributionStop">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <dataProvenance>documented case</dataProvenance>
    <usesMechanism rdf:resource="http://example.org/censorcreate#DistributionRestriction"/>
    <description>After publication and hostile reviews (Neues Deutschland; critic Anneliese Löffler), distribution of the novel in the GDR was stopped on 10 September 1985; Höpcke received a formal Party censure. A new GDR edition appeared only in 1988.</description>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_HKR_Distribution"/>
    <targetsWork rdf:resource="http://example.org/censorcreate#HinzeKunzeRoman"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</eventDate>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#WorkVersion">
    <rdfs:label xml:lang="en">Work version</rdfs:label>
    <rdfs:label xml:lang="ru">Версия произведения</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:comment xml:lang="en">A specific version of a creative work, for example a revised, cut, re-edited, or alternative version produced in response to censorship.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
