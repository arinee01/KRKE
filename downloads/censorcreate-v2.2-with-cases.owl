  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipEvent">
    <rdfs:comment xml:lang="en">A documented act or process of censorship affecting a creative work, carried out by a censoring agent through a censorship mechanism.</rdfs:comment>
    <rdfs:label xml:lang="en">Censorship event</rdfs:label>
    <rdfs:label xml:lang="ru">Цензурное событие</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#isTargetOf">
    <rdfs:label xml:lang="en">is target of</rdfs:label>
    <rdfs:label xml:lang="ru">является объектом</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of targetsWork: links a creative work to a censorship event that affects it.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <owl:inverseOf rdf:resource="http://example.org/censorcreate#targetsWork"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeWork"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#WebSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:comment xml:lang="en">A web page such as a publisher page, programme note, or encyclopedia entry. Tertiary web sources are used for orientation only. Added in v2.1.</rdfs:comment>
    <rdfs:label xml:lang="ru">Веб-источник</rdfs:label>
    <rdfs:label xml:lang="en">Web source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EmilNolde">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdfs:label xml:lang="en">Emil Nolde</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Streetcar_LegionCuts1951">
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#Removal"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1951</cc:eventDate>
    <cc:description>After the film was completed, the Catholic Legion of Decency condemned it. Warner Bros., working with the MPAA and without consulting Kazan, made twelve cuts totalling roughly three to four minutes to obtain an acceptable rating.</cc:description>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Streetcar_ReleaseCuts"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#CatholicLegionOfDecency"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#Suppression"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#Streetcar1951"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_CinemaIranica_TINAF">
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cinema.iranicaonline.org/film/this-is-not-a-film/</cc:sourceURL>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <cc:sourceTitle>This Is Not a Film</cc:sourceTitle>
    <rdfs:label xml:lang="en">This Is Not a Film</rdfs:label>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:bibliographicCitation>Cinema Iranica. This Is Not a Film (film entry).</cc:bibliographicCitation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#HistoricalDisplacement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Historical displacement</rdfs:label>
    <rdfs:comment>Moving sensitive content to another historical context to reduce its directness.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_MasterMargarita_PublicationCuts">
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_MasterMargarita_CutPassages"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#ContentRestriction"/>
    <cc:description>Only a substantially abridged version of the novel could appear in the Soviet journal.</cc:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Ambiguity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:comment xml:lang="en">Deliberate openness of meaning that allows several readings, including a restricted one.</rdfs:comment>
    <rdfs:label xml:lang="en">Ambiguity</rdfs:label>
    <rdfs:label xml:lang="ru">Двусмысленность</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Darnton1991">
    <cc:bibliographicCitation>Darnton, R. (1991). The Good Old Days. The New York Review of Books, 16 May 1991.</cc:bibliographicCitation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <rdfs:label xml:lang="en">The Good Old Days</rdfs:label>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nybooks.com/articles/1991/05/16/the-good-old-days/</cc:sourceURL>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1991</cc:publicationYear>
    <cc:sourceTitle>The Good Old Days</cc:sourceTitle>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Panahi_2010FilmmakingBan">
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_Panahi2011"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_CinemaIranica_TINAF"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_IranHumanRights_Panahi2010"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_ThisIsNotAFilm2011"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2010</cc:eventDate>
    <cc:targetsPractice rdf:resource="http://example.org/censorcreate#PanahiFilmmakingPractice"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:description>On 20 December 2010, Panahi was sentenced to six years in prison and a 20-year ban on making films, writing screenplays, giving interviews, and travelling abroad. In 2011, Cannes described This Is Not a Film as made under semi-clandestine conditions while the ban was in force.</cc:description>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Panahi_Filmmaking"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#Ban"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Panahi_ThisIsNotAFilm"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#TehranRevolutionaryCourt_Branch26"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#imposedBy">
    <rdfs:label xml:lang="ru">наложено</rdfs:label>
    <rdfs:label xml:lang="en">imposed by</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensoringAgent"/>
    <rdfs:comment xml:lang="en">Links a censorship event to the censoring agent responsible for it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Streetcar1951_ReleaseCut">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WorkVersion"/>
    <cc:title>A Streetcar Named Desire (1951 theatrical release with Legion/PCA cuts)</cc:title>
    <cc:creationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1951</cc:creationYear>
    <cc:versionOf rdf:resource="http://example.org/censorcreate#Streetcar1951"/>
    <rdfs:label xml:lang="en">A Streetcar Named Desire (1951 theatrical release with Legion/PCA cuts)</rdfs:label>
    <cc:createdBy rdf:resource="http://example.org/censorcreate#TennesseeWilliams"/>
    <cc:createdBy rdf:resource="http://example.org/censorcreate#EliaKazan"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Notorious_FragmentedKiss">
    <cc:description>Hitchcock stages a scene of about two and a half to three minutes as a chain of short kisses (none longer than ~3 seconds), interrupted by talk and a telephone call, so the scene stays within the rule but reads as one continuous embrace.</cc:description>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1946</cc:eventDate>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_HitchZone_PCA"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Billheimer2019"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_Notorious_Kissing"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#Fragmentation"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#IndirectRepresentation"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#AlfredHitchcock"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#HKR_GDR_1985">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WorkVersion"/>
    <cc:createdBy rdf:resource="http://example.org/censorcreate#DieterSchlenstedt"/>
    <cc:createdBy rdf:resource="http://example.org/censorcreate#VolkerBraun"/>
    <cc:creationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</cc:creationYear>
    <cc:title>Hinze-Kunze-Roman, Mitteldeutscher Verlag (Halle) 1985 edition with Schlenstedt's afterword; the simultaneous Suhrkamp edition appeared without it</cc:title>
    <rdfs:label xml:lang="en">Hinze-Kunze-Roman, Mitteldeutscher Verlag (Halle) 1985 edition with Schlenstedt's afterword; the simultaneous Suhrkamp edition appeared without it</rdfs:label>
    <cc:versionOf rdf:resource="http://example.org/censorcreate#HinzeKunzeRoman"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Streetcar_Rewrite">
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Streetcar_PCAReview1950"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Streetcar_ScreenplayRewrite"/>
    <cc:claimText>AFI's production-history record documents the PCA objections and Williams's rewritten ending, while scholarship on the adaptation describes the film as preserving much of the play's meaning through alterations required by censorship.</cc:claimText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Ballo_RomeCensorship1858">
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Met_Ballo"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#GustavoIII_OperaProject"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1858</cc:eventDate>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#PapalRomanCensors"/>
    <cc:description>The project also underwent censorship in papal Rome. The final compromise relocated the action outside Europe to colonial Boston and transformed the historical Swedish king into the fictional Governor Riccardo, with corresponding changes to character names and political context.</cc:description>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Ballo_Transposition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Ballo_SovereignRepresentation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Nolde_Watercolours">
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_NGI_NoldeDegenerate"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_NoldeMuseum_Artist"/>
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Nolde_ProfessionalBan1941"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Nolde_UnpaintedPictures"/>
    <cc:claimText>The Nolde Museum records the 1941 expulsion and professional ban followed by further small-format watercolours; the National Gallery of Ireland states that despite the ban he continued to create, turning to small watercolour compositions painted in secret. Because Nolde had already used this medium before 1941, the claim is about continuation/adaptation under constraint rather than the invention of a new medium.</cc:claimText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Symbolism">
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ru">Символизм</rdfs:label>
    <rdfs:label xml:lang="en">Symbolism</rdfs:label>
    <rdfs:comment xml:lang="en">Use of objects, images, or signs that stand for restricted ideas.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_NoldeMuseum_Artist">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nolde-museum.de/en/museum/der-kuenstler</cc:sourceURL>
    <cc:sourceTitle>The Artist</cc:sourceTitle>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <cc:bibliographicCitation>Nolde Museum Seebüll. The Artist (biographical chronology of Emil Nolde).</cc:bibliographicCitation>
    <rdfs:label xml:lang="en">The Artist</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ConstraintType">
    <rdfs:label xml:lang="ru">Тип ограничения</rdfs:label>
    <rdfs:label xml:lang="en">Constraint type</rdfs:label>
    <rdfs:comment xml:lang="en">A controlled category describing what a censorship constraint restricts, for example content, subject, or direct representation.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Streetcar_PCAReview1950">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1950</cc:eventDate>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#Streetcar1951"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Streetcar_SexualContent"/>
    <cc:description>During Production Code Administration review in 1950, the screenplay was challenged over three principal issues: the homosexuality of Blanche's late husband, Blanche's sexual behaviour, and the rape. The PCA proposed plot and dialogue changes before approval.</cc:description>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#PCA"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Streetcar_ScreenplayRewrite"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TennesseeWilliams">
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdfs:label xml:lang="en">Tennessee Williams</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MinimalProduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Minimal production</rdfs:label>
    <rdfs:comment>Reducing production scale or resources to continue creating under restrictions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Redaction">
    <rdfs:label xml:lang="ru">Вымарывание</rdfs:label>
    <rdfs:label xml:lang="en">Redaction</rdfs:label>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Deletion or obscuring of specific passages, scenes, or elements of a work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#PCA">
