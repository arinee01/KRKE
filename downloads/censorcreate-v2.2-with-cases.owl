    <rdfs:label xml:lang="en">Censored work</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:comment xml:lang="en">A creative work that is the target of at least one censorship event. Membership is inferred by a reasoner.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Ballo_Naples">
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Ballo_NaplesCensorship1858"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Ballo_LeaveNaples"/>
    <cc:claimText>Ricordi's critical-edition documentation states that censorship demands were severe enough for Verdi to break the Naples contract; scholarship on Verdi's censorship confirms that Un ballo in maschera had been rejected elsewhere before its Roman premiere.</cc:claimText>
  </rdf:Description>
