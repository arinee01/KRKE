  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ProfessionalPracticeRestriction">
    <rdfs:comment>A constraint that limits or prohibits a creator from carrying out their professional creative activity.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdfs:label xml:lang="en">Professional practice restriction</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#documentedBy">
    <rdfs:comment xml:lang="en">Links a censorship event or creative response to a source that documents it.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:label xml:lang="en">documented by</rdfs:label>
    <rdfs:label xml:lang="ru">задокументировано в</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Event"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CatholicLegionOfDecency">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAgent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Catholic Legion of Decency, with MPAA involvement</rdfs:label>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AlternativePublication">
    <rdfs:comment>A strategy of publishing a work through an alternative channel when normal publication is restricted.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Alternative publication</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Scene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Сцена</rdfs:label>
    <rdfs:label xml:lang="en">Scene</rdfs:label>
    <rdfs:comment xml:lang="en">A distinct scene or episode of a film, play, or narrative.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Removal">
    <rdfs:comment xml:lang="en">Withdrawal of a work, or of a part of it, from circulation, display, or a collection.</rdfs:comment>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Removal</rdfs:label>
    <rdfs:label xml:lang="ru">Изъятие</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Streetcar_SexualThemes">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#Theme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:description>Allan Grey's homosexuality, Blanche's sexuality, Stanley's rape of Blanche, and the moral consequences of Stanley's actions.</cc:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensoredWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Цензурированное произведение</rdfs:label>
    <rdfs:label xml:lang="en">Censored work</rdfs:label>
    <owl:equivalentClass rdf:nodeID="n2996ffa38f6b4bf8b8d694df67344241b7"/>
    <rdfs:comment xml:lang="en">A creative work that is the target of at least one censorship event. Membership is inferred by a reasoner.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Shost_ModernistIdiom">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#AudioElement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:description>Dissonant, modernist musical idiom of Lady Macbeth (and of the Fourth Symphony in progress).</cc:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ParatextualFraming">
    <rdfs:label xml:lang="en">Paratextual framing</rdfs:label>
    <rdfs:label xml:lang="ru">Паратекстуальное обрамление</rdfs:label>
    <rdfs:comment xml:lang="en">Adding a preface, afterword, commentary, or other accompanying text that guides interpretation and makes the work acceptable to censors. Added in v2.1.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#eventDate">
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:label xml:lang="en">event date</rdfs:label>
    <rdfs:label xml:lang="ru">дата события</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">The year a censorship event or creative response took place (recorded as a year).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#imposesConstraint">
    <rdfs:label xml:lang="en">imposes constraint</rdfs:label>
    <rdfs:label xml:lang="ru">накладывает ограничение</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Links a censorship event to the constraint it creates for the creator.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CharacterTransformation">
    <rdfs:label xml:lang="en">Character transformation</rdfs:label>
    <rdfs:comment>A strategy of changing a character’s identity, role, or status to meet censorship constraints.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SovietLiteraryEstablishment">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAuthority"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Soviet literary and censorship establishment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate">
    <rdfs:label xml:lang="en">ConCreCen — Core Ontology v2</rdfs:label>
    <owl:versionInfo>v2.2 (merged: +5 cases, +Editor/+CreativePractice, performedBy-&gt;Agent, producesWork unified into resultsInWork)</owl:versionInfo>
    <rdfs:comment xml:lang="en">A core ontology for representing censorship events, the constraints they impose on creative works, the documented creative responses of creators, the strategies used in those responses, their outcomes, and the sources and claims that support them. The model is conditional, not deterministic: censorship may lead to suppression, modification, abandonment, or creative adaptation. Theoretical basis: R. Darnton (censorship as an institutional process), P. D. Stokes (creativity from constraints), B. D. Rosso (enabling and disabling effects of constraints).</rdfs:comment>
    <skos:changeNote xml:lang="en">v2: (1) domain of hasOutcome narrowed from Event to CreativeResponse; (2) English and Russian labels and English definitions added to all classes, properties and controlled values; (3) DistributionRestriction mechanism and a small set of documentation data properties added; (4) test individuals kept and marked as synthetic; (5) no real historical cases added. v2.1: data properties aligned with project documentation (eventDate, publicationYear); added resultsInWork, StylisticRestriction, Irony, ParatextualFraming, Fragmentation.</skos:changeNote>
    <owl:versionIRI rdf:resource="http://example.org/censorcreate/2.2"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Censorship and Creative Response Core Ontology</dcterms:title>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Constraint">
    <rdfs:comment xml:lang="en">A limitation on the range of available solutions in a creative process. Constraints may be technical, economic, social, legal, or institutional.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Constraint</rdfs:label>
    <rdfs:label xml:lang="ru">Ограничение</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Streetcar_Rewrite">
    <cc:claimText>AFI's production-history record documents the PCA objections and Williams's rewritten ending, while scholarship on the adaptation describes the film as preserving much of the play's meaning through alterations required by censorship.</cc:claimText>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Streetcar_ScreenplayRewrite"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Streetcar_PCAReview1950"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:confidenceLevel>high</cc:confidenceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AdaptiveCreativeResponse">
    <rdfs:label xml:lang="ru">Адаптивный творческий ответ</rdfs:label>
    <rdfs:label xml:lang="en">Adaptive creative response</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <owl:equivalentClass rdf:nodeID="n2996ffa38f6b4bf8b8d694df67344241b1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A creative response that uses at least one creative strategy and has the outcome CreativeAdaptation. Membership is inferred by a reasoner.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MediumAdaptation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Medium adaptation</rdfs:label>
    <rdfs:comment>Сhanging the artistic medium or technique in response to a constraint.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2996ffa38f6b4bf8b8d694df67344241b2">
    <owl:onProperty rdf:resource="http://example.org/censorcreate#usesStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeResponse">
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:label xml:lang="ru">Творческий ответ</rdfs:label>
    <rdfs:label xml:lang="en">Creative response</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A documented action of a creator in reaction to a censorship constraint, for example revising, encoding, relocating, or abandoning a work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Lance_Metailie">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://editions-metailie.com/livre/le-roman-de-hinze-et-kunze/</cc:sourceURL>
    <rdfs:label xml:lang="en">Le Roman de Hinze et Kunze (preface, publisher page)</rdfs:label>
    <cc:bibliographicCitation>Lance, A. Preface to V. Braun, Le Roman de Hinze et Kunze. Éditions Métailié (reissue of the 1988 French translation).</cc:bibliographicCitation>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceTitle>Le Roman de Hinze et Kunze (preface, publisher page)</cc:sourceTitle>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2996ffa38f6b4bf8b8d694df67344241b9">
    <rdf:rest rdf:nodeID="n2996ffa38f6b4bf8b8d694df67344241b10"/>
    <rdf:first rdf:resource="http://example.org/censorcreate#CreativeWork"/>
  </rdf:Description>
