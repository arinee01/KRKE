    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Book"/>
    <rdfs:label xml:lang="en">Hitchcock and the Censors (ch. 14 'Notorious (1946)')</rdfs:label>
