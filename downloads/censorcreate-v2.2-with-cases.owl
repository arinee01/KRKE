  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Darnton1991">
    <dataProvenance>documented case</dataProvenance>
    <sourceTitle>The Good Old Days</sourceTitle>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <rdfs:label xml:lang="en">The Good Old Days</rdfs:label>
    <bibliographicCitation>Darnton, R. (1991). The Good Old Days. The New York Review of Books, 16 May 1991.</bibliographicCitation>
    <publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1991</publicationYear>
