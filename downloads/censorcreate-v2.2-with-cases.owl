    <cc:creationYear>1928-1940</cc:creationYear>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Shost_Formalism">
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_Shost_ModernistIdiom"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:description>Condemnation of 'formalism': dissonant, modernist musical language declared unacceptable; Kerzhentsev demanded a concrete demonstration of reform in future works.</cc:description>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#StylisticRestriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ParatextualFraming">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Paratextual framing</rdfs:label>
    <rdfs:label xml:lang="ru">Паратекстуальное обрамление</rdfs:label>
    <rdfs:comment xml:lang="en">Adding a preface, afterword, commentary, or other accompanying text that guides interpretation and makes the work acceptable to censors. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#eventDate">
    <rdfs:label xml:lang="en">event date</rdfs:label>
    <rdfs:label xml:lang="ru">дата события</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:comment xml:lang="en">The year a censorship event or creative response took place (recorded as a year).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AesopianLanguage">
    <rdfs:comment>A strategy of expressing sensitive meanings indirectly through coded or ambiguous language.</rdfs:comment>
    <rdfs:label xml:lang="en">Aesopian language</rdfs:label>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Notorious_Character">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:description>Alicia must not appear as a 'grossly immoral woman'; any suggestion of sexual promiscuity to be avoided; the word 'tramp' to be removed.</cc:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_Notorious_AliciaCharacter"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#SubjectRestriction"/>
  </rdf:Description>
