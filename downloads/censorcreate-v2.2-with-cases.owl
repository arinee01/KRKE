    <rdfs:label xml:lang="en">Soviet literary and censorship establishment</rdfs:label>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Wiki_Sym4">
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Symphony_No._4_(Shostakovich)</cc:sourceURL>
