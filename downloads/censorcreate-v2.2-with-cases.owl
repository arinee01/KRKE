  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Ballo_Transposition">
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Met_Ballo"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#HistoricalDisplacement"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#NarrativeTransposition"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#CharacterTransformation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <cc:eventDate>1858-1859</cc:eventDate>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_Ballo_SovereignRepresentation"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#AntonioSomma"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#GiuseppeVerdi"/>
    <cc:description>Verdi and Somma transformed the setting and identities while preserving the dramatic structure: Sweden became colonial Boston, Gustav III became Governor Riccardo, and other characters were renamed.</cc:description>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:producesVersion rdf:resource="http://example.org/censorcreate#UnBalloInMaschera1859"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Ballo_LeaveNaples">
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_Ballo_Regicide"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#GiuseppeVerdi"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:description>Verdi rejected the most drastic demanded alterations, broke the contract with Teatro San Carlo, and moved the project to Rome.</cc:description>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1858</cc:eventDate>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#InstitutionalCircumvention"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#Abandonment"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#bibliographicCitation">
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:label xml:lang="en">bibliographic citation</rdfs:label>
    <rdfs:label xml:lang="ru">библиографическая ссылка</rdfs:label>
    <rdfs:comment xml:lang="en">A full bibliographic reference for a source, including page numbers where relevant.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Irony">
    <rdfs:label xml:lang="ru">Ирония</rdfs:label>
    <rdfs:label xml:lang="en">Irony</rdfs:label>
    <rdfs:comment xml:lang="en">Saying one thing while meaning another, so that criticism is conveyed under an outwardly acceptable surface. Added in v2.1.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_HKR_Lesehilfe">
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_bpb_Selbstzensur"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Hoepcke1985"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_GuibertYeche"/>
    <cc:claimText>The 1985 GDR edition appeared with Schlenstedt's text, intended 'd'une part à amadouer la censure, d'autre part à guider le lecteur'; the Suhrkamp edition in the West was published without it.</cc:claimText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_HKR_PrintApproval"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_HKR_Lesehilfe"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Cannes_ThisIsNotAFilm2011">
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.festival-cannes.com/en/2011/in-film-nist-this-is-not-a-film-by-jafar-panahi/</cc:sourceURL>
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceTitle>In Film Nist (This Is Not A Film) by Jafar Panahi</cc:sourceTitle>
    <cc:bibliographicCitation>Festival de Cannes. (2011). In Film Nist (This Is Not A Film) by Jafar Panahi. 20 May 2011.</cc:bibliographicCitation>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2011</cc:publicationYear>
    <rdfs:label xml:lang="en">In Film Nist (This Is Not A Film) by Jafar Panahi</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeStrategy">
    <rdfs:label xml:lang="ru">Творческая стратегия</rdfs:label>
    <rdfs:label xml:lang="en">Creative strategy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A method of expression a creator uses within a creative response, such as allegory, metaphor, or indirect representation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Bulgakov_LiterarySuppression1930s">
    <cc:description>By the late 1920s and 1930s Bulgakov's prospects for publishing original fiction had sharply deteriorated; scholarly accounts describe him as no longer able to publish original fiction while he continued work on The Master and Margarita.</cc:description>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#MasterAndMargarita"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#SovietLiteraryEstablishment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:eventDate>1930s</cc:eventDate>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PublicationRestriction"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Bulgakov_AesopianExpression"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Bulgakov_PoliticalExpression"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Cannes_Panahi2011">
    <cc:bibliographicCitation>Festival de Cannes. (2011). Jafar Panahi and Mohammad Rasoulof in the Cannes Official Selection! 7 May 2011.</cc:bibliographicCitation>
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.festival-cannes.com/en/2011/jafar-panahi-and-mohammad-rasoulof-in-the-cannes-official-selection/</cc:sourceURL>
    <rdfs:label xml:lang="en">Jafar Panahi and Mohammad Rasoulof in the Cannes Official Selection!</rdfs:label>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2011</cc:publicationYear>
    <cc:sourceTitle>Jafar Panahi and Mohammad Rasoulof in the Cannes Official Selection!</cc:sourceTitle>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Hoepcke1985">
    <cc:bibliographicCitation>Höpcke, K. (1985). Über Volker Brauns Hinze-Kunze-Roman. Die Weltbühne 33–34/1985; reprinted in Das Blättchen, April 2025.</cc:bibliographicCitation>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceTitle>Über Volker Brauns HINZE-KUNZE-ROMAN</cc:sourceTitle>
    <rdfs:label xml:lang="en">Über Volker Brauns HINZE-KUNZE-ROMAN</rdfs:label>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</cc:publicationYear>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://das-blaettchen.de/2025/04/ueber-volker-brauns-hinze-kunze-roman-71622.html</cc:sourceURL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate">
    <owl:versionInfo>v2.2 (merged: +5 cases, +Editor/+CreativePractice, performedBy-&gt;Agent, producesWork unified into resultsInWork)</owl:versionInfo>
    <skos:changeNote xml:lang="en">v2: (1) domain of hasOutcome narrowed from Event to CreativeResponse; (2) English and Russian labels and English definitions added to all classes, properties and controlled values; (3) DistributionRestriction mechanism and a small set of documentation data properties added; (4) test individuals kept and marked as synthetic; (5) no real historical cases added. v2.1: data properties aligned with project documentation (eventDate, publicationYear); added resultsInWork, StylisticRestriction, Irony, ParatextualFraming, Fragmentation.</skos:changeNote>
    <dcterms:title xml:lang="en">Censorship and Creative Response Core Ontology</dcterms:title>
    <rdfs:comment xml:lang="en">A core ontology for representing censorship events, the constraints they impose on creative works, the documented creative responses of creators, the strategies used in those responses, their outcomes, and the sources and claims that support them. The model is conditional, not deterministic: censorship may lead to suppression, modification, abandonment, or creative adaptation. Theoretical basis: R. Darnton (censorship as an institutional process), P. D. Stokes (creativity from constraints), B. D. Rosso (enabling and disabling effects of constraints).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">ConCreCen — Core Ontology v2</rdfs:label>
    <owl:versionIRI rdf:resource="http://example.org/censorcreate/2.2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Ballo_NaplesCensorship1858">
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Ballo_Regicide"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#GustavoIII_OperaProject"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1858</cc:eventDate>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Ballo_LeaveNaples"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#NeapolitanCensors"/>
    <cc:description>The opera intended for Teatro San Carlo in Naples encountered censorial objections to a plot based on the assassination of a monarch. The demanded changes became so extensive that Verdi broke the contract with the Naples theatre and took the project elsewhere.</cc:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#StylisticRestriction">
    <rdfs:label xml:lang="ru">Стилистическое ограничение</rdfs:label>
    <rdfs:label xml:lang="en">Stylistic restriction</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint on the artistic style, form, or idiom of a work (for example, condemnation of 'formalism'), rather than on its subject. Added in v2.1.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Bulgakov_Aesopian">
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov"/>
    <cc:confidenceLevel>medium</cc:confidenceLevel>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:claimText>The link between Soviet censorship and Aesopian strategies is interpretative rather than a directly documented causal statement by Bulgakov. Rosenshield documents the suppression of Bulgakov's publication opportunities, while Pope discusses Aesopian readings of politically suggestive passages in the novel. This relation should therefore be represented as a Claim, not as unquestioned causality.</cc:claimText>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Bulgakov_AesopianExpression"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Bulgakov_LiterarySuppression1930s"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Giger1999_Ballo">
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1017/S0954586700005061</cc:sourceURL>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceTitle>Social control and the censorship of Giuseppe Verdi's operas in Rome (1844–1859)</cc:sourceTitle>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1999</cc:publicationYear>
    <rdfs:label xml:lang="en">Social control and the censorship of Giuseppe Verdi's operas in Rome (1844–1859)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <cc:bibliographicCitation>Giger, A. (1999). Social control and the censorship of Giuseppe Verdi's operas in Rome (1844–1859). Cambridge Opera Journal, 11(3), 233–265. DOI: 10.1017/S0954586700005061.</cc:bibliographicCitation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#title">
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">title</rdfs:label>
    <rdfs:label xml:lang="ru">название</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The title of a creative work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Shost_Fifth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Muddle"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Robinson_BSO"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Pravda1936"/>
    <cc:confidenceLevel>medium</cc:confidenceLevel>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Shost_FifthSymphony"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:claimText>The Fifth Symphony is documented as Shostakovich's response to the 1936 criticism ('a Soviet artist's creative reply to just criticism') and led to his rehabilitation; whether the finale is sincere or ironic remains debated, so the Ambiguity strategy is an interpretation.</cc:claimText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_MasterMargarita_MoskvaCensorship1966">
    <cc:eventDate>1966-1967</cc:eventDate>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_MasterMargarita_PublicationCuts"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Curtis2019_Bulgakov"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#MasterAndMargarita"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_MasterMargarita_TextRestoration"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#SovietCensorship_Moskva"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#Redaction"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PublicationRestriction"/>
    <cc:description>The novel's first Soviet publication in Moskva (1966-1967) was authorised only in a heavily cut form. Political and ideological passages, references to the secret police and arrests, attacks on the Soviet literary establishment, and other material were removed.</cc:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TehranRevolutionaryCourt_Branch26">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAuthority"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Branch 26 of the Tehran Revolutionary Court / Iranian judiciary</rdfs:label>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Agent">
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:label xml:lang="ru">Агент</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A person, group, or institution that can act in a censorship or creative process.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Met_Ballo">
    <cc:dataProvenance>documented case</cc:dataProvenance>
