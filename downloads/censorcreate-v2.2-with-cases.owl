  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#dataProvenance">
    <rdfs:comment xml:lang="en">Marks whether an individual is documented (real case), synthetic (test or AI-generated), or a template.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">data provenance</rdfs:label>
    <rdfs:label xml:lang="ru">происхождение данных</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_MasterMargarita_Publication">
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_MasterMargarita_TextRestoration"/>
    <cc:claimText>Curtis documents that the Moskva text was authorised with substantial politically and ideologically motivated cuts and describes the later route to full publication abroad; Pope explicitly distinguishes the censored Moskva edition from complete Russian versions. The posthumous response is performed by an editor/estate representative rather than by the original creator.</cc:claimText>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Curtis2019_Bulgakov"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_MasterMargarita_MoskvaCensorship1966"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Shost_Formalism">
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_Shost_ModernistIdiom"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <cc:description>Condemnation of 'formalism': dissonant, modernist musical language declared unacceptable; Kerzhentsev demanded a concrete demonstration of reform in future works.</cc:description>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#StylisticRestriction"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Panahi_ThisIsNotAFilm">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_Panahi_Filmmaking"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_IranHumanRights_Panahi2010"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_CinemaIranica_TINAF"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_ThisIsNotAFilm2011"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_Panahi2011"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#SelfReflexivity"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#Circumvention"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#MinimalProduction"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:description>Panahi and Mojtaba Mirtahmasb made a self-reflexive video diary largely inside Panahi's apartment. Panahi stages and describes an unproduced screenplay and turns the conditions of being forbidden to make films into part of the film's subject and form.</cc:description>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#MojtabaMirtahmasb"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#JafarPanahi"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2011</cc:eventDate>
    <cc:resultsInWork rdf:resource="http://example.org/censorcreate#ThisIsNotAFilm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#isTargetOf">
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="ru">является объектом</rdfs:label>
    <rdfs:label xml:lang="en">is target of</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Inverse of targetsWork: links a creative work to a censorship event that affects it.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://example.org/censorcreate#targetsWork"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Streetcar_ReleaseCuts">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:description>Sexual and 'carnal' material had to be reduced or removed for release without condemnation.</cc:description>
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_Streetcar_CutScenes"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#ContentRestriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Redaction">
    <rdfs:comment xml:lang="en">Deletion or obscuring of specific passages, scenes, or elements of a work.</rdfs:comment>
    <rdfs:label xml:lang="en">Redaction</rdfs:label>
    <rdfs:label xml:lang="ru">Вымарывание</rdfs:label>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TennesseeWilliams">
    <rdfs:label xml:lang="en">Tennessee Williams</rdfs:label>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeStrategy">
    <rdfs:label xml:lang="en">Creative strategy</rdfs:label>
    <rdfs:label xml:lang="ru">Творческая стратегия</rdfs:label>
    <rdfs:comment xml:lang="en">A method of expression a creator uses within a creative response, such as allegory, metaphor, or indirect representation.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_HKR_Irony">
    <cc:confidenceLevel>medium</cc:confidenceLevel>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <cc:claimText>The preface to the French edition argues that Braun uses the ruse and irony of Enlightenment writers (Diderot's Jacques le fataliste) to pass subversive ideas; the narrator explicitly thematises why so much 'cannot be said directly'. This is an interpretation by the preface author, and the novel was written (1981) before the formal review began.</cc:claimText>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_HKR_IronicNarration"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_HKR_PrintApproval"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Robinson_BSO">
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.bso.org/works/symphony-no-5-shostakovich</cc:sourceURL>
    <cc:sourceTitle>Symphony No. 5 (programme note)</cc:sourceTitle>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdfs:label xml:lang="en">Symphony No. 5 (programme note)</rdfs:label>
    <cc:bibliographicCitation>Robinson, H. Symphony No. 5 (Shostakovich). Boston Symphony Orchestra programme note.</cc:bibliographicCitation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Fragmentation">
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Breaking a restricted action or representation into a series of short units, each of which stays within the permitted limit. Added in v2.1.</rdfs:comment>
    <rdfs:label xml:lang="en">Fragmentation</rdfs:label>
    <rdfs:label xml:lang="ru">Фрагментация</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipEvent">
    <rdfs:label xml:lang="ru">Цензурное событие</rdfs:label>
    <rdfs:label xml:lang="en">Censorship event</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:comment xml:lang="en">A documented act or process of censorship affecting a creative work, carried out by a censoring agent through a censorship mechanism.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipConstraint">
    <rdfs:label xml:lang="en">Censorship constraint</rdfs:label>
    <rdfs:label xml:lang="ru">Цензурное ограничение</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A constraint imposed by a censorship event. Not every constraint is censorship; this class covers only constraints resulting from censorship.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Constraint"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#VolkerBraun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdfs:label xml:lang="en">Volker Braun</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SecretProduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Secret production</rdfs:label>
    <rdfs:comment>Creating a work privately or clandestinely when public production is prohibited.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AudioElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A sound, musical passage, or spoken audio component of a creative work.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
    <rdfs:label xml:lang="en">Audio element</rdfs:label>
    <rdfs:label xml:lang="ru">Аудиоэлемент</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Creator">
    <rdfs:comment xml:lang="en">An agent who creates a creative work: an author, filmmaker, composer, visual artist, or similar.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Agent"/>
    <rdfs:label xml:lang="en">Creator</rdfs:label>
    <rdfs:label xml:lang="ru">Создатель</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Circumvention">
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment>A strategy of finding a way around a censorship restriction without directly complying with it.</rdfs:comment>
    <rdfs:label xml:lang="en">Circumvention</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Ballo_RomeCensorship1858">
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1858</cc:eventDate>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Met_Ballo"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#PapalRomanCensors"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Ballo_Transposition"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#GustavoIII_OperaProject"/>
    <cc:description>The project also underwent censorship in papal Rome. The final compromise relocated the action outside Europe to colonial Boston and transformed the historical Swedish king into the fictional Governor Riccardo, with corresponding changes to character names and political context.</cc:description>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Ballo_SovereignRepresentation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Darnton1991">
    <rdfs:label xml:lang="en">The Good Old Days</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <cc:sourceTitle>The Good Old Days</cc:sourceTitle>
    <cc:bibliographicCitation>Darnton, R. (1991). The Good Old Days. The New York Review of Books, 16 May 1991.</cc:bibliographicCitation>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nybooks.com/articles/1991/05/16/the-good-old-days/</cc:sourceURL>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1991</cc:publicationYear>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Nolde_ProfessionalPractice">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#ProfessionalPracticeRestriction"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#MaterialRestriction"/>
    <cc:description>The professional ban prevented Nolde from officially practising, exhibiting, and selling art and limited his access to normal artistic materials and channels.</cc:description>
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_Nolde_ArtMaking"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Nolde_ArtMaking">
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeActivity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:description>Professional production and public circulation of visual art.</cc:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#aboutCreativeResponse">
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:label xml:lang="en">about creative response</rdfs:label>
    <rdfs:label xml:lang="ru">о творческом ответе</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Links a claim to the creative response it concerns.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Claim"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#PublicationRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="ru">Ограничение публикации</rdfs:label>
    <rdfs:label xml:lang="en">Publication restriction</rdfs:label>
    <rdfs:comment xml:lang="en">A limitation on whether, when, or in what form a work may be published.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2996ffa38f6b4bf8b8d694df67344241b10">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n2996ffa38f6b4bf8b8d694df67344241b8"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#HistoricalDisplacement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Historical displacement</rdfs:label>
    <rdfs:comment>Moving sensitive content to another historical context to reduce its directness.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Panahi_Restrictions">
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_ThisIsNotAFilm2011"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_Panahi2011"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_IranHumanRights_Panahi2010"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_CinemaIranica_TINAF"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Panahi_ThisIsNotAFilm"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Panahi_2010FilmmakingBan"/>
    <cc:claimText>Cannes stated that Panahi and Rasoulof's films were made under semi-clandestine conditions and quoted Panahi that the desire to keep Iranian filmmaking alive motivated them to overcome the restrictions. This Is Not a Film directly documents Panahi's situation as a filmmaker forbidden to work.</cc:claimText>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Ballo_LeaveNaples">
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#Abandonment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1858</cc:eventDate>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#GiuseppeVerdi"/>
    <cc:description>Verdi rejected the most drastic demanded alterations, broke the contract with Teatro San Carlo, and moved the project to Rome.</cc:description>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_Ballo_Regicide"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#InstitutionalCircumvention"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_HKR_IronicNarration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_HKR_Ideology"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#VolkerBraun"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1981</cc:eventDate>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#Irony"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#Allegory"/>
    <cc:description>Braun frames the critique in an ironic, Diderot-like master-servant narrative with an intrusive narrator who comments on what 'cannot be said directly'.</cc:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Bulgakov_PoliticalExpression">
    <cc:description>Political and satirical expression had to be developed in an environment in which Bulgakov could not expect normal publication of original fiction.</cc:description>
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_Bulgakov_PoliticalSatire"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#ExpressionRestriction"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#PublicationRestriction"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MikhailBulgakov">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
    <rdfs:label xml:lang="en">Mikhail Bulgakov</rdfs:label>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#LadyMacbethMtsensk">
    <rdfs:label xml:lang="en">Lady Macbeth of the Mtsensk District</rdfs:label>
    <cc:title>Lady Macbeth of the Mtsensk District</cc:title>
    <cc:createdBy rdf:resource="http://example.org/censorcreate#DmitriShostakovich"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#MusicalWork"/>
    <cc:creationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1932</cc:creationYear>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov">
    <cc:sourceTitle>The Master and Margarita and the Poetics of Aporia: A Polemical Article</cc:sourceTitle>
    <cc:bibliographicCitation>Rosenshield, G. (1997). The Master and Margarita and the Poetics of Aporia: A Polemical Article. Slavic Review, 56(2), 187–211. DOI: 10.2307/2500782.</cc:bibliographicCitation>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
