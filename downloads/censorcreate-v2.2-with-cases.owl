    <owl:equivalentClass rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b7"/>
    <rdfs:comment xml:lang="en">A creative work that is the target of at least one censorship event. Membership is inferred by a reasoner.</rdfs:comment>
    <rdfs:label xml:lang="ru">Цензурированное произведение</rdfs:label>
    <rdfs:label xml:lang="en">Censored work</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Panahi_2010FilmmakingBan">
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2010</eventDate>
    <dataProvenance>documented case</dataProvenance>
    <usesMechanism rdf:resource="http://example.org/censorcreate#Ban"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_Panahi2011"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_IranHumanRights_Panahi2010"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_ThisIsNotAFilm2011"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_CinemaIranica_TINAF"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <targetsPractice rdf:resource="http://example.org/censorcreate#PanahiFilmmakingPractice"/>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Panahi_Filmmaking"/>
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_Panahi_ThisIsNotAFilm"/>
    <imposedBy rdf:resource="http://example.org/censorcreate#TehranRevolutionaryCourt_Branch26"/>
    <description>On 20 December 2010, Panahi was sentenced to six years in prison and a 20-year ban on making films, writing screenplays, giving interviews, and travelling abroad. In 2011, Cannes described This Is Not a Film as made under semi-clandestine conditions while the ban was in force.</description>
  </rdf:Description>
