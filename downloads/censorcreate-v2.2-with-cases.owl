  <rdf:Description rdf:about="http://example.org/censorcreate#EV_HKR_DistributionStop">
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</cc:eventDate>
    <cc:description>After publication and hostile reviews (Neues Deutschland; critic Anneliese Löffler), distribution of the novel in the GDR was stopped on 10 September 1985; Höpcke received a formal Party censure. A new GDR edition appeared only in 1988.</cc:description>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#DistributionRestriction"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_HKR_Distribution"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#HinzeKunzeRoman"/>
  </rdf:Description>
