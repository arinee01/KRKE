  <rdf:Description rdf:about="http://example.org/censorcreate#EV_MasterMargarita_MoskvaCensorship1966">
    <dataProvenance>documented case</dataProvenance>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Curtis2019_Bulgakov"/>
    <imposedBy rdf:resource="http://example.org/censorcreate#SovietCensorship_Moskva"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#PublicationRestriction"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#Redaction"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <targetsWork rdf:resource="http://example.org/censorcreate#MasterAndMargarita"/>
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_MasterMargarita_TextRestoration"/>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_MasterMargarita_PublicationCuts"/>
    <description>The novel's first Soviet publication in Moskva (1966-1967) was authorised only in a heavily cut form. Political and ideological passages, references to the secret police and arrests, attacks on the Soviet literary establishment, and other material were removed.</description>
    <eventDate>1966-1967</eventDate>
  </rdf:Description>
