  <rdf:Description rdf:about="http://example.org/censorcreate#CON_HKR_Ideology">
    <cc:description>Objections that the irony targets socialism, distorts the concept of freedom and represents the Liebknecht-Luxemburg commemoration unworthily (Neubert report, July 1984).</cc:description>
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_HKR_PartyPrivilegeSatire"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#SubjectRestriction"/>
  </rdf:Description>
