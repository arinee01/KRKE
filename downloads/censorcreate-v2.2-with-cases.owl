  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Ballo_RomeCensorship1858">
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Met_Ballo"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <targetsWork rdf:resource="http://example.org/censorcreate#GustavoIII_OperaProject"/>
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_Ballo_Transposition"/>
    <description>The project also underwent censorship in papal Rome. The final compromise relocated the action outside Europe to colonial Boston and transformed the historical Swedish king into the fictional Governor Riccardo, with corresponding changes to character names and political context.</description>
    <usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <imposedBy rdf:resource="http://example.org/censorcreate#PapalRomanCensors"/>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Ballo_SovereignRepresentation"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1858</eventDate>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Pope1977_Bulgakov">
    <publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1977</publicationYear>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <sourceTitle>Ambiguity and Meaning in The Master and Margarita: The Role of Afranius</sourceTitle>
    <dataProvenance>documented case</dataProvenance>
    <bibliographicCitation>Pope, R. W. F. (1977). Ambiguity and Meaning in The Master and Margarita: The Role of Afranius. Slavic Review, 36(1), 1–24. DOI: 10.2307/2494668.</bibliographicCitation>
    <sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.cambridge.org/core/journals/slavic-review/article/abs/ambiguity-and-meaning-in-the-master-and-margarita-the-role-of-afranius/C1CC1B17693788E4D6FB2F6E0B1AB372</sourceURL>
    <rdfs:label xml:lang="en">Ambiguity and Meaning in The Master and Margarita: The Role of Afranius</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipConstraint">
    <rdfs:label xml:lang="ru">Цензурное ограничение</rdfs:label>
    <rdfs:label xml:lang="en">Censorship constraint</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint imposed by a censorship event. Not every constraint is censorship; this class covers only constraints resulting from censorship.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Constraint"/>
