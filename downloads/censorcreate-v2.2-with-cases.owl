    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
    <rdfs:label xml:lang="en">Audio element</rdfs:label>
    <rdfs:label xml:lang="ru">Аудиоэлемент</rdfs:label>
    <rdfs:comment xml:lang="en">A sound, musical passage, or spoken audio component of a creative work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Film">
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="ru">Фильм</rdfs:label>
    <rdfs:label xml:lang="en">Film</rdfs:label>
    <rdfs:comment xml:lang="en">A creative work expressed as a motion picture.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Ballo_Transposition">
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Met_Ballo"/>
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:claimText>The Metropolitan Opera and Verdi critical-edition sources explicitly link the Boston setting and transformed characters to negotiations with the censors. This is a strong example of narrative transposition used to preserve a censored dramatic structure.</cc:claimText>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Ballo_RomeCensorship1858"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Ballo_Transposition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Claim">
    <rdfs:comment xml:lang="en">A statement linking a censorship event and a creative response, supported by one or more sources. Used to make the evidence for each relation explicit.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Claim</rdfs:label>
    <rdfs:label xml:lang="ru">Утверждение</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#InstitutionalCircumvention">
    <rdfs:comment>Avoiding or bypassing the institution imposing the restriction.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Institutional circumvention</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_FrolovaWalker2023">
    <rdf:type rdf:resource="http://example.org/censorcreate#Book"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
