  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Streetcar_PCAReview1950">
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_Streetcar_ScreenplayRewrite"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1950</eventDate>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Streetcar_SexualContent"/>
    <targetsWork rdf:resource="http://example.org/censorcreate#Streetcar1951"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <description>During Production Code Administration review in 1950, the screenplay was challenged over three principal issues: the homosexuality of Blanche's late husband, Blanche's sexual behaviour, and the rape. The PCA proposed plot and dialogue changes before approval.</description>
    <imposedBy rdf:resource="http://example.org/censorcreate#PCA"/>
  </rdf:Description>
