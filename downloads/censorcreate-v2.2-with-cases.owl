  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Pravda">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAgent"/>
    <dataProvenance>documented case</dataProvenance>
    <rdfs:label xml:lang="en">Pravda (Communist Party newspaper; editorial expressing the official Party line)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Panahi_Restrictions">
    <claimText>Cannes stated that Panahi and Rasoulof's films were made under semi-clandestine conditions and quoted Panahi that the desire to keep Iranian filmmaking alive motivated them to overcome the restrictions. This Is Not a Film directly documents Panahi's situation as a filmmaker forbidden to work.</claimText>
    <dataProvenance>documented case</dataProvenance>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Panahi_2010FilmmakingBan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_IranHumanRights_Panahi2010"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_ThisIsNotAFilm2011"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_CinemaIranica_TINAF"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_Panahi2011"/>
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Panahi_ThisIsNotAFilm"/>
    <confidenceLevel>high</confidenceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#DieterSchlenstedt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
    <dataProvenance>documented case</dataProvenance>
    <rdfs:label xml:lang="en">Dieter Schlenstedt</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Giger1999_Ballo">
    <sourceTitle>Social control and the censorship of Giuseppe Verdi's operas in Rome (1844–1859)</sourceTitle>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <dataProvenance>documented case</dataProvenance>
    <sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1017/S0954586700005061</sourceURL>
    <publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1999</publicationYear>
    <bibliographicCitation>Giger, A. (1999). Social control and the censorship of Giuseppe Verdi's operas in Rome (1844–1859). Cambridge Opera Journal, 11(3), 233–265. DOI: 10.1017/S0954586700005061.</bibliographicCitation>
    <rdfs:label xml:lang="en">Social control and the censorship of Giuseppe Verdi's operas in Rome (1844–1859)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Met_Ballo">
    <dataProvenance>documented case</dataProvenance>
    <rdfs:label xml:lang="en">Un Ballo in Maschera</rdfs:label>
    <bibliographicCitation>The Metropolitan Opera. Un Ballo in Maschera (work/season guide).</bibliographicCitation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.metopera.org/user-information/old-seasons/2023-24-season/un-ballo-in-maschera/</sourceURL>
    <sourceTitle>Un Ballo in Maschera</sourceTitle>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Pravda1936">
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Robinson_BSO"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Muddle"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#Removal"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#Ban"/>
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <imposedBy rdf:resource="http://example.org/censorcreate#Pravda"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1936</eventDate>
    <targetsWork rdf:resource="http://example.org/censorcreate#LadyMacbethMtsensk"/>
    <description>Unsigned Pravda editorial 'Muddle Instead of Music' (28 January 1936), two days after Stalin attended the opera; further Pravda attacks followed; the opera disappeared from the repertoire (last performance 11 March 1936).</description>
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_Shost_FifthSymphony"/>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Shost_Formalism"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_HKR_PrintApproval">
    <description>Four-year GDR print-approval process: manuscript submitted to Mitteldeutscher Verlag end 1981, passed to the Hauptverwaltung end 1983; negative expert report by Werner Neubert (July 1984); Höpcke changed 'refusal' to 'needs further work'; renewed unsuccessful attempts to obtain changes; approval early 1985.</description>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_HKR_Ideology"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</eventDate>
    <targetsWork rdf:resource="http://example.org/censorcreate#HinzeKunzeRoman"/>
    <imposedBy rdf:resource="http://example.org/censorcreate#HV_Verlage_Buchhandel"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_GuibertYeche"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_bpb_Selbstzensur"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Hoepcke1985"/>
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_HKR_IronicNarration"/>
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_HKR_Lesehilfe"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Notorious_Character">
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Notorious_PCAReview"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <claimText>The PCA found Alicia's characterisation unacceptable and listed 17 changes (25 July 1945). How each change was implemented is not yet documented here — to be checked in Billheimer, ch. 14.</claimText>
    <dataProvenance>documented case</dataProvenance>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Billheimer2019"/>
    <confidenceLevel>high</confidenceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Notorious_FragmentedKiss">
    <dataProvenance>documented case</dataProvenance>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1946</eventDate>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Billheimer2019"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_HitchZone_PCA"/>
    <description>Hitchcock stages a scene of about two and a half to three minutes as a chain of short kisses (none longer than ~3 seconds), interrupted by talk and a telephone call, so the scene stays within the rule but reads as one continuous embrace.</description>
    <hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_Notorious_Kissing"/>
    <performedBy rdf:resource="http://example.org/censorcreate#AlfredHitchcock"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#Fragmentation"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#IndirectRepresentation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Streetcar_CutScenes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Scene"/>
    <description>Several scenes and lines, including the Stella stairway sequence and dialogue surrounding Stanley's attack on Blanche.</description>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Bulgakov_AesopianExpression">
    <performedBy rdf:resource="http://example.org/censorcreate#MikhailBulgakov"/>
    <hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <resultsInWork rdf:resource="http://example.org/censorcreate#MasterAndMargarita"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#AesopianLanguage"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#IndirectRepresentation"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#Satire"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#Ambiguity"/>
    <dataProvenance>documented case</dataProvenance>
    <description>The novel uses satire, ambiguity, fantastic displacement, and passages that scholars have discussed in terms of Aesopian language: indirect expression capable of carrying concealed political or social meanings.</description>
    <eventDate>1930s</eventDate>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_Bulgakov_PoliticalExpression"/>
  </rdf:Description>
