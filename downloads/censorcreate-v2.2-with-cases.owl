  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Shost_FifthSymphony">
    <usesStrategy rdf:resource="http://example.org/censorcreate#Ambiguity"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Muddle"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Robinson_BSO"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1937</eventDate>
    <performedBy rdf:resource="http://example.org/censorcreate#DmitriShostakovich"/>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_Shost_Formalism"/>
    <hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <description>Fifth Symphony (composed 18 April–20 July 1937; premiered 21 November 1937, Leningrad Philharmonic, Mravinsky): a turn 'towards greater accessibility, towards greater simplicity', classical form and tonal harmony, with a finale whose triumph has been heard as sincere or ironic.</description>
    <resultsInWork rdf:resource="http://example.org/censorcreate#ShostakovichSymphony5"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
