>
  <rdf:Description rdf:about="http://example.org/censorcreate#SubjectRestriction">
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ru">Ограничение темы</rdfs:label>
    <rdfs:label xml:lang="en">Subject restriction</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint on which topics or subjects a work may address.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Ballo_Transposition">
    <description>Verdi and Somma transformed the setting and identities while preserving the dramatic structure: Sweden became colonial Boston, Gustav III became Governor Riccardo, and other characters were renamed.</description>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_Ballo_SovereignRepresentation"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#NarrativeTransposition"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#HistoricalDisplacement"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#CharacterTransformation"/>
    <eventDate>1858-1859</eventDate>
    <performedBy rdf:resource="http://example.org/censorcreate#AntonioSomma"/>
    <performedBy rdf:resource="http://example.org/censorcreate#GiuseppeVerdi"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Met_Ballo"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <producesVersion rdf:resource="http://example.org/censorcreate#UnBalloInMaschera1859"/>
    <hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Notorious_PCAReview">
    <description>Production Code Administration review of the script: Joseph Breen called it 'definitely unacceptable' (25 May 1945); a further review (25 July 1945) listed 17 required changes, incl. removing five uses of 'tramp' for Alicia.</description>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_HitchZone_PCA"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Billheimer2019"/>
    <dataProvenance>documented case</dataProvenance>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Notorious_Kissing"/>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Notorious_Character"/>
    <imposedBy rdf:resource="http://example.org/censorcreate#PCA"/>
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_Notorious_FragmentedKiss"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1945</eventDate>
    <targetsWork rdf:resource="http://example.org/censorcreate#Notorious1946"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Lance_Metailie">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <rdfs:label xml:lang="en">Le Roman de Hinze et Kunze (preface, publisher page)</rdfs:label>
    <sourceTitle>Le Roman de Hinze et Kunze (preface, publisher page)</sourceTitle>
    <bibliographicCitation>Lance, A. Preface to V. Braun, Le Roman de Hinze et Kunze. Éditions Métailié (reissue of the 1988 French translation).</bibliographicCitation>
    <dataProvenance>documented case</dataProvenance>
    <sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://editions-metailie.com/livre/le-roman-de-hinze-et-kunze/</sourceURL>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Modification">
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ru">Изменение</rdfs:label>
    <rdfs:label xml:lang="en">Modification</rdfs:label>
    <rdfs:comment xml:lang="en">The work was altered to comply with the constraint, without documented creative adaptation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#UnpublishedWork">
    <rdfs:comment xml:lang="en">The work remained unpublished, unreleased, or unexhibited as a result of censorship.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:label xml:lang="ru">Неопубликованное произведение</rdfs:label>
    <rdfs:label xml:lang="en">Unpublished work</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_HKR_Ideology">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#SubjectRestriction"/>
    <description>Objections that the irony targets socialism, distorts the concept of freedom and represents the Liebknecht-Luxemburg commemoration unworthily (Neubert report, July 1984).</description>
    <constrainsElement rdf:resource="http://example.org/censorcreate#EL_HKR_PartyPrivilegeSatire"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Streetcar_Rewrite">
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Streetcar_PCAReview1950"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <claimText>AFI's production-history record documents the PCA objections and Williams's rewritten ending, while scholarship on the adaptation describes the film as preserving much of the play's meaning through alterations required by censorship.</claimText>
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <confidenceLevel>high</confidenceLevel>
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Streetcar_ScreenplayRewrite"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Source">
    <rdfs:label xml:lang="en">Source</rdfs:label>
    <rdfs:label xml:lang="ru">Источник</rdfs:label>
    <rdfs:comment xml:lang="en">A documentary or scholarly source (book, article, archival document, interview, etc.) that provides evidence about events and responses.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Streetcar1951_PCAApprovedVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WorkVersion"/>
    <createdBy rdf:resource="http://example.org/censorcreate#EliaKazan"/>
    <createdBy rdf:resource="http://example.org/censorcreate#TennesseeWilliams"/>
    <dataProvenance>documented case</dataProvenance>
    <versionOf rdf:resource="http://example.org/censorcreate#Streetcar1951"/>
    <title>A Streetcar Named Desire (PCA-approved film version)</title>
    <creationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1951</creationYear>
    <rdfs:label xml:lang="en">A Streetcar Named Desire (PCA-approved film version)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#UnBalloInMaschera1859">
    <createdBy rdf:resource="http://example.org/censorcreate#GiuseppeVerdi"/>
    <createdBy rdf:resource="http://example.org/censorcreate#AntonioSomma"/>
    <title>Un ballo in maschera</title>
    <dataProvenance>documented case</dataProvenance>
    <rdfs:label xml:lang="en">Un ballo in maschera</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#WorkVersion"/>
    <creationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1859</creationYear>
    <versionOf rdf:resource="http://example.org/censorcreate#GustavoIII_OperaProject"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_MasterMargarita_Publication">
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_MasterMargarita_TextRestoration"/>
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <claimText>Curtis documents that the Moskva text was authorised with substantial politically and ideologically motivated cuts and describes the later route to full publication abroad; Pope explicitly distinguishes the censored Moskva edition from complete Russian versions. The posthumous response is performed by an editor/estate representative rather than by the original creator.</claimText>
    <confidenceLevel>high</confidenceLevel>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Curtis2019_Bulgakov"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_MasterMargarita_MoskvaCensorship1966"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Bulgakov_PoliticalExpression">
    <hasConstraintType rdf:resource="http://example.org/censorcreate#PublicationRestriction"/>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#ExpressionRestriction"/>
    <description>Political and satirical expression had to be developed in an environment in which Bulgakov could not expect normal publication of original fiction.</description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <constrainsElement rdf:resource="http://example.org/censorcreate#EL_Bulgakov_PoliticalSatire"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Hoepcke1985">
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</publicationYear>
    <sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://das-blaettchen.de/2025/04/ueber-volker-brauns-hinze-kunze-roman-71622.html</sourceURL>
    <rdfs:label xml:lang="en">Über Volker Brauns HINZE-KUNZE-ROMAN</rdfs:label>
    <sourceTitle>Über Volker Brauns HINZE-KUNZE-ROMAN</sourceTitle>
    <dataProvenance>documented case</dataProvenance>
    <bibliographicCitation>Höpcke, K. (1985). Über Volker Brauns Hinze-Kunze-Roman. Die Weltbühne 33–34/1985; reprinted in Das Blättchen, April 2025.</bibliographicCitation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#performedBy">
    <rdfs:label xml:lang="en">performed by</rdfs:label>
    <rdfs:label xml:lang="ru">выполнено</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#Agent"/>
    <rdfs:comment xml:lang="en">Links a creative response to the creator who carried it out.</rdfs:comment>
  </rdf:Description>
