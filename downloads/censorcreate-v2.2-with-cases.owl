  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeAdaptation">
    <rdfs:label xml:lang="en">Creative adaptation</rdfs:label>
    <rdfs:label xml:lang="ru">Творческая адаптация</rdfs:label>
    <rdfs:comment xml:lang="en">The creator found an alternative form of expression that preserved or transformed the restricted meaning.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_HKR_Irony">
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_HKR_PrintApproval"/>
    <cc:claimText>The preface to the French edition argues that Braun uses the ruse and irony of Enlightenment writers (Diderot's Jacques le fataliste) to pass subversive ideas; the narrator explicitly thematises why so much 'cannot be said directly'. This is an interpretation by the preface author, and the novel was written (1981) before the formal review began.</cc:claimText>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <cc:confidenceLevel>medium</cc:confidenceLevel>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_HKR_IronicNarration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Ballo_SovereignRepresentation">
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#DirectRepresentationRestriction"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#SubjectRestriction"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_Ballo_SettingCharacters"/>
    <cc:description>The central assassination plot could remain only after the sovereign and European political context were transformed.</cc:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
  </rdf:Description>
