    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Bulgakov_Aesopian">
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <confidenceLevel>medium</confidenceLevel>
    <claimText>The link between Soviet censorship and Aesopian strategies is interpretative rather than a directly documented causal statement by Bulgakov. Rosenshield documents the suppression of Bulgakov's publication opportunities, while Pope discusses Aesopian readings of politically suggestive passages in the novel. This relation should therefore be represented as a Claim, not as unquestioned causality.</claimText>
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Bulgakov_AesopianExpression"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Bulgakov_LiterarySuppression1930s"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Theme">
    <rdfs:comment xml:lang="en">A subject, idea, or topic addressed by a creative work.</rdfs:comment>
    <rdfs:label xml:lang="en">Theme</rdfs:label>
    <rdfs:label xml:lang="ru">Тема</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Nolde_ProfessionalPractice">
    <hasConstraintType rdf:resource="http://example.org/censorcreate#ProfessionalPracticeRestriction"/>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#MaterialRestriction"/>
    <description>The professional ban prevented Nolde from officially practising, exhibiting, and selling art and limited his access to normal artistic materials and channels.</description>
    <constrainsElement rdf:resource="http://example.org/censorcreate#EL_Nolde_ArtMaking"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Szabo2019_Streetcar">
    <dataProvenance>documented case</dataProvenance>
    <sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://americanaejournal.hu/index.php/americanaejournal/article/view/45438</sourceURL>
    <rdfs:label xml:lang="en">Censorship and Stardom in Various Adaptations of Tennessee Williams's A Streetcar Named Desire</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <sourceTitle>Censorship and Stardom in Various Adaptations of Tennessee Williams's A Streetcar Named Desire</sourceTitle>
    <publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2019</publicationYear>
    <bibliographicCitation>Szabó, H. (2019). Censorship and Stardom in Various Adaptations of Tennessee Williams's A Streetcar Named Desire. AMERICANA E-Journal of American Studies in Hungary, 15(1).</bibliographicCitation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_HKR_Lesehilfe">
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Hoepcke1985"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_GuibertYeche"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_bpb_Selbstzensur"/>
    <confidenceLevel>high</confidenceLevel>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_HKR_PrintApproval"/>
    <dataProvenance>documented case</dataProvenance>
    <claimText>The 1985 GDR edition appeared with Schlenstedt's text, intended 'd'une part à amadouer la censure, d'autre part à guider le lecteur'; the Suhrkamp edition in the West was published without it.</claimText>
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_HKR_Lesehilfe"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeAdaptation">
    <rdfs:label xml:lang="en">Creative adaptation</rdfs:label>
    <rdfs:label xml:lang="ru">Творческая адаптация</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:comment xml:lang="en">The creator found an alternative form of expression that preserved or transformed the restricted meaning.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AdaptiveCreativeResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <owl:equivalentClass rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b1"/>
    <rdfs:label xml:lang="ru">Адаптивный творческий ответ</rdfs:label>
    <rdfs:label xml:lang="en">Adaptive creative response</rdfs:label>
    <rdfs:comment xml:lang="en">A creative response that uses at least one creative strategy and has the outcome CreativeAdaptation. Membership is inferred by a reasoner.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Sym4_Withdrawal">
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_Shost_Formalism"/>
    <hasOutcome rdf:resource="http://example.org/censorcreate#UnpublishedWork"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Sym4"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <description>Shostakovich withdraws the Fourth Symphony; it remains unperformed until 1961.</description>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1936</eventDate>
    <performedBy rdf:resource="http://example.org/censorcreate#DmitriShostakovich"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AlternativePublication">
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>Alternative publication</rdfs:label>
    <rdfs:comment>A strategy of publishing a work through an alternative channel when normal publication is restricted.</rdfs:comment>
  </rdf:Description>
