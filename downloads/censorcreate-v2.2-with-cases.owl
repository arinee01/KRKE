  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Shost_Fifth">
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Robinson_BSO"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Muddle"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Pravda1936"/>
    <cc:claimText>The Fifth Symphony is documented as Shostakovich's response to the 1936 criticism ('a Soviet artist's creative reply to just criticism') and led to his rehabilitation; whether the finale is sincere or ironic remains debated, so the Ambiguity strategy is an interpretation.</cc:claimText>
    <cc:confidenceLevel>medium</cc:confidenceLevel>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Shost_FifthSymphony"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
