  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_FrolovaWalker2023">
    <cc:bibliographicCitation>Frolova-Walker, M. &amp; Walker, J. (2023). Shostakovich's Symphony No. 5. Oxford University Press. DOI 10.1093/oso/9780197566329.003.0001</cc:bibliographicCitation>
