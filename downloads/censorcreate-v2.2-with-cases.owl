  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Streetcar_LegionCuts1951">
    <imposedBy rdf:resource="http://example.org/censorcreate#CatholicLegionOfDecency"/>
    <targetsWork rdf:resource="http://example.org/censorcreate#Streetcar1951"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#Removal"/>
    <description>After the film was completed, the Catholic Legion of Decency condemned it. Warner Bros., working with the MPAA and without consulting Kazan, made twelve cuts totalling roughly three to four minutes to obtain an acceptable rating.</description>
    <hasOutcome rdf:resource="http://example.org/censorcreate#Suppression"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <dataProvenance>documented case</dataProvenance>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1951</eventDate>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Streetcar_ReleaseCuts"/>
  </rdf:Description>
