    <cc:sourceTitle>The Artist</cc:sourceTitle>
    <rdfs:label xml:lang="en">The Artist</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_HKR_DistributionStop">
    <cc:description>After publication and hostile reviews (Neues Deutschland; critic Anneliese Löffler), distribution of the novel in the GDR was stopped on 10 September 1985; Höpcke received a formal Party censure. A new GDR edition appeared only in 1988.</cc:description>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_HKR_Distribution"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#DistributionRestriction"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#HinzeKunzeRoman"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</cc:eventDate>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#imposedBy">
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:label xml:lang="en">imposed by</rdfs:label>
    <rdfs:label xml:lang="ru">наложено</rdfs:label>
    <rdfs:comment xml:lang="en">Links a censorship event to the censoring agent responsible for it.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensoringAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipMechanism">
    <rdfs:label xml:lang="en">Censorship mechanism</rdfs:label>
    <rdfs:label xml:lang="ru">Механизм цензуры</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A method through which censorship is applied to a creative work, such as a ban, removal, or required modification.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2996ffa38f6b4bf8b8d694df67344241b6">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n2996ffa38f6b4bf8b8d694df67344241b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#constrainsElement">
    <rdfs:label xml:lang="en">constrains element</rdfs:label>
    <rdfs:label xml:lang="ru">ограничивает элемент</rdfs:label>
    <rdfs:comment xml:lang="en">Links a censorship constraint to the specific element of a work it restricts.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/censorcreate#WorkElement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Nolde_Watercolours">
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_NoldeMuseum_Artist"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_NGI_NoldeDegenerate"/>
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Nolde_UnpaintedPictures"/>
    <cc:claimText>The Nolde Museum records the 1941 expulsion and professional ban followed by further small-format watercolours; the National Gallery of Ireland states that despite the ban he continued to create, turning to small watercolour compositions painted in secret. Because Nolde had already used this medium before 1941, the claim is about continuation/adaptation under constraint rather than the invention of a new medium.</cc:claimText>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Nolde_ProfessionalBan1941"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Wiki_Muddle">
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Muddle_Instead_of_Music</cc:sourceURL>
    <cc:sourceTitle>Muddle Instead of Music</cc:sourceTitle>
    <rdfs:label xml:lang="en">Muddle Instead of Music</rdfs:label>
    <cc:bibliographicCitation>Muddle Instead of Music. Wikipedia (tertiary source, used for orientation only).</cc:bibliographicCitation>
  </rdf:Description>
