    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An ongoing creative activity within a practice, such as film directing or art making, that can be restricted by censorship. Added in v2.2.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_MasterMargarita_TextRestoration">
    <cc:performedBy rdf:resource="http://example.org/censorcreate#ElenaBulgakova"/>
    <cc:producesVersion rdf:resource="http://example.org/censorcreate#MasterMargarita_FullRussian1969"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#TextualRestoration"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#AlternativePublication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1969</cc:eventDate>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Curtis2019_Bulgakov"/>
    <cc:description>Elena Bulgakova preserved and prepared the text for publication; omitted passages circulated outside the censored journal version, and complete versions were subsequently published abroad, including a complete Russian text.</cc:description>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#AlternativeVersionProduced"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_MasterMargarita_PublicationCuts"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Panahi_2010FilmmakingBan">
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_IranHumanRights_Panahi2010"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_Panahi2011"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_CinemaIranica_TINAF"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_ThisIsNotAFilm2011"/>
    <cc:targetsPractice rdf:resource="http://example.org/censorcreate#PanahiFilmmakingPractice"/>
    <cc:description>On 20 December 2010, Panahi was sentenced to six years in prison and a 20-year ban on making films, writing screenplays, giving interviews, and travelling abroad. In 2011, Cannes described This Is Not a Film as made under semi-clandestine conditions while the ban was in force.</cc:description>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#Ban"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Panahi_Filmmaking"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#TehranRevolutionaryCourt_Branch26"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Panahi_ThisIsNotAFilm"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2010</cc:eventDate>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
