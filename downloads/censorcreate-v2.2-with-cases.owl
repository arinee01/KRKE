  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Streetcar_SexualContent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <cc:description>The adaptation could not directly represent or clearly state several sexual themes in the same form as the play, and the filmmakers were pressed to alter their treatment.</cc:description>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#SubjectRestriction"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#DirectRepresentationRestriction"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#ContentRestriction"/>
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_Streetcar_SexualThemes"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
