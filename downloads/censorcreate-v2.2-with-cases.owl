    <bibliographicCitation>Robinson, H. Symphony No. 5 (Shostakovich). Boston Symphony Orchestra programme note.</bibliographicCitation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
