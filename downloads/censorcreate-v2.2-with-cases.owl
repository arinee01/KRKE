    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_HKR_Lesehilfe">
    <cc:claimText>The 1985 GDR edition appeared with Schlenstedt's text, intended 'd'une part à amadouer la censure, d'autre part à guider le lecteur'; the Suhrkamp edition in the West was published without it.</cc:claimText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Hoepcke1985"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_bpb_Selbstzensur"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_GuibertYeche"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_HKR_Lesehilfe"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_HKR_PrintApproval"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Notorious_Kiss">
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Billheimer2019"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_HitchZone_PCA"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Notorious_FragmentedKiss"/>
    <cc:claimText>Hitchcock 'concocted' the kiss scene specifically to get around the supposed three-second rule; Bergman recalled that the censors 'couldn't and didn't cut the scene because we never at any one point kissed for more than three seconds'.</cc:claimText>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Notorious_PCAReview"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_GuibertYeche">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#BookChapter"/>
    <rdfs:label xml:lang="en">Censure et autocensure en RDA : la littérature socialiste des années quatre-vingt face au pouvoir</rdfs:label>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://books.openedition.org/enseditions/19283</cc:sourceURL>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceTitle>Censure et autocensure en RDA : la littérature socialiste des années quatre-vingt face au pouvoir</cc:sourceTitle>
    <cc:bibliographicCitation>Guibert-Yeche, H. Censure et autocensure en RDA. ENS Éditions (OpenEdition Books), pp. 127–144.</cc:bibliographicCitation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Pravda1936">
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#LadyMacbethMtsensk"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1936</cc:eventDate>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#Removal"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#Ban"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Shost_FifthSymphony"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Robinson_BSO"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Muddle"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Shost_Formalism"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:description>Unsigned Pravda editorial 'Muddle Instead of Music' (28 January 1936), two days after Stalin attended the opera; further Pravda attacks followed; the opera disappeared from the repertoire (last performance 11 March 1936).</cc:description>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#Pravda"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#targetsWork">
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">targets work</rdfs:label>
    <rdfs:label xml:lang="ru">направлено на произведение</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:comment xml:lang="en">Links a censorship event to the creative work it affects.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Bulgakov_LiterarySuppression1930s">
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1930</cc:eventDate>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#SovietLiteraryEstablishment"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#MasterAndMargarita"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Bulgakov_PoliticalExpression"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Bulgakov_AesopianExpression"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PublicationRestriction"/>
    <cc:description>By the late 1920s and 1930s Bulgakov's prospects for publishing original fiction had sharply deteriorated; scholarly accounts describe him as no longer able to publish original fiction while he continued work on The Master and Margarita.</cc:description>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Nolde_ProfessionalBan1941">
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_NoldeMuseum_Artist"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_NGI_NoldeDegenerate"/>
    <cc:targetsPractice rdf:resource="http://example.org/censorcreate#NoldeArtisticPractice"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Nolde_ProfessionalPractice"/>
    <cc:description>In 1941 Nolde was expelled from the Reich Chamber of Fine Arts and subjected to a professional ban. Official museum sources record that he nevertheless continued producing small-format watercolours, the so-called Unpainted Pictures.</cc:description>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Nolde_UnpaintedPictures"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#ReichChamberFineArts"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#Ban"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1941</cc:eventDate>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Bulgakov_Aesopian">
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:confidenceLevel>medium</cc:confidenceLevel>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Bulgakov_AesopianExpression"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov"/>
    <cc:claimText>The link between Soviet censorship and Aesopian strategies is interpretative rather than a directly documented causal statement by Bulgakov. Rosenshield documents the suppression of Bulgakov's publication opportunities, while Pope discusses Aesopian readings of politically suggestive passages in the novel. This relation should therefore be represented as a Claim, not as unquestioned causality.</cc:claimText>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Bulgakov_LiterarySuppression1930s"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_HKR_PrintApproval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_bpb_Selbstzensur"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_GuibertYeche"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Hoepcke1985"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_HKR_Ideology"/>
    <cc:description>Four-year GDR print-approval process: manuscript submitted to Mitteldeutscher Verlag end 1981, passed to the Hauptverwaltung end 1983; negative expert report by Werner Neubert (July 1984); Höpcke changed 'refusal' to 'needs further work'; renewed unsuccessful attempts to obtain changes; approval early 1985.</cc:description>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#HinzeKunzeRoman"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_HKR_IronicNarration"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_HKR_Lesehilfe"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</cc:eventDate>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#HV_Verlage_Buchhandel"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Nolde_UnpaintedPictures">
    <cc:description>Nolde continued working privately and produced further small-format watercolours in Seebüll. Museum accounts describe these works as being made secretly during the period of prohibition.</cc:description>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#MediumAdaptation"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#SecretProduction"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#EmilNolde"/>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_Nolde_ProfessionalPractice"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1945</cc:eventDate>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_NGI_NoldeDegenerate"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_NoldeMuseum_Artist"/>
    <cc:resultsInWork rdf:resource="http://example.org/censorcreate#Nolde_UnpaintedPictures"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Cannes_Panahi2011">
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.festival-cannes.com/en/2011/jafar-panahi-and-mohammad-rasoulof-in-the-cannes-official-selection/</cc:sourceURL>
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Jafar Panahi and Mohammad Rasoulof in the Cannes Official Selection!</rdfs:label>
    <cc:bibliographicCitation>Festival de Cannes. (2011). Jafar Panahi and Mohammad Rasoulof in the Cannes Official Selection! 7 May 2011.</cc:bibliographicCitation>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceTitle>Jafar Panahi and Mohammad Rasoulof in the Cannes Official Selection!</cc:sourceTitle>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2011</cc:publicationYear>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Notorious_PCAReview">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Notorious_Character"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Notorious_Kissing"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Notorious_FragmentedKiss"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_HitchZone_PCA"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Billheimer2019"/>
    <cc:description>Production Code Administration review of the script: Joseph Breen called it 'definitely unacceptable' (25 May 1945); a further review (25 July 1945) listed 17 required changes, incl. removing five uses of 'tramp' for Alicia.</cc:description>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1945</cc:eventDate>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#Notorious1946"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#PCA"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Panahi_Filmmaking">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:constrainsElement rdf:resource="http://example.org/censorcreate#EL_Panahi_FilmmakingActivity"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#ProfessionalPracticeRestriction"/>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#ExpressionRestriction"/>
    <cc:description>Panahi was prohibited from making or directing films and from writing screenplays for twenty years.</cc:description>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Sym4_Withdrawal">
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Sym4"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1936</cc:eventDate>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#UnpublishedWork"/>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_Shost_Formalism"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#DmitriShostakovich"/>
    <cc:description>Shostakovich withdraws the Fourth Symphony; it remains unperformed until 1961.</cc:description>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SelfReflexivity">
    <rdfs:label xml:lang="en">Self-reflexivity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:comment>A strategy in which the work explicitly reflects on its own creation, form, or conditions of production.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#IndirectRepresentation">
    <rdfs:label xml:lang="en">Indirect representation</rdfs:label>
    <rdfs:label xml:lang="ru">Косвенное изображение</rdfs:label>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Showing a restricted subject through suggestion, displacement, or implication rather than directly.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Ballo_NaplesCensorship1858">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1858</cc:eventDate>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Ballo_Regicide"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#GustavoIII_OperaProject"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Ballo_LeaveNaples"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#NeapolitanCensors"/>
    <cc:description>The opera intended for Teatro San Carlo in Naples encountered censorial objections to a plot based on the assassination of a monarch. The demanded changes became so extensive that Verdi broke the contract with the Naples theatre and took the project elsewhere.</cc:description>
  </rdf:Description>
