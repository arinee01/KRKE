    <sourceTitle>The Artist</sourceTitle>
    <rdfs:label xml:lang="en">The Artist</rdfs:label>
    <bibliographicCitation>Nolde Museum Seebüll. The Artist (biographical chronology of Emil Nolde).</bibliographicCitation>
