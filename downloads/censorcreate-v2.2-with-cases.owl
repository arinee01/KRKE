  <rdf:Description rdf:about="http://example.org/censorcreate#ExpressionRestriction">
    <rdfs:comment>A constraint that limits how ideas, themes, or meanings may be expressed.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdfs:label xml:lang="en">Expression restriction</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#HV_Verlage_Buchhandel">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAgent"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAuthority"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Hauptverwaltung Verlage und Buchhandel (GDR Ministry of Culture)</rdfs:label>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_MasterMargarita_Publication">
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Curtis2019_Bulgakov"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_MasterMargarita_TextRestoration"/>
    <cc:claimText>Curtis documents that the Moskva text was authorised with substantial politically and ideologically motivated cuts and describes the later route to full publication abroad; Pope explicitly distinguishes the censored Moskva edition from complete Russian versions. The posthumous response is performed by an editor/estate representative rather than by the original creator.</cc:claimText>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_MasterMargarita_MoskvaCensorship1966"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CharacterTransformation">
    <rdfs:label xml:lang="en">Character transformation</rdfs:label>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment>A strategy of changing a character’s identity, role, or status to meet censorship constraints.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov">
    <cc:bibliographicCitation>Rosenshield, G. (1997). The Master and Margarita and the Poetics of Aporia: A Polemical Article. Slavic Review, 56(2), 187–211. DOI: 10.2307/2500782.</cc:bibliographicCitation>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.cambridge.org/core/journals/slavic-review/article/abs/master-and-margarita-and-the-poetics-of-aporia-a-polemical-article/1B06C78A2C4736CD2182ED5D4B6F2572</cc:sourceURL>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1997</cc:publicationYear>
    <cc:sourceTitle>The Master and Margarita and the Poetics of Aporia: A Polemical Article</cc:sourceTitle>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <rdfs:label xml:lang="en">The Master and Margarita and the Poetics of Aporia: A Polemical Article</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Fragmentation">
    <rdfs:comment xml:lang="en">Breaking a restricted action or representation into a series of short units, each of which stays within the permitted limit. Added in v2.1.</rdfs:comment>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Fragmentation</rdfs:label>
    <rdfs:label xml:lang="ru">Фрагментация</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Pope1977_Bulgakov">
    <cc:bibliographicCitation>Pope, R. W. F. (1977). Ambiguity and Meaning in The Master and Margarita: The Role of Afranius. Slavic Review, 36(1), 1–24. DOI: 10.2307/2494668.</cc:bibliographicCitation>
    <rdfs:label xml:lang="en">Ambiguity and Meaning in The Master and Margarita: The Role of Afranius</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.cambridge.org/core/journals/slavic-review/article/abs/ambiguity-and-meaning-in-the-master-and-margarita-the-role-of-afranius/C1CC1B17693788E4D6FB2F6E0B1AB372</cc:sourceURL>
    <cc:sourceTitle>Ambiguity and Meaning in The Master and Margarita: The Role of Afranius</cc:sourceTitle>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1977</cc:publicationYear>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#NarrativeTransposition">
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment>Relocating a narrative to a different setting or context while preserving its core structure.</rdfs:comment>
    <rdfs:label xml:lang="en">Narrative transposition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_HKR_Lesehilfe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#AlternativeVersionProduced"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#Irony"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#ParatextualFraming"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Hoepcke1985"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_GuibertYeche"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_bpb_Selbstzensur"/>
    <cc:description>Dieter Schlenstedt, one of the manuscript's first reviewers, writes an appended 'schöngeistige Lesehilfe': five fictional letters that ironise the review process and guide readers; the text was meant both to placate the censors and to guide reading.</cc:description>
    <cc:producesVersion rdf:resource="http://example.org/censorcreate#HKR_GDR_1985"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#DieterSchlenstedt"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</cc:eventDate>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_HKR_Ideology"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Szabo2019_Streetcar">
    <rdfs:label xml:lang="en">Censorship and Stardom in Various Adaptations of Tennessee Williams's A Streetcar Named Desire</rdfs:label>
    <cc:sourceTitle>Censorship and Stardom in Various Adaptations of Tennessee Williams's A Streetcar Named Desire</cc:sourceTitle>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#PeriodicalArticle"/>
    <cc:publicationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2019</cc:publicationYear>
    <cc:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://americanaejournal.hu/index.php/americanaejournal/article/view/45438</cc:sourceURL>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:bibliographicCitation>Szabó, H. (2019). Censorship and Stardom in Various Adaptations of Tennessee Williams's A Streetcar Named Desire. AMERICANA E-Journal of American Studies in Hungary, 15(1).</cc:bibliographicCitation>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9141d9ab9dcb4c8dbd4acd306422dfb7b3">
    <owl:hasValue rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/censorcreate#hasOutcome"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Pravda1936">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Muddle"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Robinson_BSO"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#Pravda"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#Removal"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#Ban"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:description>Unsigned Pravda editorial 'Muddle Instead of Music' (28 January 1936), two days after Stalin attended the opera; further Pravda attacks followed; the opera disappeared from the repertoire (last performance 11 March 1936).</cc:description>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Shost_Formalism"/>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1936</cc:eventDate>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_Shost_FifthSymphony"/>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#LadyMacbethMtsensk"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Abandonment">
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="ru">Отказ от замысла</rdfs:label>
    <rdfs:label xml:lang="en">Abandonment</rdfs:label>
    <rdfs:comment xml:lang="en">The creator abandoned the work or project.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_HKR_PrintApproval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#PriorApproval"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#CON_HKR_Ideology"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Hoepcke1985"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_GuibertYeche"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_bpb_Selbstzensur"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_HKR_IronicNarration"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#RE_HKR_Lesehilfe"/>
    <cc:description>Four-year GDR print-approval process: manuscript submitted to Mitteldeutscher Verlag end 1981, passed to the Hauptverwaltung end 1983; negative expert report by Werner Neubert (July 1984); Höpcke changed 'refusal' to 'needs further work'; renewed unsuccessful attempts to obtain changes; approval early 1985.</cc:description>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#HinzeKunzeRoman"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</cc:eventDate>
    <cc:imposedBy rdf:resource="http://example.org/censorcreate#HV_Verlage_Buchhandel"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Panahi_ThisIsNotAFilm">
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#Circumvention"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#MinimalProduction"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#SelfReflexivity"/>
    <cc:description>Panahi and Mojtaba Mirtahmasb made a self-reflexive video diary largely inside Panahi's apartment. Panahi stages and describes an unproduced screenplay and turns the conditions of being forbidden to make films into part of the film's subject and form.</cc:description>
    <cc:eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2011</cc:eventDate>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#JafarPanahi"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#MojtabaMirtahmasb"/>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_Panahi_Filmmaking"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_ThisIsNotAFilm2011"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_Panahi2011"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_CinemaIranica_TINAF"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_IranHumanRights_Panahi2010"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <cc:resultsInWork rdf:resource="http://example.org/censorcreate#ThisIsNotAFilm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Bulgakov_AesopianExpression">
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#IndirectRepresentation"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#AesopianLanguage"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#Satire"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#Ambiguity"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov"/>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_Bulgakov_PoliticalExpression"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:resultsInWork rdf:resource="http://example.org/censorcreate#MasterAndMargarita"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:description>The novel uses satire, ambiguity, fantastic displacement, and passages that scholars have discussed in terms of Aesopian language: indirect expression capable of carrying concealed political or social meanings.</cc:description>
    <cc:eventDate>1930s</cc:eventDate>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <cc:performedBy rdf:resource="http://example.org/censorcreate#MikhailBulgakov"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SovietLiteraryEstablishment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
