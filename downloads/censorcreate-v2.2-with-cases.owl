  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Nolde_ProfessionalBan1941">
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Nolde_ProfessionalPractice"/>
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_Nolde_UnpaintedPictures"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_NGI_NoldeDegenerate"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_NoldeMuseum_Artist"/>
    <description>In 1941 Nolde was expelled from the Reich Chamber of Fine Arts and subjected to a professional ban. Official museum sources record that he nevertheless continued producing small-format watercolours, the so-called Unpainted Pictures.</description>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1941</eventDate>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <imposedBy rdf:resource="http://example.org/censorcreate#ReichChamberFineArts"/>
    <targetsPractice rdf:resource="http://example.org/censorcreate#NoldeArtisticPractice"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#Ban"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MikhailBulgakov">
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Mikhail Bulgakov</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Nolde_Watercolours">
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <claimText>The Nolde Museum records the 1941 expulsion and professional ban followed by further small-format watercolours; the National Gallery of Ireland states that despite the ban he continued to create, turning to small watercolour compositions painted in secret. Because Nolde had already used this medium before 1941, the claim is about continuation/adaptation under constraint rather than the invention of a new medium.</claimText>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Nolde_ProfessionalBan1941"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_NGI_NoldeDegenerate"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_NoldeMuseum_Artist"/>
    <confidenceLevel>high</confidenceLevel>
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Nolde_UnpaintedPictures"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#PublicationRestriction">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">A limitation on whether, when, or in what form a work may be published.</rdfs:comment>
    <rdfs:label xml:lang="en">Publication restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Ограничение публикации</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#StylisticRestriction">
    <rdfs:label xml:lang="en">Stylistic restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Стилистическое ограничение</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint on the artistic style, form, or idiom of a work (for example, condemnation of 'formalism'), rather than on its subject. Added in v2.1.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AesopianLanguage">
    <rdfs:comment>A strategy of expressing sensitive meanings indirectly through coded or ambiguous language.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label>Aesopian language</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AntonioSomma">
    <rdfs:label xml:lang="en">Antonio Somma</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_MasterMargarita_PublicationCuts">
    <description>Only a substantially abridged version of the novel could appear in the Soviet journal.</description>
    <constrainsElement rdf:resource="http://example.org/censorcreate#EL_MasterMargarita_CutPassages"/>
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#ContentRestriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#respondsTo">
    <rdfs:comment xml:lang="en">Links a creative response to the censorship constraint it reacts to.</rdfs:comment>
    <rdfs:label xml:lang="en">responds to</rdfs:label>
    <rdfs:label xml:lang="ru">отвечает на</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Notorious_Kiss">
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_HitchZone_PCA"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Billheimer2019"/>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Notorious_PCAReview"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <claimText>Hitchcock 'concocted' the kiss scene specifically to get around the supposed three-second rule; Bergman recalled that the censors 'couldn't and didn't cut the scene because we never at any one point kissed for more than three seconds'.</claimText>
    <dataProvenance>documented case</dataProvenance>
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Notorious_FragmentedKiss"/>
    <confidenceLevel>high</confidenceLevel>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#VolkerBraun">
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
    <rdfs:label xml:lang="en">Volker Braun</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#IndirectRepresentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="ru">Косвенное изображение</rdfs:label>
    <rdfs:label xml:lang="en">Indirect representation</rdfs:label>
    <rdfs:comment xml:lang="en">Showing a restricted subject through suggestion, displacement, or implication rather than directly.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ShostakovichSymphony4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#MusicalWork"/>
    <title>Symphony No. 4 in C minor, Op. 43</title>
    <creationYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1936</creationYear>
    <rdfs:label xml:lang="en">Symphony No. 4 in C minor, Op. 43</rdfs:label>
    <createdBy rdf:resource="http://example.org/censorcreate#DmitriShostakovich"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ContentRestriction">
    <rdfs:comment xml:lang="en">A constraint on specific content (passages, images, scenes) that may appear in a work.</rdfs:comment>
    <rdfs:label xml:lang="en">Content restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Ограничение содержания</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_HKR_PartyPrivilegeSatire">
    <rdf:type rdf:resource="http://example.org/censorcreate#Theme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <description>Ironic portrayal of a Party functionary (Kunze) and his chauffeur (Hinze); apparatchik privilege at the heart of the plot.</description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Ambiguity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="ru">Двусмысленность</rdfs:label>
    <rdfs:label xml:lang="en">Ambiguity</rdfs:label>
    <rdfs:comment xml:lang="en">Deliberate openness of meaning that allows several readings, including a restricted one.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#publicationYear">
    <rdfs:comment xml:lang="en">The year a source was published.</rdfs:comment>
    <rdfs:label xml:lang="ru">год публикации</rdfs:label>
    <rdfs:label xml:lang="en">publication year</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AudioElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Audio element</rdfs:label>
    <rdfs:label xml:lang="ru">Аудиоэлемент</rdfs:label>
    <rdfs:comment xml:lang="en">A sound, musical passage, or spoken audio component of a creative work.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Suppression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:comment xml:lang="en">The expression was effectively suppressed and did not reach its audience in the intended form.</rdfs:comment>
    <rdfs:label xml:lang="en">Suppression</rdfs:label>
    <rdfs:label xml:lang="ru">Подавление</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#PriorApproval">
    <rdfs:label xml:lang="ru">Предварительное одобрение</rdfs:label>
    <rdfs:label xml:lang="en">Prior approval</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:comment xml:lang="en">A requirement that a work be reviewed and approved by an authority before release.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MediumAdaptation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label>Medium adaptation</rdfs:label>
    <rdfs:comment>Сhanging the artistic medium or technique in response to a constraint.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Editor">
    <rdfs:label>Editor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Agent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b9">
    <rdf:rest rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b10"/>
    <rdf:first rdf:resource="http://example.org/censorcreate#CreativeWork"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#HistoricalDisplacement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:comment>Moving sensitive content to another historical context to reduce its directness.</rdfs:comment>
    <rdfs:label>Historical displacement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TestFilm">
    <rdf:type rdf:resource="http://example.org/censorcreate#Film"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <title>Test Film</title>
    <rdfs:label xml:lang="en">Test film</rdfs:label>
    <dataProvenance>synthetic test individual</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EliaKazan">
    <rdfs:label xml:lang="en">Elia Kazan</rdfs:label>
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MusicalWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:comment xml:lang="en">A creative work expressed primarily through music, with or without lyrics.</rdfs:comment>
    <rdfs:label xml:lang="en">Musical work</rdfs:label>
    <rdfs:label xml:lang="ru">Музыкальное произведение</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Redaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:comment xml:lang="en">Deletion or obscuring of specific passages, scenes, or elements of a work.</rdfs:comment>
    <rdfs:label xml:lang="ru">Вымарывание</rdfs:label>
    <rdfs:label xml:lang="en">Redaction</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#VisualElement">
    <rdfs:label xml:lang="en">Visual element</rdfs:label>
    <rdfs:label xml:lang="ru">Визуальный элемент</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An image, shot, symbol, or other visual component of a creative work.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Claim">
    <rdfs:comment xml:lang="en">A statement linking a censorship event and a creative response, supported by one or more sources. Used to make the evidence for each relation explicit.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Утверждение</rdfs:label>
    <rdfs:label xml:lang="en">Claim</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MinimalProduction">
    <rdfs:label>Minimal production</rdfs:label>
    <rdfs:comment>Reducing production scale or resources to continue creating under restrictions.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Streetcar_SexualThemes">
    <description>Allan Grey's homosexuality, Blanche's sexuality, Stanley's rape of Blanche, and the moral consequences of Stanley's actions.</description>
    <rdf:type rdf:resource="http://example.org/censorcreate#Theme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#NeapolitanCensors">
    <rdfs:label xml:lang="en">Censors of the Kingdom of Naples</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAuthority"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ReichChamberFineArts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAuthority"/>
    <rdfs:label xml:lang="en">Reich Chamber of Fine Arts (Reichskammer der bildenden Künste)</rdfs:label>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#aboutCreativeResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:label xml:lang="ru">о творческом ответе</rdfs:label>
    <rdfs:label xml:lang="en">about creative response</rdfs:label>
    <rdfs:comment xml:lang="en">Links a claim to the creative response it concerns.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Ballo_Regicide">
    <constrainsElement rdf:resource="http://example.org/censorcreate#EL_Ballo_RegicidePlot"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <description>A royal assassination and the sovereign status of the protagonist could not be represented in the proposed form.</description>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#SubjectRestriction"/>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#DirectRepresentationRestriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Bulgakov_PoliticalSatire">
    <description>Satirical and political treatment of Soviet institutions and social life.</description>
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#Theme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MojtabaMirtahmasb">
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Creator"/>
    <rdfs:label xml:lang="en">Mojtaba Mirtahmasb</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b4">
    <rdf:first rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:rest rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#documentedBy">
    <rdfs:label xml:lang="ru">задокументировано в</rdfs:label>
    <rdfs:label xml:lang="en">documented by</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/censorcreate#Source"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:comment xml:lang="en">Links a censorship event or creative response to a source that documents it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Irony">
    <rdfs:label xml:lang="ru">Ирония</rdfs:label>
    <rdfs:label xml:lang="en">Irony</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:comment xml:lang="en">Saying one thing while meaning another, so that criticism is conveyed under an outwardly acceptable surface. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Something that happens at a certain time and involves agents and creative works.</rdfs:comment>
    <rdfs:label xml:lang="ru">Событие</rdfs:label>
    <rdfs:label xml:lang="en">Event</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b10">
    <rdf:first rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b8"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#supportedBy">
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdfs:label xml:lang="ru">подтверждается</rdfs:label>
    <rdfs:label xml:lang="en">supported by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:comment xml:lang="en">Links a claim to a source that supports it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Panahi_FilmmakingActivity">
    <description>Film directing and screenplay writing.</description>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeActivity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Euphemism">
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Euphemism</rdfs:label>
    <rdfs:label xml:lang="ru">Эвфемизм</rdfs:label>
    <rdfs:comment xml:lang="en">Replacement of a restricted word or expression with a milder or indirect one.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#hasOutcome">
    <rdfs:range rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:label xml:lang="ru">имеет результат</rdfs:label>
    <rdfs:label xml:lang="en">has outcome</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:comment xml:lang="en">Links a creative response to its outcome. In v2 the domain is CreativeResponse (previously Event).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#eventDate">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">event date</rdfs:label>
    <rdfs:label xml:lang="ru">дата события</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:comment xml:lang="en">The year a censorship event or creative response took place (recorded as a year).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_NGI_NoldeDegenerate">
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <sourceTitle>Entartete Kunst / Degenerate Art</sourceTitle>
    <sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nationalgallery.ie/emil-nolde-colour-life/entartete-kunst-degenerate-art</sourceURL>
    <dataProvenance>documented case</dataProvenance>
    <bibliographicCitation>National Gallery of Ireland. Entartete Kunst / Degenerate Art (Emil Nolde: Colour is Life exhibition material).</bibliographicCitation>
    <rdfs:label xml:lang="en">Entartete Kunst / Degenerate Art</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b2">
    <owl:onProperty rdf:resource="http://example.org/censorcreate#usesStrategy"/>
    <owl:someValuesFrom rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#dataProvenance">
    <rdfs:label xml:lang="ru">происхождение данных</rdfs:label>
    <rdfs:label xml:lang="en">data provenance</rdfs:label>
    <rdfs:comment xml:lang="en">Marks whether an individual is documented (real case), synthetic (test or AI-generated), or a template.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Shost_Formalism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <description>Condemnation of 'formalism': dissonant, modernist musical language declared unacceptable; Kerzhentsev demanded a concrete demonstration of reform in future works.</description>
    <dataProvenance>documented case</dataProvenance>
    <constrainsElement rdf:resource="http://example.org/censorcreate#EL_Shost_ModernistIdiom"/>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#StylisticRestriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ModificationRequirement">
    <rdfs:label xml:lang="en">Modification requirement</rdfs:label>
    <rdfs:label xml:lang="ru">Требование изменений</rdfs:label>
    <rdfs:comment xml:lang="en">A demand that the creator alter a work as a condition for approval or release.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ProfessionalPracticeRestriction">
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>Professional practice restriction</rdfs:label>
    <rdfs:comment>A constraint that limits or prohibits a creator from carrying out their professional creative activity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8d751fe7e3ba41d59300b94e5ba92132b8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/censorcreate#isTargetOf"/>
    <owl:someValuesFrom rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#title">
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:comment xml:lang="en">The title of a creative work.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ru">название</rdfs:label>
    <rdfs:label xml:lang="en">title</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Nolde_ArtMaking">
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeActivity"/>
