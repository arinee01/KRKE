    <rdfs:label xml:lang="ru">Изъятие</rdfs:label>
    <rdfs:label xml:lang="en">Removal</rdfs:label>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Withdrawal of a work, or of a part of it, from circulation, display, or a collection.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Notorious_Kiss">
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Notorious_PCAReview"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_HitchZone_PCA"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Billheimer2019"/>
    <cc:claimText>Hitchcock 'concocted' the kiss scene specifically to get around the supposed three-second rule; Bergman recalled that the censors 'couldn't and didn't cut the scene because we never at any one point kissed for more than three seconds'.</cc:claimText>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Notorious_FragmentedKiss"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#PublicationRestriction">
    <rdfs:comment xml:lang="en">A limitation on whether, when, or in what form a work may be published.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Publication restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Ограничение публикации</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SelfCensorship">
    <rdfs:comment xml:lang="en">Restriction of expression by the creator in anticipation of censorship or sanctions.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Self-censorship</rdfs:label>
    <rdfs:label xml:lang="ru">Самоцензура</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Creator">
    <rdfs:comment xml:lang="en">An agent who creates a creative work: an author, filmmaker, composer, visual artist, or similar.</rdfs:comment>
    <rdfs:label xml:lang="en">Creator</rdfs:label>
    <rdfs:label xml:lang="ru">Создатель</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Agent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_MasterMargarita_TextRestoration">
    <cc:performedBy rdf:resource="http://example.org/censorcreate#ElenaBulgakova"/>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#CON_MasterMargarita_PublicationCuts"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Curtis2019_Bulgakov"/>
    <cc:documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <cc:eventDate>1966-1969</cc:eventDate>
    <cc:producesVersion rdf:resource="http://example.org/censorcreate#MasterMargarita_FullRussian1969"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#AlternativeVersionProduced"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#AlternativePublication"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#TextualRestoration"/>
    <cc:description>Elena Bulgakova preserved and prepared the text for publication; omitted passages circulated outside the censored journal version, and complete versions were subsequently published abroad, including a complete Russian text.</cc:description>
    <cc:dataProvenance>documented case</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#usesMechanism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:comment xml:lang="en">Links a censorship event to the mechanism through which censorship was applied.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="ru">использует механизм</rdfs:label>
    <rdfs:label xml:lang="en">uses mechanism</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#respondsTo">
    <rdfs:label xml:lang="en">responds to</rdfs:label>
    <rdfs:label xml:lang="ru">отвечает на</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:comment xml:lang="en">Links a creative response to the censorship constraint it reacts to.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Streetcar_Cuts">
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:claimText>AFI records that the studio made twelve cuts without consulting Kazan and that Kazan believed some cuts changed the interpretation of the characters. This row represents a disabling/suppressive outcome rather than a creative response by the creators.</cc:claimText>
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Streetcar_LegionCuts1951"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Euphemism">
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
