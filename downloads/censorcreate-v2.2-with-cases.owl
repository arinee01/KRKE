  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Sym4_Withdrawal">
    <confidenceLevel>high</confidenceLevel>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Sym4"/>
