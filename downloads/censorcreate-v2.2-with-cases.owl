  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Shost_ModernistIdiom">
    <rdf:type rdf:resource="http://example.org/censorcreate#AudioElement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:description>Dissonant, modernist musical idiom of Lady Macbeth (and of the Fourth Symphony in progress).</cc:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#imposesConstraint">
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdfs:label xml:lang="ru">накладывает ограничение</rdfs:label>
    <rdfs:label xml:lang="en">imposes constraint</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
