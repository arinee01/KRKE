  <rdf:Description rdf:about="http://example.org/censorcreate#RE_MasterMargarita_TextRestoration">
    <usesStrategy rdf:resource="http://example.org/censorcreate#AlternativePublication"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#TextualRestoration"/>
    <producesVersion rdf:resource="http://example.org/censorcreate#MasterMargarita_FullRussian1969"/>
    <dataProvenance>documented case</dataProvenance>
    <description>Elena Bulgakova preserved and prepared the text for publication; omitted passages circulated outside the censored journal version, and complete versions were subsequently published abroad, including a complete Russian text.</description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <performedBy rdf:resource="http://example.org/censorcreate#ElenaBulgakova"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Curtis2019_Bulgakov"/>
    <eventDate>1966-1969</eventDate>
    <hasOutcome rdf:resource="http://example.org/censorcreate#AlternativeVersionProduced"/>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_MasterMargarita_PublicationCuts"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipEvent">
    <rdfs:comment xml:lang="en">A documented act or process of censorship affecting a creative work, carried out by a censoring agent through a censorship mechanism.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Censorship event</rdfs:label>
    <rdfs:label xml:lang="ru">Цензурное событие</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Ballo_Transposition">
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Ballo_Transposition"/>
    <confidenceLevel>high</confidenceLevel>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Met_Ballo"/>
    <claimText>The Metropolitan Opera and Verdi critical-edition sources explicitly link the Boston setting and transformed characters to negotiations with the censors. This is a strong example of narrative transposition used to preserve a censored dramatic structure.</claimText>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Ballo_RomeCensorship1858"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#GiuseppeVerdi">
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
