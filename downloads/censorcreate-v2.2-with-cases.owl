    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">A short free-text description of an individual (event, response, constraint, element).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Panahi_ThisIsNotAFilm">
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_ThisIsNotAFilm2011"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_CinemaIranica_TINAF"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Cannes_Panahi2011"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_IranHumanRights_Panahi2010"/>
    <performedBy rdf:resource="http://example.org/censorcreate#JafarPanahi"/>
    <performedBy rdf:resource="http://example.org/censorcreate#MojtabaMirtahmasb"/>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_Panahi_Filmmaking"/>
    <resultsInWork rdf:resource="http://example.org/censorcreate#ThisIsNotAFilm"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#Circumvention"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#MinimalProduction"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#SelfReflexivity"/>
    <dataProvenance>documented case</dataProvenance>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2011</eventDate>
    <description>Panahi and Mojtaba Mirtahmasb made a self-reflexive video diary largely inside Panahi's apartment. Panahi stages and describes an unproduced screenplay and turns the conditions of being forbidden to make films into part of the film's subject and form.</description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#versionOf">
    <rdfs:label xml:lang="en">version of</rdfs:label>
    <rdfs:label xml:lang="ru">версия произведения</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#WorkVersion"/>
    <rdfs:comment xml:lang="en">Links a work version to the original creative work.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeWork"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#PeriodicalArticle">
    <rdfs:comment xml:lang="en">An article in a journal, review, magazine, or newspaper. Added in v2.1.</rdfs:comment>
    <rdfs:label xml:lang="ru">Статья в периодике</rdfs:label>
    <rdfs:label xml:lang="en">Periodical article</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Source"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Satire">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label>Satire</rdfs:label>
    <rdfs:comment>Using irony, exaggeration, or ridicule to express criticism indirectly.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_HKR_Distribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <confidenceLevel>high</confidenceLevel>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <claimText>Distribution was stopped on 10 September 1985 (agent not named in the source); Höpcke was 'called on the carpet and given a formal censure'. No documented creative response to this second event.</claimText>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_HKR_DistributionStop"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Ballo_Naples">
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Giger1999_Ballo"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Ricordi_BalloCritical"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Ballo_LeaveNaples"/>
    <confidenceLevel>high</confidenceLevel>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Ballo_NaplesCensorship1858"/>
    <claimText>Ricordi's critical-edition documentation states that censorship demands were severe enough for Verdi to break the Naples contract; scholarship on Verdi's censorship confirms that Un ballo in maschera had been rejected elsewhere before its Roman premiere.</claimText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_Wiki_Sym4">
