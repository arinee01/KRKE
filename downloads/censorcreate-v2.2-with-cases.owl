  <rdf:Description rdf:about="http://example.org/censorcreate#RE_HKR_IronicNarration">
    <performedBy rdf:resource="http://example.org/censorcreate#VolkerBraun"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#Allegory"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#Irony"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1981</eventDate>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_HKR_Ideology"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Darnton1991"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <dataProvenance>documented case</dataProvenance>
    <description>Braun frames the critique in an ironic, Diderot-like master-servant narrative with an intrusive narrator who comments on what 'cannot be said directly'.</description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#WebSource">
    <rdfs:label xml:lang="en">Web source</rdfs:label>
    <rdfs:label xml:lang="ru">Веб-источник</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Source"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A web page such as a publisher page, programme note, or encyclopedia entry. Tertiary web sources are used for orientation only. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Streetcar_SexualContent">
    <hasConstraintType rdf:resource="http://example.org/censorcreate#DirectRepresentationRestriction"/>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#ContentRestriction"/>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#SubjectRestriction"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <dataProvenance>documented case</dataProvenance>
    <constrainsElement rdf:resource="http://example.org/censorcreate#EL_Streetcar_SexualThemes"/>
    <description>The adaptation could not directly represent or clearly state several sexual themes in the same form as the play, and the filmmakers were pressed to alter their treatment.</description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TestConstraint">
    <hasConstraintType rdf:resource="http://example.org/censorcreate#DirectRepresentationRestriction"/>
    <dataProvenance>synthetic test individual</dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Test constraint</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Removal">
    <rdfs:label xml:lang="en">Removal</rdfs:label>
    <rdfs:label xml:lang="ru">Изъятие</rdfs:label>
    <rdfs:comment xml:lang="en">Withdrawal of a work, or of a part of it, from circulation, display, or a collection.</rdfs:comment>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#usesStrategy">
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="ru">использует стратегию</rdfs:label>
    <rdfs:label xml:lang="en">uses strategy</rdfs:label>
    <rdfs:comment xml:lang="en">Links a creative response to the creative strategy used in it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensoringAuthority">
    <rdfs:label xml:lang="en">Censoring authority</rdfs:label>
    <rdfs:label xml:lang="ru">Цензурный орган</rdfs:label>
    <rdfs:comment xml:lang="en">An institutional censoring agent with formal power to approve, restrict, or prohibit creative works, such as a state censorship office or official board.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CensoringAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Streetcar_ScreenplayRewrite">
    <usesStrategy rdf:resource="http://example.org/censorcreate#Ambiguity"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#NarrativeModification"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#IndirectRepresentation"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <description>Kazan and Williams negotiated and altered the screenplay. Williams rewrote the ending so that Stella appears, somewhat ambiguously, to leave Stanley rather than return to him; other restricted material was handled more indirectly.</description>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_Streetcar_SexualContent"/>
    <performedBy rdf:resource="http://example.org/censorcreate#EliaKazan"/>
    <performedBy rdf:resource="http://example.org/censorcreate#TennesseeWilliams"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1950</eventDate>
    <hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <producesVersion rdf:resource="http://example.org/censorcreate#Streetcar1951_PCAApprovedVersion"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#DirectRepresentationRestriction">
    <rdfs:label xml:lang="ru">Запрет прямого изображения</rdfs:label>
    <rdfs:label xml:lang="en">Direct representation restriction</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint that forbids showing or naming something directly, while indirect reference may remain possible.</rdfs:comment>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Streetcar_Cuts">
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Streetcar_LegionCuts1951"/>
    <dataProvenance>documented case</dataProvenance>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Szabo2019_Streetcar"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_AFI_Streetcar1951"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <confidenceLevel>high</confidenceLevel>
    <claimText>AFI records that the studio made twelve cuts without consulting Kazan and that Kazan believed some cuts changed the interpretation of the characters. This row represents a disabling/suppressive outcome rather than a creative response by the creators.</claimText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ParatextualFraming">
    <rdfs:comment xml:lang="en">Adding a preface, afterword, commentary, or other accompanying text that guides interpretation and makes the work acceptable to censors. Added in v2.1.</rdfs:comment>
    <rdfs:label xml:lang="ru">Паратекстуальное обрамление</rdfs:label>
    <rdfs:label xml:lang="en">Paratextual framing</rdfs:label>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Bulgakov_LiterarySuppression1930s">
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_Bulgakov_AesopianExpression"/>
    <targetsWork rdf:resource="http://example.org/censorcreate#MasterAndMargarita"/>
    <description>By the late 1920s and 1930s Bulgakov's prospects for publishing original fiction had sharply deteriorated; scholarly accounts describe him as no longer able to publish original fiction while he continued work on The Master and Margarita.</description>
    <usesMechanism rdf:resource="http://example.org/censorcreate#PublicationRestriction"/>
    <imposedBy rdf:resource="http://example.org/censorcreate#SovietLiteraryEstablishment"/>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Bulgakov_PoliticalExpression"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Rosenshield1997_Bulgakov"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Pope1977_Bulgakov"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <eventDate>1930s</eventDate>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CON_Notorious_Character">
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dataProvenance>documented case</dataProvenance>
    <description>Alicia must not appear as a 'grossly immoral woman'; any suggestion of sexual promiscuity to be avoided; the word 'tramp' to be removed.</description>
    <hasConstraintType rdf:resource="http://example.org/censorcreate#SubjectRestriction"/>
    <constrainsElement rdf:resource="http://example.org/censorcreate#EL_Notorious_AliciaCharacter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#DistributionRestriction">
