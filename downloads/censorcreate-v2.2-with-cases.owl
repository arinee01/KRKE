  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MasterAndMargarita">
    <cc:title>The Master and Margarita</cc:title>
    <cc:createdBy rdf:resource="http://example.org/censorcreate#MikhailBulgakov"/>
    <rdfs:label xml:lang="en">The Master and Margarita</rdfs:label>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#LiteraryWork"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
