    <rdfs:label xml:lang="ru">Адаптивный творческий ответ</rdfs:label>
    <rdfs:comment xml:lang="en">A creative response that uses at least one creative strategy and has the outcome CreativeAdaptation. Membership is inferred by a reasoner.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n9141d9ab9dcb4c8dbd4acd306422dfb7b1"/>
  </rdf:Description>
