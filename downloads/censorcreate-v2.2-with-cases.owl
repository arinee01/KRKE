    <sourceTitle>Hitchcock and the Censors (ch. 14 'Notorious (1946)')</sourceTitle>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_Nolde_UnpaintedPictures">
    <resultsInWork rdf:resource="http://example.org/censorcreate#Nolde_UnpaintedPictures"/>
    <description>Nolde continued working privately and produced further small-format watercolours in Seebüll. Museum accounts describe these works as being made secretly during the period of prohibition.</description>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_NGI_NoldeDegenerate"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_NoldeMuseum_Artist"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#SecretProduction"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#MediumAdaptation"/>
    <eventDate>1941-1945</eventDate>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_Nolde_ProfessionalPractice"/>
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <performedBy rdf:resource="http://example.org/censorcreate#EmilNolde"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#RE_HKR_Lesehilfe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <respondsTo rdf:resource="http://example.org/censorcreate#CON_HKR_Ideology"/>
    <dataProvenance>documented case</dataProvenance>
    <description>Dieter Schlenstedt, one of the manuscript's first reviewers, writes an appended 'schöngeistige Lesehilfe': five fictional letters that ironise the review process and guide readers; the text was meant both to placate the censors and to guide reading.</description>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Lance_Metailie"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_bpb_Selbstzensur"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Hoepcke1985"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_GuibertYeche"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#Irony"/>
    <usesStrategy rdf:resource="http://example.org/censorcreate#ParatextualFraming"/>
    <hasOutcome rdf:resource="http://example.org/censorcreate#AlternativeVersionProduced"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1985</eventDate>
    <producesVersion rdf:resource="http://example.org/censorcreate#HKR_GDR_1985"/>
    <performedBy rdf:resource="http://example.org/censorcreate#DieterSchlenstedt"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeWork">
    <rdfs:label xml:lang="en">Creative work</rdfs:label>
    <rdfs:label xml:lang="ru">Творческое произведение</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A product of creative activity, such as a literary work, film, musical work, or visual artwork.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate">
    <owl:versionIRI rdf:resource="http://example.org/censorcreate/2.2"/>
    <dcterms:title xml:lang="en">Censorship and Creative Response Core Ontology</dcterms:title>
    <rdfs:comment xml:lang="en">A core ontology for representing censorship events, the constraints they impose on creative works, the documented creative responses of creators, the strategies used in those responses, their outcomes, and the sources and claims that support them. The model is conditional, not deterministic: censorship may lead to suppression, modification, abandonment, or creative adaptation. Theoretical basis: R. Darnton (censorship as an institutional process), P. D. Stokes (creativity from constraints), B. D. Rosso (enabling and disabling effects of constraints).</rdfs:comment>
    <owl:versionInfo>v2.2 (merged: +5 cases, +Editor/+CreativePractice, performedBy-&gt;Agent, producesWork unified into resultsInWork)</owl:versionInfo>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">ConCreCen — Core Ontology v2</rdfs:label>
    <skos:changeNote xml:lang="en">v2: (1) domain of hasOutcome narrowed from Event to CreativeResponse; (2) English and Russian labels and English definitions added to all classes, properties and controlled values; (3) DistributionRestriction mechanism and a small set of documentation data properties added; (4) test individuals kept and marked as synthetic; (5) no real historical cases added. v2.1: data properties aligned with project documentation (eventDate, publicationYear); added resultsInWork, StylisticRestriction, Irony, ParatextualFraming, Fragmentation.</skos:changeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#LiteraryWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">Literary work</rdfs:label>
    <rdfs:label xml:lang="ru">Литературное произведение</rdfs:label>
    <rdfs:comment xml:lang="en">A creative work expressed primarily in written language: novel, poem, play, essay, and similar.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EL_Notorious_AliciaCharacter">
    <dataProvenance>documented case</dataProvenance>
    <rdf:type rdf:resource="http://example.org/censorcreate#Theme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <description>Characterisation of Alicia Huberman's sexual morality.</description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipMechanism">
    <rdfs:label xml:lang="en">Censorship mechanism</rdfs:label>
    <rdfs:label xml:lang="ru">Механизм цензуры</rdfs:label>
    <rdfs:comment xml:lang="en">A method through which censorship is applied to a creative work, such as a ban, removal, or required modification.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SRC_CinemaIranica_TINAF">
    <rdf:type rdf:resource="http://example.org/censorcreate#WebSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cinema.iranicaonline.org/film/this-is-not-a-film/</sourceURL>
    <dataProvenance>documented case</dataProvenance>
    <bibliographicCitation>Cinema Iranica. This Is Not a Film (film entry).</bibliographicCitation>
    <rdfs:label xml:lang="en">This Is Not a Film</rdfs:label>
    <sourceTitle>This Is Not a Film</sourceTitle>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Shost_Fifth">
    <claimText>The Fifth Symphony is documented as Shostakovich's response to the 1936 criticism ('a Soviet artist's creative reply to just criticism') and led to his rehabilitation; whether the finale is sincere or ironic remains debated, so the Ambiguity strategy is an interpretation.</claimText>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Muddle"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <supportedBy rdf:resource="http://example.org/censorcreate#SRC_Robinson_BSO"/>
    <confidenceLevel>medium</confidenceLevel>
    <aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Shost_FifthSymphony"/>
    <aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Pravda1936"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#aboutCensorshipEvent">
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Links a claim to the censorship event it concerns.</rdfs:comment>
    <rdfs:label xml:lang="en">about censorship event</rdfs:label>
    <rdfs:label xml:lang="ru">о цензурном событии</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Claim"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#EV_Sym4_Cancellation">
    <hasResponse rdf:resource="http://example.org/censorcreate#RE_Sym4_Withdrawal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#Ban"/>
    <usesMechanism rdf:resource="http://example.org/censorcreate#SelfCensorship"/>
    <eventDate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1936</eventDate>
    <description>Premiere planned for 11 December 1936 (Leningrad Philharmonic, Stiedry) cancelled after rehearsals; officially presented as the composer's withdrawal, while other accounts (Glikman) report pressure from Party and Composers' Union officials.</description>
    <targetsWork rdf:resource="http://example.org/censorcreate#ShostakovichSymphony4"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_Wiki_Sym4"/>
    <documentedBy rdf:resource="http://example.org/censorcreate#SRC_FrolovaWalker2023"/>
    <imposedBy rdf:resource="http://example.org/censorcreate#SovietComposersUnion"/>
    <imposesConstraint rdf:resource="http://example.org/censorcreate#CON_Shost_Formalism"/>
    <dataProvenance>documented case</dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#sourceURL">
    <rdfs:comment xml:lang="en">A web address where the source can be accessed.</rdfs:comment>
    <rdfs:label xml:lang="en">source URL</rdfs:label>
    <rdfs:label xml:lang="ru">URL источника</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Source"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SelfReflexivity">
    <rdfs:comment>A strategy in which the work explicitly reflects on its own creation, form, or conditions of production.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label>Self-reflexivity</rdfs:label>
  </rdf:Description>
