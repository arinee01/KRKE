<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:cc="http://example.org/censorcreate#"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://example.org/censorcreate#ParatextualFraming">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Paratextual framing</rdfs:label>
    <rdfs:label xml:lang="ru">Паратекстуальное обрамление</rdfs:label>
    <rdfs:comment xml:lang="en">Adding a preface, afterword, commentary, or other accompanying text that guides interpretation and makes the work acceptable to censors. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Agent"/>
    <rdfs:label xml:lang="en">Creator</rdfs:label>
    <rdfs:label xml:lang="ru">Создатель</rdfs:label>
    <rdfs:comment xml:lang="en">An agent who creates a creative work: an author, filmmaker, composer, visual artist, or similar.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#resultsInWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">results in work</rdfs:label>
    <rdfs:label xml:lang="ru">приводит к произведению</rdfs:label>
    <rdfs:comment xml:lang="en">Links a creative response to a new, separate creative work that resulted from it (for a new version of the same work use producesVersion). Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#aboutCensorshipEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:label xml:lang="en">about censorship event</rdfs:label>
    <rdfs:label xml:lang="ru">о цензурном событии</rdfs:label>
    <rdfs:comment xml:lang="en">Links a claim to the censorship event it concerns.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Metaphor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Metaphor</rdfs:label>
    <rdfs:label xml:lang="ru">Метафора</rdfs:label>
    <rdfs:comment xml:lang="en">Expression of a restricted idea through figurative comparison.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TestEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:label xml:lang="en">Test censorship event</rdfs:label>
    <cc:targetsWork rdf:resource="http://example.org/censorcreate#TestFilm"/>
    <cc:usesMechanism rdf:resource="http://example.org/censorcreate#ModificationRequirement"/>
    <cc:imposesConstraint rdf:resource="http://example.org/censorcreate#TestConstraint"/>
    <cc:hasResponse rdf:resource="http://example.org/censorcreate#TestResponse"/>
    <cc:dataProvenance>synthetic test individual</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:label xml:lang="en">Creative response</rdfs:label>
    <rdfs:label xml:lang="ru">Творческий ответ</rdfs:label>
    <rdfs:comment xml:lang="en">A documented action of a creator in reaction to a censorship constraint, for example revising, encoding, relocating, or abandoning a work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#sourceTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">source title</rdfs:label>
    <rdfs:label xml:lang="ru">название источника</rdfs:label>
    <rdfs:comment xml:lang="en">The title of a source.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ContentRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdfs:label xml:lang="en">Content restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Ограничение содержания</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint on specific content (passages, images, scenes) that may appear in a work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#confidenceLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">confidence level</rdfs:label>
    <rdfs:label xml:lang="ru">уровень уверенности</rdfs:label>
    <rdfs:comment xml:lang="en">How strongly the sources support the claim: high, medium, or low.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipConstraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Constraint"/>
    <rdfs:label xml:lang="en">Censorship constraint</rdfs:label>
    <rdfs:label xml:lang="ru">Цензурное ограничение</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint imposed by a censorship event. Not every constraint is censorship; this class covers only constraints resulting from censorship.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#WorkVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">Work version</rdfs:label>
    <rdfs:label xml:lang="ru">Версия произведения</rdfs:label>
    <rdfs:comment xml:lang="en">A specific version of a creative work, for example a revised, cut, re-edited, or alternative version produced in response to censorship.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Redaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Redaction</rdfs:label>
    <rdfs:label xml:lang="ru">Вымарывание</rdfs:label>
    <rdfs:comment xml:lang="en">Deletion or obscuring of specific passages, scenes, or elements of a work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#BookChapter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:label xml:lang="en">Book chapter</rdfs:label>
    <rdfs:label xml:lang="ru">Глава книги</rdfs:label>
    <rdfs:comment xml:lang="en">A chapter in an edited or collected volume used as a source. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Irony">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Irony</rdfs:label>
    <rdfs:label xml:lang="ru">Ирония</rdfs:label>
    <rdfs:comment xml:lang="en">Saying one thing while meaning another, so that criticism is conveyed under an outwardly acceptable surface. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Euphemism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Euphemism</rdfs:label>
    <rdfs:label xml:lang="ru">Эвфемизм</rdfs:label>
    <rdfs:comment xml:lang="en">Replacement of a restricted word or expression with a milder or indirect one.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Abandonment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:label xml:lang="en">Abandonment</rdfs:label>
    <rdfs:label xml:lang="ru">Отказ от замысла</rdfs:label>
    <rdfs:comment xml:lang="en">The creator abandoned the work or project.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AlternativeVersionProduced">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:label xml:lang="en">Alternative version produced</rdfs:label>
    <rdfs:label xml:lang="ru">Создана альтернативная версия</rdfs:label>
    <rdfs:comment xml:lang="en">A separate version of the work was produced, for example for a different audience or country.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Fragmentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Fragmentation</rdfs:label>
    <rdfs:label xml:lang="ru">Фрагментация</rdfs:label>
    <rdfs:comment xml:lang="en">Breaking a restricted action or representation into a series of short units, each of which stays within the permitted limit. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensoredWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <owl:equivalentClass rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b1"/>
    <rdfs:label xml:lang="en">Censored work</rdfs:label>
    <rdfs:label xml:lang="ru">Цензурированное произведение</rdfs:label>
    <rdfs:comment xml:lang="en">A creative work that is the target of at least one censorship event. Membership is inferred by a reasoner.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SelfCensorship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Self-censorship</rdfs:label>
    <rdfs:label xml:lang="ru">Самоцензура</rdfs:label>
    <rdfs:comment xml:lang="en">Restriction of expression by the creator in anticipation of censorship or sanctions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#producesVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#WorkVersion"/>
    <rdfs:label xml:lang="en">produces version</rdfs:label>
    <rdfs:label xml:lang="ru">создаёт версию</rdfs:label>
    <rdfs:comment xml:lang="en">Links a creative response to a new version of the work that resulted from it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Modification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:label xml:lang="en">Modification</rdfs:label>
    <rdfs:label xml:lang="ru">Изменение</rdfs:label>
    <rdfs:comment xml:lang="en">The work was altered to comply with the constraint, without documented creative adaptation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ConstraintType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Constraint type</rdfs:label>
    <rdfs:label xml:lang="ru">Тип ограничения</rdfs:label>
    <rdfs:comment xml:lang="en">A controlled category describing what a censorship constraint restricts, for example content, subject, or direct representation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#constrainsElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#WorkElement"/>
    <rdfs:label xml:lang="en">constrains element</rdfs:label>
    <rdfs:label xml:lang="ru">ограничивает элемент</rdfs:label>
    <rdfs:comment xml:lang="en">Links a censorship constraint to the specific element of a work it restricts.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TextualElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
    <rdfs:label xml:lang="en">Textual element</rdfs:label>
    <rdfs:label xml:lang="ru">Текстовый элемент</rdfs:label>
    <rdfs:comment xml:lang="en">A word, passage, line, title, or lyric within a creative work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Event</rdfs:label>
    <rdfs:label xml:lang="ru">Событие</rdfs:label>
    <rdfs:comment xml:lang="en">Something that happens at a certain time and involves agents and creative works.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AdaptiveCreativeResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <owl:equivalentClass rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b5"/>
    <rdfs:label xml:lang="en">Adaptive creative response</rdfs:label>
    <rdfs:label xml:lang="ru">Адаптивный творческий ответ</rdfs:label>
    <rdfs:comment xml:lang="en">A creative response that uses at least one creative strategy and has the outcome CreativeAdaptation. Membership is inferred by a reasoner.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#ModificationRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Modification requirement</rdfs:label>
    <rdfs:label xml:lang="ru">Требование изменений</rdfs:label>
    <rdfs:comment xml:lang="en">A demand that the creator alter a work as a condition for approval or release.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#usesStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">uses strategy</rdfs:label>
    <rdfs:label xml:lang="ru">использует стратегию</rdfs:label>
    <rdfs:comment xml:lang="en">Links a creative response to the creative strategy used in it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#hasConstraintType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdfs:label xml:lang="en">has constraint type</rdfs:label>
    <rdfs:label xml:lang="ru">имеет тип ограничения</rdfs:label>
    <rdfs:comment xml:lang="en">Classifies a censorship constraint by what it restricts.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:label xml:lang="en">Censorship event</rdfs:label>
    <rdfs:label xml:lang="ru">Цензурное событие</rdfs:label>
    <rdfs:comment xml:lang="en">A documented act or process of censorship affecting a creative work, carried out by a censoring agent through a censorship mechanism.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#targetsWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://example.org/censorcreate#isTargetOf"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">targets work</rdfs:label>
    <rdfs:label xml:lang="ru">направлено на произведение</rdfs:label>
    <rdfs:comment xml:lang="en">Links a censorship event to the creative work it affects.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Ban">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Ban</rdfs:label>
    <rdfs:label xml:lang="ru">Запрет</rdfs:label>
    <rdfs:comment xml:lang="en">Complete prohibition of publication, performance, distribution, or access.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Symbolism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Symbolism</rdfs:label>
    <rdfs:label xml:lang="ru">Символизм</rdfs:label>
    <rdfs:comment xml:lang="en">Use of objects, images, or signs that stand for restricted ideas.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#imposesConstraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdfs:label xml:lang="en">imposes constraint</rdfs:label>
    <rdfs:label xml:lang="ru">накладывает ограничение</rdfs:label>
    <rdfs:comment xml:lang="en">Links a censorship event to the constraint it creates for the creator.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#dataProvenance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">data provenance</rdfs:label>
    <rdfs:label xml:lang="ru">происхождение данных</rdfs:label>
    <rdfs:comment xml:lang="en">Marks whether an individual is documented (real case), synthetic (test or AI-generated), or a template.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Removal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Removal</rdfs:label>
    <rdfs:label xml:lang="ru">Изъятие</rdfs:label>
    <rdfs:comment xml:lang="en">Withdrawal of a work, or of a part of it, from circulation, display, or a collection.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#sourceURL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">source URL</rdfs:label>
    <rdfs:label xml:lang="ru">URL источника</rdfs:label>
    <rdfs:comment xml:lang="en">A web address where the source can be accessed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Book">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:label xml:lang="en">Book</rdfs:label>
    <rdfs:label xml:lang="ru">Книга</rdfs:label>
    <rdfs:comment xml:lang="en">A monograph or edited volume used as a source. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#DirectRepresentationRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdfs:label xml:lang="en">Direct representation restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Запрет прямого изображения</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint that forbids showing or naming something directly, while indirect reference may remain possible.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Suppression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:label xml:lang="en">Suppression</rdfs:label>
    <rdfs:label xml:lang="ru">Подавление</rdfs:label>
    <rdfs:comment xml:lang="en">The expression was effectively suppressed and did not reach its audience in the intended form.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#isTargetOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://example.org/censorcreate#targetsWork"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:label xml:lang="en">is target of</rdfs:label>
    <rdfs:label xml:lang="ru">является объектом</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse of targetsWork: links a creative work to a censorship event that affects it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#respondsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdfs:label xml:lang="en">responds to</rdfs:label>
    <rdfs:label xml:lang="ru">отвечает на</rdfs:label>
    <rdfs:comment xml:lang="en">Links a creative response to the censorship constraint it reacts to.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Source</rdfs:label>
    <rdfs:label xml:lang="ru">Источник</rdfs:label>
    <rdfs:comment xml:lang="en">A documentary or scholarly source (book, article, archival document, interview, etc.) that provides evidence about events and responses.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="http://example.org/censorcreate/2.1"/>
    <owl:versionInfo>2.1</owl:versionInfo>
    <rdfs:label xml:lang="en">ConCreCen — Core Ontology v2</rdfs:label>
    <dcterms:title xml:lang="en">Censorship and Creative Response Core Ontology</dcterms:title>
    <rdfs:comment xml:lang="en">A core ontology for representing censorship events, the constraints they impose on creative works, the documented creative responses of creators, the strategies used in those responses, their outcomes, and the sources and claims that support them. The model is conditional, not deterministic: censorship may lead to suppression, modification, abandonment, or creative adaptation. Theoretical basis: R. Darnton (censorship as an institutional process), P. D. Stokes (creativity from constraints), B. D. Rosso (enabling and disabling effects of constraints).</rdfs:comment>
    <skos:changeNote xml:lang="en">v2: (1) domain of hasOutcome narrowed from Event to CreativeResponse; (2) English and Russian labels and English definitions added to all classes, properties and controlled values; (3) DistributionRestriction mechanism and a small set of documentation data properties added; (4) test individuals kept and marked as synthetic; (5) no real historical cases added. v2.1: data properties aligned with project documentation (eventDate, publicationYear); added resultsInWork, StylisticRestriction, Irony, ParatextualFraming, Fragmentation.</skos:changeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Agent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:label xml:lang="ru">Агент</rdfs:label>
    <rdfs:comment xml:lang="en">A person, group, or institution that can act in a censorship or creative process.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#IndirectRepresentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Indirect representation</rdfs:label>
    <rdfs:label xml:lang="ru">Косвенное изображение</rdfs:label>
    <rdfs:comment xml:lang="en">Showing a restricted subject through suggestion, displacement, or implication rather than directly.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#UnpublishedWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:label xml:lang="en">Unpublished work</rdfs:label>
    <rdfs:label xml:lang="ru">Неопубликованное произведение</rdfs:label>
    <rdfs:comment xml:lang="en">The work remained unpublished, unreleased, or unexhibited as a result of censorship.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Creative work</rdfs:label>
    <rdfs:label xml:lang="ru">Творческое произведение</rdfs:label>
    <rdfs:comment xml:lang="en">A product of creative activity, such as a literary work, film, musical work, or visual artwork.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TestResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:label xml:lang="en">Test creative response</rdfs:label>
    <cc:respondsTo rdf:resource="http://example.org/censorcreate#TestConstraint"/>
    <cc:usesStrategy rdf:resource="http://example.org/censorcreate#Symbolism"/>
    <cc:hasOutcome rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
    <cc:dataProvenance>synthetic test individual</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Allegory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Allegory</rdfs:label>
    <rdfs:label xml:lang="ru">Аллегория</rdfs:label>
    <rdfs:comment xml:lang="en">An extended narrative or image in which the surface story stands for another, restricted meaning.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#versionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#WorkVersion"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">version of</rdfs:label>
    <rdfs:label xml:lang="ru">версия произведения</rdfs:label>
    <rdfs:comment xml:lang="en">Links a work version to the original creative work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#SubjectRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdfs:label xml:lang="en">Subject restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Ограничение темы</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint on which topics or subjects a work may address.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Claim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Claim</rdfs:label>
    <rdfs:label xml:lang="ru">Утверждение</rdfs:label>
    <rdfs:comment xml:lang="en">A statement linking a censorship event and a creative response, supported by one or more sources. Used to make the evidence for each relation explicit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Film">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">Film</rdfs:label>
    <rdfs:label xml:lang="ru">Фильм</rdfs:label>
    <rdfs:comment xml:lang="en">A creative work expressed as a motion picture.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#supportedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:label xml:lang="en">supported by</rdfs:label>
    <rdfs:label xml:lang="ru">подтверждается</rdfs:label>
    <rdfs:comment xml:lang="en">Links a claim to a source that supports it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Creative strategy</rdfs:label>
    <rdfs:label xml:lang="ru">Творческая стратегия</rdfs:label>
    <rdfs:comment xml:lang="en">A method of expression a creator uses within a creative response, such as allegory, metaphor, or indirect representation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensoringAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Agent"/>
    <rdfs:label xml:lang="en">Censoring agent</rdfs:label>
    <rdfs:label xml:lang="ru">Цензурирующий агент</rdfs:label>
    <rdfs:comment xml:lang="en">An agent who imposes or carries out censorship, such as a censor, editor, publisher, board, or platform.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Constraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Constraint</rdfs:label>
    <rdfs:label xml:lang="ru">Ограничение</rdfs:label>
    <rdfs:comment xml:lang="en">A limitation on the range of available solutions in a creative process. Constraints may be technical, economic, social, legal, or institutional.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TestConstraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipConstraint"/>
    <rdfs:label xml:lang="en">Test constraint</rdfs:label>
    <cc:hasConstraintType rdf:resource="http://example.org/censorcreate#DirectRepresentationRestriction"/>
    <cc:dataProvenance>synthetic test individual</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#imposedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensoringAgent"/>
    <rdfs:label xml:lang="en">imposed by</rdfs:label>
    <rdfs:label xml:lang="ru">наложено</rdfs:label>
    <rdfs:comment xml:lang="en">Links a censorship event to the censoring agent responsible for it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#hasResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:label xml:lang="en">has response</rdfs:label>
    <rdfs:label xml:lang="ru">имеет ответ</rdfs:label>
    <rdfs:comment xml:lang="en">Links a censorship event to a documented creative response to it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#claimText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">claim text</rdfs:label>
    <rdfs:label xml:lang="ru">текст утверждения</rdfs:label>
    <rdfs:comment xml:lang="en">The statement made by the claim, in plain language.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensoringAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CensoringAgent"/>
    <rdfs:label xml:lang="en">Censoring authority</rdfs:label>
    <rdfs:label xml:lang="ru">Цензурный орган</rdfs:label>
    <rdfs:comment xml:lang="en">An institutional censoring agent with formal power to approve, restrict, or prohibit creative works, such as a state censorship office or official board.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#eventDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">event date</rdfs:label>
    <rdfs:label xml:lang="ru">дата события</rdfs:label>
    <rdfs:comment xml:lang="en">The year a censorship event or creative response took place (recorded as a year).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#usesMechanism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">uses mechanism</rdfs:label>
    <rdfs:label xml:lang="ru">использует механизм</rdfs:label>
    <rdfs:comment xml:lang="en">Links a censorship event to the mechanism through which censorship was applied.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#WebSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:label xml:lang="en">Web source</rdfs:label>
    <rdfs:label xml:lang="ru">Веб-источник</rdfs:label>
    <rdfs:comment xml:lang="en">A web page such as a publisher page, programme note, or encyclopedia entry. Tertiary web sources are used for orientation only. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Ambiguity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
    <rdfs:label xml:lang="en">Ambiguity</rdfs:label>
    <rdfs:label xml:lang="ru">Двусмысленность</rdfs:label>
    <rdfs:comment xml:lang="en">Deliberate openness of meaning that allows several readings, including a restricted one.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#performedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#Creator"/>
    <rdfs:label xml:lang="en">performed by</rdfs:label>
    <rdfs:label xml:lang="ru">выполнено</rdfs:label>
    <rdfs:comment xml:lang="en">Links a creative response to the creator who carried it out.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#DistributionRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Distribution restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Ограничение распространения</rdfs:label>
    <rdfs:comment xml:lang="en">A limitation on the circulation, screening, sale, or audience of a work (added in v2).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#AudioElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
    <rdfs:label xml:lang="en">Audio element</rdfs:label>
    <rdfs:label xml:lang="ru">Аудиоэлемент</rdfs:label>
    <rdfs:comment xml:lang="en">A sound, musical passage, or spoken audio component of a creative work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Theme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
    <rdfs:label xml:lang="en">Theme</rdfs:label>
    <rdfs:label xml:lang="ru">Тема</rdfs:label>
    <rdfs:comment xml:lang="en">A subject, idea, or topic addressed by a creative work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#VisualElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
    <rdfs:label xml:lang="en">Visual element</rdfs:label>
    <rdfs:label xml:lang="ru">Визуальный элемент</rdfs:label>
    <rdfs:comment xml:lang="en">An image, shot, symbol, or other visual component of a creative work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#hasOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:label xml:lang="en">has outcome</rdfs:label>
    <rdfs:label xml:lang="ru">имеет результат</rdfs:label>
    <rdfs:comment xml:lang="en">Links a creative response to its outcome. In v2 the domain is CreativeResponse (previously Event).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#PeriodicalArticle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:label xml:lang="en">Periodical article</rdfs:label>
    <rdfs:label xml:lang="ru">Статья в периодике</rdfs:label>
    <rdfs:comment xml:lang="en">An article in a journal, review, magazine, or newspaper. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CreativeAdaptation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#OutcomeType"/>
    <rdfs:label xml:lang="en">Creative adaptation</rdfs:label>
    <rdfs:label xml:lang="ru">Творческая адаптация</rdfs:label>
    <rdfs:comment xml:lang="en">The creator found an alternative form of expression that preserved or transformed the restricted meaning.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#bibliographicCitation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">bibliographic citation</rdfs:label>
    <rdfs:label xml:lang="ru">библиографическая ссылка</rdfs:label>
    <rdfs:comment xml:lang="en">A full bibliographic reference for a source, including page numbers where relevant.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">description</rdfs:label>
    <rdfs:label xml:lang="ru">описание</rdfs:label>
    <rdfs:comment xml:lang="en">A short free-text description of an individual (event, response, constraint, element).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#MusicalWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">Musical work</rdfs:label>
    <rdfs:label xml:lang="ru">Музыкальное произведение</rdfs:label>
    <rdfs:comment xml:lang="en">A creative work expressed primarily through music, with or without lyrics.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b4">
    <rdf:first rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b2"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#VisualArtwork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">Visual artwork</rdfs:label>
    <rdfs:label xml:lang="ru">Произведение изобразительного искусства</rdfs:label>
    <rdfs:comment xml:lang="en">A creative work expressed primarily through visual means: painting, drawing, photograph, sculpture, installation, and similar.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b9">
    <rdf:first rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b6"/>
    <rdf:rest rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/censorcreate#usesStrategy"/>
    <owl:someValuesFrom rdf:resource="http://example.org/censorcreate#CreativeStrategy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#OutcomeType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Outcome type</rdfs:label>
    <rdfs:label xml:lang="ru">Тип результата</rdfs:label>
    <rdfs:comment xml:lang="en">A controlled category describing the result of a creative response, ranging from suppression to creative adaptation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#creationYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">creation year</rdfs:label>
    <rdfs:label xml:lang="ru">год создания</rdfs:label>
    <rdfs:comment xml:lang="en">The year a creative work was created or completed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b1">
    <owl:intersectionOf rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b3"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CensorshipMechanism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Censorship mechanism</rdfs:label>
    <rdfs:label xml:lang="ru">Механизм цензуры</rdfs:label>
    <rdfs:comment xml:lang="en">A method through which censorship is applied to a creative work, such as a ban, removal, or required modification.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#changeNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#Scene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#WorkElement"/>
    <rdfs:label xml:lang="en">Scene</rdfs:label>
    <rdfs:label xml:lang="ru">Сцена</rdfs:label>
    <rdfs:comment xml:lang="en">A distinct scene or episode of a film, play, or narrative.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#PublicationRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Publication restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Ограничение публикации</rdfs:label>
    <rdfs:comment xml:lang="en">A limitation on whether, when, or in what form a work may be published.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#aboutCreativeResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdfs:label xml:lang="en">about creative response</rdfs:label>
    <rdfs:label xml:lang="ru">о творческом ответе</rdfs:label>
    <rdfs:comment xml:lang="en">Links a claim to the creative response it concerns.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#createdBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#Creator"/>
    <rdfs:label xml:lang="en">created by</rdfs:label>
    <rdfs:label xml:lang="ru">создано</rdfs:label>
    <rdfs:comment xml:lang="en">Links a creative work to its creator.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b10">
    <rdf:first rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b7"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#publicationYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">publication year</rdfs:label>
    <rdfs:label xml:lang="ru">год публикации</rdfs:label>
    <rdfs:comment xml:lang="en">The year a source was published.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">title</rdfs:label>
    <rdfs:label xml:lang="ru">название</rdfs:label>
    <rdfs:comment xml:lang="en">The title of a creative work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#PriorApproval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensorshipMechanism"/>
    <rdfs:label xml:lang="en">Prior approval</rdfs:label>
    <rdfs:label xml:lang="ru">Предварительное одобрение</rdfs:label>
    <rdfs:comment xml:lang="en">A requirement that a work be reviewed and approved by an authority before release.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#StylisticRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#ConstraintType"/>
    <rdfs:label xml:lang="en">Stylistic restriction</rdfs:label>
    <rdfs:label xml:lang="ru">Стилистическое ограничение</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint on the artistic style, form, or idiom of a work (for example, condemnation of 'formalism'), rather than on its subject. Added in v2.1.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/censorcreate#hasOutcome"/>
    <owl:hasValue rdf:resource="http://example.org/censorcreate#CreativeAdaptation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#LiteraryWork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdfs:label xml:lang="en">Literary work</rdfs:label>
    <rdfs:label xml:lang="ru">Литературное произведение</rdfs:label>
    <rdfs:comment xml:lang="en">A creative work expressed primarily in written language: novel, poem, play, essay, and similar.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#TestFilm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Film"/>
    <rdfs:label xml:lang="en">Test film</rdfs:label>
    <cc:title>Test Film</cc:title>
    <cc:dataProvenance>synthetic test individual</cc:dataProvenance>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/censorcreate#isTargetOf"/>
    <owl:someValuesFrom rdf:resource="http://example.org/censorcreate#CensorshipEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#documentedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/censorcreate#Event"/>
    <rdfs:range rdf:resource="http://example.org/censorcreate#Source"/>
    <rdfs:label xml:lang="en">documented by</rdfs:label>
    <rdfs:label xml:lang="ru">задокументировано в</rdfs:label>
    <rdfs:comment xml:lang="en">Links a censorship event or creative response to a source that documents it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#WorkElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Work element</rdfs:label>
    <rdfs:label xml:lang="ru">Элемент произведения</rdfs:label>
    <rdfs:comment xml:lang="en">A part or aspect of a creative work that can be targeted by a constraint.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b8">
    <rdf:first rdf:resource="http://example.org/censorcreate#CreativeResponse"/>
    <rdf:rest rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b9"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b3">
    <rdf:first rdf:resource="http://example.org/censorcreate#CreativeWork"/>
    <rdf:rest rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b5">
    <owl:intersectionOf rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b8"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
</rdf:RDF>
