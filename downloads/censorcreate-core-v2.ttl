@prefix :      <http://example.org/censorcreate#> .
@prefix cc:    <http://example.org/censorcreate#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#  ConCreCen — Censorship and Creative Response Core Ontology v2
#################################################################

<http://example.org/censorcreate> a owl:Ontology ;
    owl:versionIRI <http://example.org/censorcreate/2.1> ;
    owl:versionInfo "2.1" ;
    rdfs:label "ConCreCen — Core Ontology v2"@en ;
    dcterms:title "Censorship and Creative Response Core Ontology"@en ;
    rdfs:comment """A core ontology for representing censorship events, the constraints they impose on creative works, the documented creative responses of creators, the strategies used in those responses, their outcomes, and the sources and claims that support them. The model is conditional, not deterministic: censorship may lead to suppression, modification, abandonment, or creative adaptation. Theoretical basis: R. Darnton (censorship as an institutional process), P. D. Stokes (creativity from constraints), B. D. Rosso (enabling and disabling effects of constraints)."""@en ;
    skos:changeNote """v2: (1) domain of hasOutcome narrowed from Event to CreativeResponse; (2) English and Russian labels and English definitions added to all classes, properties and controlled values; (3) DistributionRestriction mechanism and a small set of documentation data properties added; (4) test individuals kept and marked as synthetic; (5) no real historical cases added. v2.1: data properties aligned with project documentation (eventDate, publicationYear); added resultsInWork, StylisticRestriction, Irony, ParatextualFraming, Fragmentation."""@en .

#################################################################
#  Annotation properties
#################################################################

dcterms:title a owl:AnnotationProperty .
skos:changeNote a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .

#################################################################
#  Classes
#################################################################

### Agents

cc:Agent a owl:Class ;
    rdfs:label "Agent"@en , "Агент"@ru ;
    rdfs:comment "A person, group, or institution that can act in a censorship or creative process."@en .

cc:Creator a owl:Class ;
    rdfs:subClassOf cc:Agent ;
    rdfs:label "Creator"@en , "Создатель"@ru ;
    rdfs:comment "An agent who creates a creative work: an author, filmmaker, composer, visual artist, or similar."@en .

cc:CensoringAgent a owl:Class ;
    rdfs:subClassOf cc:Agent ;
    rdfs:label "Censoring agent"@en , "Цензурирующий агент"@ru ;
    rdfs:comment "An agent who imposes or carries out censorship, such as a censor, editor, publisher, board, or platform."@en .

cc:CensoringAuthority a owl:Class ;
    rdfs:subClassOf cc:CensoringAgent ;
    rdfs:label "Censoring authority"@en , "Цензурный орган"@ru ;
    rdfs:comment "An institutional censoring agent with formal power to approve, restrict, or prohibit creative works, such as a state censorship office or official board."@en .

### Creative works

cc:CreativeWork a owl:Class ;
    rdfs:label "Creative work"@en , "Творческое произведение"@ru ;
    rdfs:comment "A product of creative activity, such as a literary work, film, musical work, or visual artwork."@en .

cc:LiteraryWork a owl:Class ;
    rdfs:subClassOf cc:CreativeWork ;
    rdfs:label "Literary work"@en , "Литературное произведение"@ru ;
    rdfs:comment "A creative work expressed primarily in written language: novel, poem, play, essay, and similar."@en .

cc:Film a owl:Class ;
    rdfs:subClassOf cc:CreativeWork ;
    rdfs:label "Film"@en , "Фильм"@ru ;
    rdfs:comment "A creative work expressed as a motion picture."@en .

cc:MusicalWork a owl:Class ;
    rdfs:subClassOf cc:CreativeWork ;
    rdfs:label "Musical work"@en , "Музыкальное произведение"@ru ;
    rdfs:comment "A creative work expressed primarily through music, with or without lyrics."@en .

cc:VisualArtwork a owl:Class ;
    rdfs:subClassOf cc:CreativeWork ;
    rdfs:label "Visual artwork"@en , "Произведение изобразительного искусства"@ru ;
    rdfs:comment "A creative work expressed primarily through visual means: painting, drawing, photograph, sculpture, installation, and similar."@en .

cc:WorkVersion a owl:Class ;
    rdfs:subClassOf cc:CreativeWork ;
    rdfs:label "Work version"@en , "Версия произведения"@ru ;
    rdfs:comment "A specific version of a creative work, for example a revised, cut, re-edited, or alternative version produced in response to censorship."@en .

cc:CensoredWork a owl:Class ;
    rdfs:subClassOf cc:CreativeWork ;
    owl:equivalentClass [
        owl:intersectionOf ( cc:CreativeWork
                             [ a owl:Restriction ;
                               owl:onProperty cc:isTargetOf ;
                               owl:someValuesFrom cc:CensorshipEvent ] ) ;
        a owl:Class
    ] ;
    rdfs:label "Censored work"@en , "Цензурированное произведение"@ru ;
    rdfs:comment "A creative work that is the target of at least one censorship event. Membership is inferred by a reasoner."@en .

### Events

cc:Event a owl:Class ;
    rdfs:label "Event"@en , "Событие"@ru ;
    rdfs:comment "Something that happens at a certain time and involves agents and creative works."@en .

cc:CensorshipEvent a owl:Class ;
    rdfs:subClassOf cc:Event ;
    rdfs:label "Censorship event"@en , "Цензурное событие"@ru ;
    rdfs:comment "A documented act or process of censorship affecting a creative work, carried out by a censoring agent through a censorship mechanism."@en .

cc:CreativeResponse a owl:Class ;
    rdfs:subClassOf cc:Event ;
    rdfs:label "Creative response"@en , "Творческий ответ"@ru ;
    rdfs:comment "A documented action of a creator in reaction to a censorship constraint, for example revising, encoding, relocating, or abandoning a work."@en .

cc:AdaptiveCreativeResponse a owl:Class ;
    rdfs:subClassOf cc:CreativeResponse ;
    owl:equivalentClass [
        owl:intersectionOf ( cc:CreativeResponse
                             [ a owl:Restriction ;
                               owl:onProperty cc:usesStrategy ;
                               owl:someValuesFrom cc:CreativeStrategy ]
                             [ a owl:Restriction ;
                               owl:onProperty cc:hasOutcome ;
                               owl:hasValue cc:CreativeAdaptation ] ) ;
        a owl:Class
    ] ;
    rdfs:label "Adaptive creative response"@en , "Адаптивный творческий ответ"@ru ;
    rdfs:comment "A creative response that uses at least one creative strategy and has the outcome CreativeAdaptation. Membership is inferred by a reasoner."@en .

### Constraints

cc:Constraint a owl:Class ;
    rdfs:label "Constraint"@en , "Ограничение"@ru ;
    rdfs:comment "A limitation on the range of available solutions in a creative process. Constraints may be technical, economic, social, legal, or institutional."@en .

cc:CensorshipConstraint a owl:Class ;
    rdfs:subClassOf cc:Constraint ;
    rdfs:label "Censorship constraint"@en , "Цензурное ограничение"@ru ;
    rdfs:comment "A constraint imposed by a censorship event. Not every constraint is censorship; this class covers only constraints resulting from censorship."@en .

cc:ConstraintType a owl:Class ;
    rdfs:label "Constraint type"@en , "Тип ограничения"@ru ;
    rdfs:comment "A controlled category describing what a censorship constraint restricts, for example content, subject, or direct representation."@en .

### Work elements

cc:WorkElement a owl:Class ;
    rdfs:label "Work element"@en , "Элемент произведения"@ru ;
    rdfs:comment "A part or aspect of a creative work that can be targeted by a constraint."@en .

cc:Scene a owl:Class ;
    rdfs:subClassOf cc:WorkElement ;
    rdfs:label "Scene"@en , "Сцена"@ru ;
    rdfs:comment "A distinct scene or episode of a film, play, or narrative."@en .

cc:Theme a owl:Class ;
    rdfs:subClassOf cc:WorkElement ;
    rdfs:label "Theme"@en , "Тема"@ru ;
    rdfs:comment "A subject, idea, or topic addressed by a creative work."@en .

cc:TextualElement a owl:Class ;
    rdfs:subClassOf cc:WorkElement ;
    rdfs:label "Textual element"@en , "Текстовый элемент"@ru ;
    rdfs:comment "A word, passage, line, title, or lyric within a creative work."@en .

cc:VisualElement a owl:Class ;
    rdfs:subClassOf cc:WorkElement ;
    rdfs:label "Visual element"@en , "Визуальный элемент"@ru ;
    rdfs:comment "An image, shot, symbol, or other visual component of a creative work."@en .

cc:AudioElement a owl:Class ;
    rdfs:subClassOf cc:WorkElement ;
    rdfs:label "Audio element"@en , "Аудиоэлемент"@ru ;
    rdfs:comment "A sound, musical passage, or spoken audio component of a creative work."@en .

### Controlled vocabularies

cc:CensorshipMechanism a owl:Class ;
    rdfs:label "Censorship mechanism"@en , "Механизм цензуры"@ru ;
    rdfs:comment "A method through which censorship is applied to a creative work, such as a ban, removal, or required modification."@en .

cc:CreativeStrategy a owl:Class ;
    rdfs:label "Creative strategy"@en , "Творческая стратегия"@ru ;
    rdfs:comment "A method of expression a creator uses within a creative response, such as allegory, metaphor, or indirect representation."@en .

cc:OutcomeType a owl:Class ;
    rdfs:label "Outcome type"@en , "Тип результата"@ru ;
    rdfs:comment "A controlled category describing the result of a creative response, ranging from suppression to creative adaptation."@en .

### Evidence

cc:Source a owl:Class ;
    rdfs:label "Source"@en , "Источник"@ru ;
    rdfs:comment "A documentary or scholarly source (book, article, archival document, interview, etc.) that provides evidence about events and responses."@en .

cc:Book a owl:Class ;
    rdfs:subClassOf cc:Source ;
    rdfs:label "Book"@en , "Книга"@ru ;
    rdfs:comment "A monograph or edited volume used as a source. Added in v2.1."@en .

cc:BookChapter a owl:Class ;
    rdfs:subClassOf cc:Source ;
    rdfs:label "Book chapter"@en , "Глава книги"@ru ;
    rdfs:comment "A chapter in an edited or collected volume used as a source. Added in v2.1."@en .

cc:PeriodicalArticle a owl:Class ;
    rdfs:subClassOf cc:Source ;
    rdfs:label "Periodical article"@en , "Статья в периодике"@ru ;
    rdfs:comment "An article in a journal, review, magazine, or newspaper. Added in v2.1."@en .

cc:WebSource a owl:Class ;
    rdfs:subClassOf cc:Source ;
    rdfs:label "Web source"@en , "Веб-источник"@ru ;
    rdfs:comment "A web page such as a publisher page, programme note, or encyclopedia entry. Tertiary web sources are used for orientation only. Added in v2.1."@en .

cc:Claim a owl:Class ;
    rdfs:label "Claim"@en , "Утверждение"@ru ;
    rdfs:comment "A statement linking a censorship event and a creative response, supported by one or more sources. Used to make the evidence for each relation explicit."@en .

#################################################################
#  Object properties
#################################################################

cc:createdBy a owl:ObjectProperty ;
    rdfs:domain cc:CreativeWork ;
    rdfs:range cc:Creator ;
    rdfs:label "created by"@en , "создано"@ru ;
    rdfs:comment "Links a creative work to its creator."@en .

cc:targetsWork a owl:ObjectProperty ;
    owl:inverseOf cc:isTargetOf ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CreativeWork ;
    rdfs:label "targets work"@en , "направлено на произведение"@ru ;
    rdfs:comment "Links a censorship event to the creative work it affects."@en .

cc:isTargetOf a owl:ObjectProperty ;
    owl:inverseOf cc:targetsWork ;
    rdfs:domain cc:CreativeWork ;
    rdfs:range cc:CensorshipEvent ;
    rdfs:label "is target of"@en , "является объектом"@ru ;
    rdfs:comment "Inverse of targetsWork: links a creative work to a censorship event that affects it."@en .

cc:imposedBy a owl:ObjectProperty ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CensoringAgent ;
    rdfs:label "imposed by"@en , "наложено"@ru ;
    rdfs:comment "Links a censorship event to the censoring agent responsible for it."@en .

cc:usesMechanism a owl:ObjectProperty ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CensorshipMechanism ;
    rdfs:label "uses mechanism"@en , "использует механизм"@ru ;
    rdfs:comment "Links a censorship event to the mechanism through which censorship was applied."@en .

cc:imposesConstraint a owl:ObjectProperty ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CensorshipConstraint ;
    rdfs:label "imposes constraint"@en , "накладывает ограничение"@ru ;
    rdfs:comment "Links a censorship event to the constraint it creates for the creator."@en .

cc:hasConstraintType a owl:ObjectProperty ;
    rdfs:domain cc:CensorshipConstraint ;
    rdfs:range cc:ConstraintType ;
    rdfs:label "has constraint type"@en , "имеет тип ограничения"@ru ;
    rdfs:comment "Classifies a censorship constraint by what it restricts."@en .

cc:constrainsElement a owl:ObjectProperty ;
    rdfs:domain cc:CensorshipConstraint ;
    rdfs:range cc:WorkElement ;
    rdfs:label "constrains element"@en , "ограничивает элемент"@ru ;
    rdfs:comment "Links a censorship constraint to the specific element of a work it restricts."@en .

cc:hasResponse a owl:ObjectProperty ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CreativeResponse ;
    rdfs:label "has response"@en , "имеет ответ"@ru ;
    rdfs:comment "Links a censorship event to a documented creative response to it."@en .

cc:respondsTo a owl:ObjectProperty ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:CensorshipConstraint ;
    rdfs:label "responds to"@en , "отвечает на"@ru ;
    rdfs:comment "Links a creative response to the censorship constraint it reacts to."@en .

cc:performedBy a owl:ObjectProperty ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:Creator ;
    rdfs:label "performed by"@en , "выполнено"@ru ;
    rdfs:comment "Links a creative response to the creator who carried it out."@en .

cc:usesStrategy a owl:ObjectProperty ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:CreativeStrategy ;
    rdfs:label "uses strategy"@en , "использует стратегию"@ru ;
    rdfs:comment "Links a creative response to the creative strategy used in it."@en .

cc:hasOutcome a owl:ObjectProperty ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:OutcomeType ;
    rdfs:label "has outcome"@en , "имеет результат"@ru ;
    rdfs:comment "Links a creative response to its outcome. In v2 the domain is CreativeResponse (previously Event)."@en .

cc:producesVersion a owl:ObjectProperty ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:WorkVersion ;
    rdfs:label "produces version"@en , "создаёт версию"@ru ;
    rdfs:comment "Links a creative response to a new version of the work that resulted from it."@en .

cc:resultsInWork a owl:ObjectProperty ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:CreativeWork ;
    rdfs:label "results in work"@en , "приводит к произведению"@ru ;
    rdfs:comment "Links a creative response to a new, separate creative work that resulted from it (for a new version of the same work use producesVersion). Added in v2.1."@en .

cc:versionOf a owl:ObjectProperty ;
    rdfs:domain cc:WorkVersion ;
    rdfs:range cc:CreativeWork ;
    rdfs:label "version of"@en , "версия произведения"@ru ;
    rdfs:comment "Links a work version to the original creative work."@en .

cc:documentedBy a owl:ObjectProperty ;
    rdfs:domain cc:Event ;
    rdfs:range cc:Source ;
    rdfs:label "documented by"@en , "задокументировано в"@ru ;
    rdfs:comment "Links a censorship event or creative response to a source that documents it."@en .

cc:supportedBy a owl:ObjectProperty ;
    rdfs:domain cc:Claim ;
    rdfs:range cc:Source ;
    rdfs:label "supported by"@en , "подтверждается"@ru ;
    rdfs:comment "Links a claim to a source that supports it."@en .

cc:aboutCensorshipEvent a owl:ObjectProperty ;
    rdfs:domain cc:Claim ;
    rdfs:range cc:CensorshipEvent ;
    rdfs:label "about censorship event"@en , "о цензурном событии"@ru ;
    rdfs:comment "Links a claim to the censorship event it concerns."@en .

cc:aboutCreativeResponse a owl:ObjectProperty ;
    rdfs:domain cc:Claim ;
    rdfs:range cc:CreativeResponse ;
    rdfs:label "about creative response"@en , "о творческом ответе"@ru ;
    rdfs:comment "Links a claim to the creative response it concerns."@en .

#################################################################
#  Data properties
#################################################################

cc:title a owl:DatatypeProperty ;
    rdfs:domain cc:CreativeWork ;
    rdfs:range xsd:string ;
    rdfs:label "title"@en , "название"@ru ;
    rdfs:comment "The title of a creative work."@en .

cc:creationYear a owl:DatatypeProperty ;
    rdfs:domain cc:CreativeWork ;
    rdfs:range xsd:integer ;
    rdfs:label "creation year"@en , "год создания"@ru ;
    rdfs:comment "The year a creative work was created or completed."@en .

cc:eventDate a owl:DatatypeProperty ;
    rdfs:domain cc:Event ;
    rdfs:range xsd:integer ;
    rdfs:label "event date"@en , "дата события"@ru ;
    rdfs:comment "The year a censorship event or creative response took place (recorded as a year)."@en .

cc:description a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "description"@en , "описание"@ru ;
    rdfs:comment "A short free-text description of an individual (event, response, constraint, element)."@en .

cc:sourceTitle a owl:DatatypeProperty ;
    rdfs:domain cc:Source ;
    rdfs:range xsd:string ;
    rdfs:label "source title"@en , "название источника"@ru ;
    rdfs:comment "The title of a source."@en .

cc:publicationYear a owl:DatatypeProperty ;
    rdfs:domain cc:Source ;
    rdfs:range xsd:integer ;
    rdfs:label "publication year"@en , "год публикации"@ru ;
    rdfs:comment "The year a source was published."@en .

cc:bibliographicCitation a owl:DatatypeProperty ;
    rdfs:domain cc:Source ;
    rdfs:range xsd:string ;
    rdfs:label "bibliographic citation"@en , "библиографическая ссылка"@ru ;
    rdfs:comment "A full bibliographic reference for a source, including page numbers where relevant."@en .

cc:sourceURL a owl:DatatypeProperty ;
    rdfs:domain cc:Source ;
    rdfs:range xsd:anyURI ;
    rdfs:label "source URL"@en , "URL источника"@ru ;
    rdfs:comment "A web address where the source can be accessed."@en .

cc:claimText a owl:DatatypeProperty ;
    rdfs:domain cc:Claim ;
    rdfs:range xsd:string ;
    rdfs:label "claim text"@en , "текст утверждения"@ru ;
    rdfs:comment "The statement made by the claim, in plain language."@en .

cc:confidenceLevel a owl:DatatypeProperty ;
    rdfs:domain cc:Claim ;
    rdfs:range xsd:string ;
    rdfs:label "confidence level"@en , "уровень уверенности"@ru ;
    rdfs:comment "How strongly the sources support the claim: high, medium, or low."@en .

cc:dataProvenance a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "data provenance"@en , "происхождение данных"@ru ;
    rdfs:comment "Marks whether an individual is documented (real case), synthetic (test or AI-generated), or a template."@en .

#################################################################
#  Controlled values: censorship mechanisms
#################################################################

cc:Ban a owl:NamedIndividual , cc:CensorshipMechanism ;
    rdfs:label "Ban"@en , "Запрет"@ru ;
    rdfs:comment "Complete prohibition of publication, performance, distribution, or access."@en .

cc:Removal a owl:NamedIndividual , cc:CensorshipMechanism ;
    rdfs:label "Removal"@en , "Изъятие"@ru ;
    rdfs:comment "Withdrawal of a work, or of a part of it, from circulation, display, or a collection."@en .

cc:Redaction a owl:NamedIndividual , cc:CensorshipMechanism ;
    rdfs:label "Redaction"@en , "Вымарывание"@ru ;
    rdfs:comment "Deletion or obscuring of specific passages, scenes, or elements of a work."@en .

cc:ModificationRequirement a owl:NamedIndividual , cc:CensorshipMechanism ;
    rdfs:label "Modification requirement"@en , "Требование изменений"@ru ;
    rdfs:comment "A demand that the creator alter a work as a condition for approval or release."@en .

cc:PublicationRestriction a owl:NamedIndividual , cc:CensorshipMechanism ;
    rdfs:label "Publication restriction"@en , "Ограничение публикации"@ru ;
    rdfs:comment "A limitation on whether, when, or in what form a work may be published."@en .

cc:DistributionRestriction a owl:NamedIndividual , cc:CensorshipMechanism ;
    rdfs:label "Distribution restriction"@en , "Ограничение распространения"@ru ;
    rdfs:comment "A limitation on the circulation, screening, sale, or audience of a work (added in v2)."@en .

cc:PriorApproval a owl:NamedIndividual , cc:CensorshipMechanism ;
    rdfs:label "Prior approval"@en , "Предварительное одобрение"@ru ;
    rdfs:comment "A requirement that a work be reviewed and approved by an authority before release."@en .

cc:SelfCensorship a owl:NamedIndividual , cc:CensorshipMechanism ;
    rdfs:label "Self-censorship"@en , "Самоцензура"@ru ;
    rdfs:comment "Restriction of expression by the creator in anticipation of censorship or sanctions."@en .

#################################################################
#  Controlled values: constraint types
#################################################################

cc:ContentRestriction a owl:NamedIndividual , cc:ConstraintType ;
    rdfs:label "Content restriction"@en , "Ограничение содержания"@ru ;
    rdfs:comment "A constraint on specific content (passages, images, scenes) that may appear in a work."@en .

cc:SubjectRestriction a owl:NamedIndividual , cc:ConstraintType ;
    rdfs:label "Subject restriction"@en , "Ограничение темы"@ru ;
    rdfs:comment "A constraint on which topics or subjects a work may address."@en .

cc:DirectRepresentationRestriction a owl:NamedIndividual , cc:ConstraintType ;
    rdfs:label "Direct representation restriction"@en , "Запрет прямого изображения"@ru ;
    rdfs:comment "A constraint that forbids showing or naming something directly, while indirect reference may remain possible."@en .

cc:StylisticRestriction a owl:NamedIndividual , cc:ConstraintType ;
    rdfs:label "Stylistic restriction"@en , "Стилистическое ограничение"@ru ;
    rdfs:comment "A constraint on the artistic style, form, or idiom of a work (for example, condemnation of 'formalism'), rather than on its subject. Added in v2.1."@en .

#################################################################
#  Controlled values: creative strategies
#################################################################

cc:Allegory a owl:NamedIndividual , cc:CreativeStrategy ;
    rdfs:label "Allegory"@en , "Аллегория"@ru ;
    rdfs:comment "An extended narrative or image in which the surface story stands for another, restricted meaning."@en .

cc:Metaphor a owl:NamedIndividual , cc:CreativeStrategy ;
    rdfs:label "Metaphor"@en , "Метафора"@ru ;
    rdfs:comment "Expression of a restricted idea through figurative comparison."@en .

cc:Symbolism a owl:NamedIndividual , cc:CreativeStrategy ;
    rdfs:label "Symbolism"@en , "Символизм"@ru ;
    rdfs:comment "Use of objects, images, or signs that stand for restricted ideas."@en .

cc:Euphemism a owl:NamedIndividual , cc:CreativeStrategy ;
    rdfs:label "Euphemism"@en , "Эвфемизм"@ru ;
    rdfs:comment "Replacement of a restricted word or expression with a milder or indirect one."@en .

cc:IndirectRepresentation a owl:NamedIndividual , cc:CreativeStrategy ;
    rdfs:label "Indirect representation"@en , "Косвенное изображение"@ru ;
    rdfs:comment "Showing a restricted subject through suggestion, displacement, or implication rather than directly."@en .

cc:Ambiguity a owl:NamedIndividual , cc:CreativeStrategy ;
    rdfs:label "Ambiguity"@en , "Двусмысленность"@ru ;
    rdfs:comment "Deliberate openness of meaning that allows several readings, including a restricted one."@en .

cc:Irony a owl:NamedIndividual , cc:CreativeStrategy ;
    rdfs:label "Irony"@en , "Ирония"@ru ;
    rdfs:comment "Saying one thing while meaning another, so that criticism is conveyed under an outwardly acceptable surface. Added in v2.1."@en .

cc:ParatextualFraming a owl:NamedIndividual , cc:CreativeStrategy ;
    rdfs:label "Paratextual framing"@en , "Паратекстуальное обрамление"@ru ;
    rdfs:comment "Adding a preface, afterword, commentary, or other accompanying text that guides interpretation and makes the work acceptable to censors. Added in v2.1."@en .

cc:Fragmentation a owl:NamedIndividual , cc:CreativeStrategy ;
    rdfs:label "Fragmentation"@en , "Фрагментация"@ru ;
    rdfs:comment "Breaking a restricted action or representation into a series of short units, each of which stays within the permitted limit. Added in v2.1."@en .

#################################################################
#  Controlled values: outcome types
#################################################################

cc:CreativeAdaptation a owl:NamedIndividual , cc:OutcomeType ;
    rdfs:label "Creative adaptation"@en , "Творческая адаптация"@ru ;
    rdfs:comment "The creator found an alternative form of expression that preserved or transformed the restricted meaning."@en .

cc:Modification a owl:NamedIndividual , cc:OutcomeType ;
    rdfs:label "Modification"@en , "Изменение"@ru ;
    rdfs:comment "The work was altered to comply with the constraint, without documented creative adaptation."@en .

cc:AlternativeVersionProduced a owl:NamedIndividual , cc:OutcomeType ;
    rdfs:label "Alternative version produced"@en , "Создана альтернативная версия"@ru ;
    rdfs:comment "A separate version of the work was produced, for example for a different audience or country."@en .

cc:Suppression a owl:NamedIndividual , cc:OutcomeType ;
    rdfs:label "Suppression"@en , "Подавление"@ru ;
    rdfs:comment "The expression was effectively suppressed and did not reach its audience in the intended form."@en .

cc:UnpublishedWork a owl:NamedIndividual , cc:OutcomeType ;
    rdfs:label "Unpublished work"@en , "Неопубликованное произведение"@ru ;
    rdfs:comment "The work remained unpublished, unreleased, or unexhibited as a result of censorship."@en .

cc:Abandonment a owl:NamedIndividual , cc:OutcomeType ;
    rdfs:label "Abandonment"@en , "Отказ от замысла"@ru ;
    rdfs:comment "The creator abandoned the work or project."@en .

#################################################################
#  Synthetic test case (NOT a historical case)
#################################################################

cc:TestFilm a owl:NamedIndividual , cc:Film ;
    rdfs:label "Test film"@en ;
    cc:title "Test Film" ;
    cc:dataProvenance "synthetic test individual" .

cc:TestEvent a owl:NamedIndividual , cc:CensorshipEvent ;
    rdfs:label "Test censorship event"@en ;
    cc:targetsWork cc:TestFilm ;
    cc:usesMechanism cc:ModificationRequirement ;
    cc:imposesConstraint cc:TestConstraint ;
    cc:hasResponse cc:TestResponse ;
    cc:dataProvenance "synthetic test individual" .

cc:TestConstraint a owl:NamedIndividual , cc:CensorshipConstraint ;
    rdfs:label "Test constraint"@en ;
    cc:hasConstraintType cc:DirectRepresentationRestriction ;
    cc:dataProvenance "synthetic test individual" .

cc:TestResponse a owl:NamedIndividual , cc:CreativeResponse ;
    rdfs:label "Test creative response"@en ;
    cc:respondsTo cc:TestConstraint ;
    cc:usesStrategy cc:Symbolism ;
    cc:hasOutcome cc:CreativeAdaptation ;
    cc:dataProvenance "synthetic test individual" .
