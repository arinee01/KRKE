  <rdf:Description rdf:about="http://example.org/censorcreate#EL_HKR_PartyPrivilegeSatire">
    <cc:description>Ironic portrayal of a Party functionary (Kunze) and his chauffeur (Hinze); apparatchik privilege at the heart of the plot.</cc:description>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#Theme"/>
  </rdf:Description>
