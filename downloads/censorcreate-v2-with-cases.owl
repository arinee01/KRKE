    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAuthority"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/censorcreate#CensoringAgent"/>
    <rdfs:label xml:lang="en">Hauptverwaltung Verlage und Buchhandel (GDR Ministry of Culture)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/censorcreate#CL_Notorious_Kiss">
    <cc:aboutCensorshipEvent rdf:resource="http://example.org/censorcreate#EV_Notorious_PCAReview"/>
    <cc:confidenceLevel>high</cc:confidenceLevel>
    <rdf:type rdf:resource="http://example.org/censorcreate#Claim"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <cc:dataProvenance>documented case</cc:dataProvenance>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_HitchZone_PCA"/>
    <cc:supportedBy rdf:resource="http://example.org/censorcreate#SRC_Billheimer2019"/>
    <cc:aboutCreativeResponse rdf:resource="http://example.org/censorcreate#RE_Notorious_FragmentedKiss"/>
    <cc:claimText>Hitchcock 'concocted' the kiss scene specifically to get around the supposed three-second rule; Bergman recalled that the censors 'couldn't and didn't cut the scene because we never at any one point kissed for more than three seconds'.</cc:claimText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n813a34dfeac14db1aa8af4d2f8263a89b6">
