    :description "Characterisation of Alicia Huberman's sexual morality." .

:EL_Notorious_KissScene a :Scene,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Love scene between Devlin (Cary Grant) and Alicia (Ingrid Bergman) in her Rio apartment." .

:EL_Panahi_FilmmakingActivity a :CreativeActivity,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Film directing and screenplay writing." .

:EL_Shost_ModernistIdiom a :AudioElement,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Dissonant, modernist musical idiom of Lady Macbeth (and of the Fourth Symphony in progress)." .

:EL_Streetcar_CutScenes a :Scene,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Several scenes and lines, including the Stella stairway sequence and dialogue surrounding Stanley's attack on Blanche." .

:EL_Streetcar_SexualThemes a :Theme,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Allan Grey's homosexuality, Blanche's sexuality, Stanley's rape of Blanche, and the moral consequences of Stanley's actions." .

:EV_Ballo_NaplesCensorship1858 a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "The opera intended for Teatro San Carlo in Naples encountered censorial objections to a plot based on the assassination of a monarch. The demanded changes became so extensive that Verdi broke the contract with the Naples theatre and took the project elsewhere." ;
    :documentedBy :SRC_Giger1999_Ballo,
        :SRC_Ricordi_BalloCritical ;
    :eventDate 1858 ;
    :hasResponse :RE_Ballo_LeaveNaples ;
    :imposedBy :NeapolitanCensors ;
    :imposesConstraint :CON_Ballo_Regicide ;
    :targetsWork :GustavoIII_OperaProject ;
    :usesMechanism :ModificationRequirement,
        :PriorApproval .

:EV_Ballo_RomeCensorship1858 a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "The project also underwent censorship in papal Rome. The final compromise relocated the action outside Europe to colonial Boston and transformed the historical Swedish king into the fictional Governor Riccardo, with corresponding changes to character names and political context." ;
    :documentedBy :SRC_Giger1999_Ballo,
        :SRC_Met_Ballo,
        :SRC_Ricordi_BalloCritical ;
    :eventDate 1858 ;
    :hasResponse :RE_Ballo_Transposition ;
    :imposedBy :PapalRomanCensors ;
    :imposesConstraint :CON_Ballo_SovereignRepresentation ;
    :targetsWork :GustavoIII_OperaProject ;
    :usesMechanism :ModificationRequirement,
        :PriorApproval .

:EV_Bulgakov_LiterarySuppression1930s a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "By the late 1920s and 1930s Bulgakov's prospects for publishing original fiction had sharply deteriorated; scholarly accounts describe him as no longer able to publish original fiction while he continued work on The Master and Margarita." ;
    :documentedBy :SRC_Pope1977_Bulgakov,
        :SRC_Rosenshield1997_Bulgakov ;
    :eventDate "1930s" ;
    :hasResponse :RE_Bulgakov_AesopianExpression ;
    :imposedBy :SovietLiteraryEstablishment ;
    :imposesConstraint :CON_Bulgakov_PoliticalExpression ;
    :targetsWork :MasterAndMargarita ;
    :usesMechanism :PublicationRestriction .

:EV_HKR_DistributionStop a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "After publication and hostile reviews (Neues Deutschland; critic Anneliese Löffler), distribution of the novel in the GDR was stopped on 10 September 1985; Höpcke received a formal Party censure. A new GDR edition appeared only in 1988." ;
    :documentedBy :SRC_Darnton1991,
        :SRC_Lance_Metailie ;
    :eventDate 1985 ;
    :imposesConstraint :CON_HKR_Distribution ;
    :targetsWork :HinzeKunzeRoman ;
    :usesMechanism :DistributionRestriction .

:EV_MasterMargarita_MoskvaCensorship1966 a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "The novel's first Soviet publication in Moskva (1966-1967) was authorised only in a heavily cut form. Political and ideological passages, references to the secret police and arrests, attacks on the Soviet literary establishment, and other material were removed." ;
    :documentedBy :SRC_Curtis2019_Bulgakov,
        :SRC_Pope1977_Bulgakov ;
    :eventDate "1966-1967" ;
    :hasResponse :RE_MasterMargarita_TextRestoration ;
    :imposedBy :SovietCensorship_Moskva ;
    :imposesConstraint :CON_MasterMargarita_PublicationCuts ;
    :targetsWork :MasterAndMargarita ;
    :usesMechanism :PublicationRestriction,
        :Redaction .

:EV_Nolde_ProfessionalBan1941 a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "In 1941 Nolde was expelled from the Reich Chamber of Fine Arts and subjected to a professional ban. Official museum sources record that he nevertheless continued producing small-format watercolours, the so-called Unpainted Pictures." ;
    :documentedBy :SRC_NGI_NoldeDegenerate,
        :SRC_NoldeMuseum_Artist ;
    :eventDate 1941 ;
    :hasResponse :RE_Nolde_UnpaintedPictures ;
    :imposedBy :ReichChamberFineArts ;
    :imposesConstraint :CON_Nolde_ProfessionalPractice ;
    :targetsPractice :NoldeArtisticPractice ;
    :usesMechanism :Ban .

:EV_Panahi_2010FilmmakingBan a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "On 20 December 2010, Panahi was sentenced to six years in prison and a 20-year ban on making films, writing screenplays, giving interviews, and travelling abroad. In 2011, Cannes described This Is Not a Film as made under semi-clandestine conditions while the ban was in force." ;
    :documentedBy :SRC_Cannes_Panahi2011,
        :SRC_Cannes_ThisIsNotAFilm2011,
        :SRC_CinemaIranica_TINAF,
        :SRC_IranHumanRights_Panahi2010 ;
    :eventDate 2010 ;
    :hasResponse :RE_Panahi_ThisIsNotAFilm ;
    :imposedBy :TehranRevolutionaryCourt_Branch26 ;
    :imposesConstraint :CON_Panahi_Filmmaking ;
    :targetsPractice :PanahiFilmmakingPractice ;
    :usesMechanism :Ban .

:EV_Pravda1936 a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Unsigned Pravda editorial 'Muddle Instead of Music' (28 January 1936), two days after Stalin attended the opera; further Pravda attacks followed; the opera disappeared from the repertoire (last performance 11 March 1936)." ;
    :documentedBy :SRC_FrolovaWalker2023,
        :SRC_Robinson_BSO,
        :SRC_Wiki_Muddle ;
    :eventDate 1936 ;
    :hasResponse :RE_Shost_FifthSymphony ;
    :imposedBy :Pravda ;
    :imposesConstraint :CON_Shost_Formalism ;
    :targetsWork :LadyMacbethMtsensk ;
    :usesMechanism :Ban,
        :Removal .

:EV_Streetcar_LegionCuts1951 a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "After the film was completed, the Catholic Legion of Decency condemned it. Warner Bros., working with the MPAA and without consulting Kazan, made twelve cuts totalling roughly three to four minutes to obtain an acceptable rating." ;
    :documentedBy :SRC_AFI_Streetcar1951,
        :SRC_Szabo2019_Streetcar ;
    :eventDate 1951 ;
    :hasOutcome :Suppression ;
    :imposedBy :CatholicLegionOfDecency ;
    :imposesConstraint :CON_Streetcar_ReleaseCuts ;
    :targetsWork :Streetcar1951 ;
    :usesMechanism :ModificationRequirement,
        :Removal .

:EV_Streetcar_PCAReview1950 a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "During Production Code Administration review in 1950, the screenplay was challenged over three principal issues: the homosexuality of Blanche's late husband, Blanche's sexual behaviour, and the rape. The PCA proposed plot and dialogue changes before approval." ;
    :documentedBy :SRC_AFI_Streetcar1951,
        :SRC_Szabo2019_Streetcar ;
    :eventDate 1950 ;
    :hasResponse :RE_Streetcar_ScreenplayRewrite ;
    :imposedBy :PCA ;
    :imposesConstraint :CON_Streetcar_SexualContent ;
    :targetsWork :Streetcar1951 ;
    :usesMechanism :ModificationRequirement,
        :PriorApproval .

:EV_Sym4_Cancellation a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Premiere planned for 11 December 1936 (Leningrad Philharmonic, Stiedry) cancelled after rehearsals; officially presented as the composer's withdrawal, while other accounts (Glikman) report pressure from Party and Composers' Union officials." ;
    :documentedBy :SRC_FrolovaWalker2023,
        :SRC_Wiki_Sym4 ;
    :eventDate 1936 ;
    :hasResponse :RE_Sym4_Withdrawal ;
    :imposedBy :SovietComposersUnion ;
    :imposesConstraint :CON_Shost_Formalism ;
    :targetsWork :ShostakovichSymphony4 ;
    :usesMechanism :Ban,
        :SelfCensorship .

