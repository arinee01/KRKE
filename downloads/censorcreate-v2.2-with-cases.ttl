    rdfs:label "Dieter Schlenstedt"@en ;
    :dataProvenance "documented case" .

:EV_HKR_PrintApproval a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Four-year GDR print-approval process: manuscript submitted to Mitteldeutscher Verlag end 1981, passed to the Hauptverwaltung end 1983; negative expert report by Werner Neubert (July 1984); Höpcke changed 'refusal' to 'needs further work'; renewed unsuccessful attempts to obtain changes; approval early 1985." ;
    :documentedBy :SRC_Darnton1991,
        :SRC_GuibertYeche,
        :SRC_Hoepcke1985,
        :SRC_Lance_Metailie,
        :SRC_bpb_Selbstzensur ;
    :eventDate 1985 ;
    :hasResponse :RE_HKR_IronicNarration,
        :RE_HKR_Lesehilfe ;
    :imposedBy :HV_Verlage_Buchhandel ;
    :imposesConstraint :CON_HKR_Ideology ;
    :targetsWork :HinzeKunzeRoman ;
    :usesMechanism :ModificationRequirement,
        :PriorApproval .

:EV_Notorious_PCAReview a :CensorshipEvent,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Production Code Administration review of the script: Joseph Breen called it 'definitely unacceptable' (25 May 1945); a further review (25 July 1945) listed 17 required changes, incl. removing five uses of 'tramp' for Alicia." ;
    :documentedBy :SRC_Billheimer2019,
