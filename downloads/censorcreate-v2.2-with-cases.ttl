        owl:NamedIndividual ;
    rdfs:label "Le Roman de Hinze et Kunze (preface, publisher page)"@en ;
    cc:bibliographicCitation "Lance, A. Preface to V. Braun, Le Roman de Hinze et Kunze. Éditions Métailié (reissue of the 1988 French translation)." ;
    cc:dataProvenance "documented case" ;
