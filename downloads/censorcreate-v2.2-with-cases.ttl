@prefix : <http://example.org/censorcreate#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/censorcreate> a owl:Ontology ;
    rdfs:label "ConCreCen — Core Ontology v2"@en ;
    dcterms:title "Censorship and Creative Response Core Ontology"@en ;
    rdfs:comment "A core ontology for representing censorship events, the constraints they impose on creative works, the documented creative responses of creators, the strategies used in those responses, their outcomes, and the sources and claims that support them. The model is conditional, not deterministic: censorship may lead to suppression, modification, abandonment, or creative adaptation. Theoretical basis: R. Darnton (censorship as an institutional process), P. D. Stokes (creativity from constraints), B. D. Rosso (enabling and disabling effects of constraints)."@en ;
    owl:versionIRI <http://example.org/censorcreate/2.2> ;
    owl:versionInfo "v2.2 (merged: +5 cases, +Editor/+CreativePractice, performedBy->Agent, producesWork unified into resultsInWork)" ;
    skos:changeNote "v2: (1) domain of hasOutcome narrowed from Event to CreativeResponse; (2) English and Russian labels and English definitions added to all classes, properties and controlled values; (3) DistributionRestriction mechanism and a small set of documentation data properties added; (4) test individuals kept and marked as synthetic; (5) no real historical cases added. v2.1: data properties aligned with project documentation (eventDate, publicationYear); added resultsInWork, StylisticRestriction, Irony, ParatextualFraming, Fragmentation."@en .

:AdaptiveCreativeResponse a owl:Class ;
    rdfs:label "Adaptive creative response"@en,
        "Адаптивный творческий ответ"@ru ;
    rdfs:comment "A creative response that uses at least one creative strategy and has the outcome CreativeAdaptation. Membership is inferred by a reasoner."@en ;
    rdfs:subClassOf :CreativeResponse ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :CreativeResponse [ a owl:Restriction ;
                        owl:onProperty :usesStrategy ;
                        owl:someValuesFrom :CreativeStrategy ] [ a owl:Restriction ;
                        owl:hasValue :CreativeAdaptation ;
                        owl:onProperty :hasOutcome ] ) ] .

:CL_Ballo_Naples a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Ballo_NaplesCensorship1858 ;
    :aboutCreativeResponse :RE_Ballo_LeaveNaples ;
    :claimText "Ricordi's critical-edition documentation states that censorship demands were severe enough for Verdi to break the Naples contract; scholarship on Verdi's censorship confirms that Un ballo in maschera had been rejected elsewhere before its Roman premiere." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_Giger1999_Ballo,
        :SRC_Ricordi_BalloCritical .

:CL_Ballo_Transposition a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Ballo_RomeCensorship1858 ;
    :aboutCreativeResponse :RE_Ballo_Transposition ;
    :claimText "The Metropolitan Opera and Verdi critical-edition sources explicitly link the Boston setting and transformed characters to negotiations with the censors. This is a strong example of narrative transposition used to preserve a censored dramatic structure." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_Giger1999_Ballo,
        :SRC_Met_Ballo,
        :SRC_Ricordi_BalloCritical .

:CL_Bulgakov_Aesopian a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Bulgakov_LiterarySuppression1930s ;
    :aboutCreativeResponse :RE_Bulgakov_AesopianExpression ;
    :claimText "The link between Soviet censorship and Aesopian strategies is interpretative rather than a directly documented causal statement by Bulgakov. Rosenshield documents the suppression of Bulgakov's publication opportunities, while Pope discusses Aesopian readings of politically suggestive passages in the novel. This relation should therefore be represented as a Claim, not as unquestioned causality." ;
    :confidenceLevel "medium" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_Pope1977_Bulgakov,
        :SRC_Rosenshield1997_Bulgakov .

:CL_HKR_Distribution a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_HKR_DistributionStop ;
    :claimText "Distribution was stopped on 10 September 1985 (agent not named in the source); Höpcke was 'called on the carpet and given a formal censure'. No documented creative response to this second event." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_Darnton1991,
        :SRC_Lance_Metailie .

:CL_HKR_Irony a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_HKR_PrintApproval ;
    :aboutCreativeResponse :RE_HKR_IronicNarration ;
    :claimText "The preface to the French edition argues that Braun uses the ruse and irony of Enlightenment writers (Diderot's Jacques le fataliste) to pass subversive ideas; the narrator explicitly thematises why so much 'cannot be said directly'. This is an interpretation by the preface author, and the novel was written (1981) before the formal review began." ;
    :confidenceLevel "medium" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_Darnton1991,
        :SRC_Lance_Metailie .

:CL_HKR_Lesehilfe a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_HKR_PrintApproval ;
    :aboutCreativeResponse :RE_HKR_Lesehilfe ;
    :claimText "The 1985 GDR edition appeared with Schlenstedt's text, intended 'd'une part à amadouer la censure, d'autre part à guider le lecteur'; the Suhrkamp edition in the West was published without it." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_GuibertYeche,
        :SRC_Hoepcke1985,
        :SRC_Lance_Metailie,
        :SRC_bpb_Selbstzensur .

:CL_MasterMargarita_Publication a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_MasterMargarita_MoskvaCensorship1966 ;
    :aboutCreativeResponse :RE_MasterMargarita_TextRestoration ;
    :claimText "Curtis documents that the Moskva text was authorised with substantial politically and ideologically motivated cuts and describes the later route to full publication abroad; Pope explicitly distinguishes the censored Moskva edition from complete Russian versions. The posthumous response is performed by an editor/estate representative rather than by the original creator." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_Curtis2019_Bulgakov,
        :SRC_Pope1977_Bulgakov .

:CL_Nolde_Watercolours a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Nolde_ProfessionalBan1941 ;
    :aboutCreativeResponse :RE_Nolde_UnpaintedPictures ;
    :claimText "The Nolde Museum records the 1941 expulsion and professional ban followed by further small-format watercolours; the National Gallery of Ireland states that despite the ban he continued to create, turning to small watercolour compositions painted in secret. Because Nolde had already used this medium before 1941, the claim is about continuation/adaptation under constraint rather than the invention of a new medium." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_NGI_NoldeDegenerate,
        :SRC_NoldeMuseum_Artist .

:CL_Notorious_Character a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Notorious_PCAReview ;
    :claimText "The PCA found Alicia's characterisation unacceptable and listed 17 changes (25 July 1945). How each change was implemented is not yet documented here — to be checked in Billheimer, ch. 14." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_Billheimer2019 .

:CL_Notorious_Kiss a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Notorious_PCAReview ;
    :aboutCreativeResponse :RE_Notorious_FragmentedKiss ;
    :claimText "Hitchcock 'concocted' the kiss scene specifically to get around the supposed three-second rule; Bergman recalled that the censors 'couldn't and didn't cut the scene because we never at any one point kissed for more than three seconds'." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_Billheimer2019,
        :SRC_HitchZone_PCA .

:CL_Panahi_Restrictions a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Panahi_2010FilmmakingBan ;
    :aboutCreativeResponse :RE_Panahi_ThisIsNotAFilm ;
    :claimText "Cannes stated that Panahi and Rasoulof's films were made under semi-clandestine conditions and quoted Panahi that the desire to keep Iranian filmmaking alive motivated them to overcome the restrictions. This Is Not a Film directly documents Panahi's situation as a filmmaker forbidden to work." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_Cannes_Panahi2011,
        :SRC_Cannes_ThisIsNotAFilm2011,
        :SRC_CinemaIranica_TINAF,
        :SRC_IranHumanRights_Panahi2010 .

:CL_Shost_Fifth a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Pravda1936 ;
    :aboutCreativeResponse :RE_Shost_FifthSymphony ;
    :claimText "The Fifth Symphony is documented as Shostakovich's response to the 1936 criticism ('a Soviet artist's creative reply to just criticism') and led to his rehabilitation; whether the finale is sincere or ironic remains debated, so the Ambiguity strategy is an interpretation." ;
    :confidenceLevel "medium" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_FrolovaWalker2023,
        :SRC_Robinson_BSO,
        :SRC_Wiki_Muddle .

:CL_Streetcar_Cuts a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Streetcar_LegionCuts1951 ;
    :claimText "AFI records that the studio made twelve cuts without consulting Kazan and that Kazan believed some cuts changed the interpretation of the characters. This row represents a disabling/suppressive outcome rather than a creative response by the creators." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_AFI_Streetcar1951,
        :SRC_Szabo2019_Streetcar .

:CL_Streetcar_Rewrite a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Streetcar_PCAReview1950 ;
    :aboutCreativeResponse :RE_Streetcar_ScreenplayRewrite ;
    :claimText "AFI's production-history record documents the PCA objections and Williams's rewritten ending, while scholarship on the adaptation describes the film as preserving much of the play's meaning through alterations required by censorship." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_AFI_Streetcar1951,
        :SRC_Szabo2019_Streetcar .

:CL_Sym4_Withdrawal a :Claim,
        owl:NamedIndividual ;
    :aboutCensorshipEvent :EV_Sym4_Cancellation ;
    :aboutCreativeResponse :RE_Sym4_Withdrawal ;
    :claimText "The Fourth Symphony was withdrawn from rehearsal in 1936 and not performed until 1961; sources disagree on whether the withdrawal was voluntary or imposed, hence both SelfCensorship and Ban are recorded." ;
    :confidenceLevel "high" ;
    :dataProvenance "documented case" ;
    :supportedBy :SRC_FrolovaWalker2023,
        :SRC_Wiki_Sym4 .

:CensoredWork a owl:Class ;
    rdfs:label "Censored work"@en,
        "Цензурированное произведение"@ru ;
    rdfs:comment "A creative work that is the target of at least one censorship event. Membership is inferred by a reasoner."@en ;
    rdfs:subClassOf :CreativeWork ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :CreativeWork [ a owl:Restriction ;
                        owl:onProperty :isTargetOf ;
                        owl:someValuesFrom :CensorshipEvent ] ) ] .

:Editor a owl:Class ;
    rdfs:label "Editor" ;
    rdfs:subClassOf :Agent .

:Euphemism a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Euphemism"@en,
        "Эвфемизм"@ru ;
    rdfs:comment "Replacement of a restricted word or expression with a milder or indirect one."@en .

:Metaphor a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Metaphor"@en,
        "Метафора"@ru ;
    rdfs:comment "Expression of a restricted idea through figurative comparison."@en .

:Modification a :OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Modification"@en,
        "Изменение"@ru ;
    rdfs:comment "The work was altered to comply with the constraint, without documented creative adaptation."@en .

:PublicationRestrictionConstraint a :ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Publication restriction сonstraint" ;
    rdfs:comment "A constraint that limits or prevents the publication of a creative work." .

:Streetcar1951_ReleaseCut a :WorkVersion,
        owl:NamedIndividual ;
    rdfs:label "A Streetcar Named Desire (1951 theatrical release with Legion/PCA cuts)"@en ;
    :createdBy :EliaKazan,
        :TennesseeWilliams ;
    :creationYear 1951 ;
    :dataProvenance "documented case" ;
    :title "A Streetcar Named Desire (1951 theatrical release with Legion/PCA cuts)" ;
    :versionOf :Streetcar1951 .

:TestEvent a :CensorshipEvent,
        owl:NamedIndividual ;
    rdfs:label "Test censorship event"@en ;
    :dataProvenance "synthetic test individual" ;
    :hasResponse :TestResponse ;
    :imposesConstraint :TestConstraint ;
    :targetsWork :TestFilm ;
    :usesMechanism :ModificationRequirement .

:VisualElement a owl:Class ;
    rdfs:label "Visual element"@en,
        "Визуальный элемент"@ru ;
    rdfs:comment "An image, shot, symbol, or other visual component of a creative work."@en ;
    rdfs:subClassOf :WorkElement .

:aboutCensorshipEvent a owl:ObjectProperty ;
    rdfs:label "about censorship event"@en,
        "о цензурном событии"@ru ;
    rdfs:comment "Links a claim to the censorship event it concerns."@en ;
    rdfs:domain :Claim ;
    rdfs:range :CensorshipEvent .

:aboutCreativeResponse a owl:ObjectProperty ;
    rdfs:label "about creative response"@en,
        "о творческом ответе"@ru ;
    rdfs:comment "Links a claim to the creative response it concerns."@en ;
    rdfs:domain :Claim ;
    rdfs:range :CreativeResponse .

:bibliographicCitation a owl:DatatypeProperty ;
    rdfs:label "bibliographic citation"@en,
        "библиографическая ссылка"@ru ;
    rdfs:comment "A full bibliographic reference for a source, including page numbers where relevant."@en ;
    rdfs:domain :Source ;
    rdfs:range xsd:string .

:claimText a owl:DatatypeProperty ;
    rdfs:label "claim text"@en,
        "текст утверждения"@ru ;
    rdfs:comment "The statement made by the claim, in plain language."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:string .

:confidenceLevel a owl:DatatypeProperty ;
    rdfs:label "confidence level"@en,
        "уровень уверенности"@ru ;
    rdfs:comment "How strongly the sources support the claim: high, medium, or low."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:string .

:constrainsElement a owl:ObjectProperty ;
    rdfs:label "constrains element"@en,
        "ограничивает элемент"@ru ;
    rdfs:comment "Links a censorship constraint to the specific element of a work it restricts."@en ;
    rdfs:domain :CensorshipConstraint ;
    rdfs:range :WorkElement .

:createdBy a owl:ObjectProperty ;
    rdfs:label "created by"@en,
        "создано"@ru ;
    rdfs:comment "Links a creative work to its creator."@en ;
    rdfs:domain :CreativeWork ;
    rdfs:range :Creator .

:creationYear a owl:DatatypeProperty ;
    rdfs:label "creation year"@en,
        "год создания"@ru ;
    rdfs:comment "The year a creative work was created or completed."@en ;
    rdfs:domain :CreativeWork ;
    rdfs:range xsd:integer .

:dataProvenance a owl:DatatypeProperty ;
    rdfs:label "data provenance"@en,
        "происхождение данных"@ru ;
    rdfs:comment "Marks whether an individual is documented (real case), synthetic (test or AI-generated), or a template."@en ;
    rdfs:range xsd:string .

:description a owl:DatatypeProperty ;
    rdfs:label "description"@en,
        "описание"@ru ;
    rdfs:comment "A short free-text description of an individual (event, response, constraint, element)."@en ;
    rdfs:range xsd:string .

:documentedBy a owl:ObjectProperty ;
    rdfs:label "documented by"@en,
        "задокументировано в"@ru ;
    rdfs:comment "Links a censorship event or creative response to a source that documents it."@en ;
    rdfs:domain :Event ;
    rdfs:range :Source .

:eventDate a owl:DatatypeProperty ;
    rdfs:label "event date"@en,
        "дата события"@ru ;
    rdfs:comment "The year a censorship event or creative response took place (recorded as a year)."@en ;
    rdfs:domain :Event ;
    rdfs:range xsd:integer .

:hasConstraintType a owl:ObjectProperty ;
    rdfs:label "has constraint type"@en,
        "имеет тип ограничения"@ru ;
    rdfs:comment "Classifies a censorship constraint by what it restricts."@en ;
    rdfs:domain :CensorshipConstraint ;
    rdfs:range :ConstraintType .

:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response"@en,
        "имеет ответ"@ru ;
    rdfs:comment "Links a censorship event to a documented creative response to it."@en ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CreativeResponse .

:imposedBy a owl:ObjectProperty ;
    rdfs:label "imposed by"@en,
        "наложено"@ru ;
    rdfs:comment "Links a censorship event to the censoring agent responsible for it."@en ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CensoringAgent .

:imposesConstraint a owl:ObjectProperty ;
    rdfs:label "imposes constraint"@en,
        "накладывает ограничение"@ru ;
    rdfs:comment "Links a censorship event to the constraint it creates for the creator."@en ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CensorshipConstraint .

:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by"@en,
        "выполнено"@ru ;
    rdfs:comment "Links a creative response to the creator who carried it out."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :Agent .

:producesVersion a owl:ObjectProperty ;
    rdfs:label "produces version"@en,
        "создаёт версию"@ru ;
    rdfs:comment "Links a creative response to a new version of the work that resulted from it."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :WorkVersion .

:publicationYear a owl:DatatypeProperty ;
    rdfs:label "publication year"@en,
        "год публикации"@ru ;
    rdfs:comment "The year a source was published."@en ;
    rdfs:domain :Source ;
    rdfs:range xsd:integer .

:respondsTo a owl:ObjectProperty ;
    rdfs:label "responds to"@en,
        "отвечает на"@ru ;
    rdfs:comment "Links a creative response to the censorship constraint it reacts to."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :CensorshipConstraint .

:resultsInWork a owl:ObjectProperty ;
    rdfs:label "results in work"@en,
        "приводит к произведению"@ru ;
    rdfs:comment "Links a creative response to a new, separate creative work that resulted from it (for a new version of the same work use producesVersion). Added in v2.1."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :CreativeWork .

:sourceTitle a owl:DatatypeProperty ;
    rdfs:label "source title"@en,
        "название источника"@ru ;
    rdfs:comment "The title of a source."@en ;
    rdfs:domain :Source ;
    rdfs:range xsd:string .

:sourceURL a owl:DatatypeProperty ;
    rdfs:label "source URL"@en,
        "URL источника"@ru ;
    rdfs:comment "A web address where the source can be accessed."@en ;
    rdfs:domain :Source ;
    rdfs:range xsd:anyURI .

:supportedBy a owl:ObjectProperty ;
    rdfs:label "supported by"@en,
        "подтверждается"@ru ;
    rdfs:comment "Links a claim to a source that supports it."@en ;
    rdfs:domain :Claim ;
    rdfs:range :Source .

:targetsPractice a owl:ObjectProperty ;
    rdfs:label "targetsPractice" ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CreativePractice .

:title a owl:DatatypeProperty ;
    rdfs:label "title"@en,
        "название"@ru ;
    rdfs:comment "The title of a creative work."@en ;
    rdfs:domain :CreativeWork ;
    rdfs:range xsd:string .

:usesMechanism a owl:ObjectProperty ;
    rdfs:label "uses mechanism"@en,
        "использует механизм"@ru ;
    rdfs:comment "Links a censorship event to the mechanism through which censorship was applied."@en ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CensorshipMechanism .

:versionOf a owl:ObjectProperty ;
    rdfs:label "version of"@en,
        "версия произведения"@ru ;
    rdfs:comment "Links a work version to the original creative work."@en ;
    rdfs:domain :WorkVersion ;
    rdfs:range :CreativeWork .

dcterms:title a owl:AnnotationProperty .

skos:changeNote a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

:Abandonment a :OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Abandonment"@en,
        "Отказ от замысла"@ru ;
    rdfs:comment "The creator abandoned the work or project."@en .

:AesopianLanguage a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Aesopian language" ;
    rdfs:comment "A strategy of expressing sensitive meanings indirectly through coded or ambiguous language." .

:Allegory a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Allegory"@en,
        "Аллегория"@ru ;
    rdfs:comment "An extended narrative or image in which the surface story stands for another, restricted meaning."@en .

:AlternativePublication a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Alternative publication" ;
    rdfs:comment "A strategy of publishing a work through an alternative channel when normal publication is restricted." .

:AudioElement a owl:Class ;
    rdfs:label "Audio element"@en,
        "Аудиоэлемент"@ru ;
    rdfs:comment "A sound, musical passage, or spoken audio component of a creative work."@en ;
    rdfs:subClassOf :WorkElement .

:BookChapter a owl:Class ;
    rdfs:label "Book chapter"@en,
        "Глава книги"@ru ;
    rdfs:comment "A chapter in an edited or collected volume used as a source. Added in v2.1."@en ;
    rdfs:subClassOf :Source .

:CON_HKR_Distribution a :CensorshipConstraint,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Circulation of the already published novel halted." ;
    :hasConstraintType :ContentRestriction .

:CON_Notorious_Character a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_Notorious_AliciaCharacter ;
    :dataProvenance "documented case" ;
    :description "Alicia must not appear as a 'grossly immoral woman'; any suggestion of sexual promiscuity to be avoided; the word 'tramp' to be removed." ;
    :hasConstraintType :SubjectRestriction .

:CON_Streetcar_ReleaseCuts a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_Streetcar_CutScenes ;
    :dataProvenance "documented case" ;
    :description "Sexual and 'carnal' material had to be reduced or removed for release without condemnation." ;
    :hasConstraintType :ContentRestriction .

:CatholicLegionOfDecency a :CensoringAgent,
        owl:NamedIndividual ;
    rdfs:label "Catholic Legion of Decency, with MPAA involvement"@en ;
    :dataProvenance "documented case" .

:CharacterTransformation a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Character transformation" ;
    rdfs:comment "A strategy of changing a character’s identity, role, or status to meet censorship constraints." .

:Circumvention a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Circumvention" ;
    rdfs:comment "A strategy of finding a way around a censorship restriction without directly complying with it." .

:Constraint a owl:Class ;
    rdfs:label "Constraint"@en,
        "Ограничение"@ru ;
    rdfs:comment "A limitation on the range of available solutions in a creative process. Constraints may be technical, economic, social, legal, or institutional."@en .

:DistributionRestriction a :CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Distribution restriction"@en,
        "Ограничение распространения"@ru ;
    rdfs:comment "A limitation on the circulation, screening, sale, or audience of a work (added in v2)."@en .

:EL_Ballo_RegicidePlot a :Theme,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "The historical regicide plot based on the assassination of King Gustav III of Sweden." .

:EL_Ballo_SettingCharacters a :Theme,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Historical setting, political status of the protagonist, character identities, and context of the assassination." .

:EL_Bulgakov_PoliticalSatire a :Theme,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Satirical and political treatment of Soviet institutions and social life." .

:EL_HKR_PartyPrivilegeSatire a :Theme,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Ironic portrayal of a Party functionary (Kunze) and his chauffeur (Hinze); apparatchik privilege at the heart of the plot." .

:EL_MasterMargarita_CutPassages a :TextualElement,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Politically sensitive passages, references to arrests and the secret police, attacks on the Soviet literary establishment, sexual/nudity material, and other excised text." .

:EL_Nolde_ArtMaking a :CreativeActivity,
        owl:NamedIndividual ;
    :dataProvenance "documented case" ;
    :description "Professional production and public circulation of visual art." .

:EL_Notorious_AliciaCharacter a :Theme,
        owl:NamedIndividual ;
