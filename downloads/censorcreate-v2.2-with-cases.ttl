@prefix cc: <http://example.org/censorcreate#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/censorcreate> a owl:Ontology ;
    rdfs:label "ConCreCen — Core Ontology v2"@en ;
    dcterms:title "Censorship and Creative Response Core Ontology"@en ;
    rdfs:comment "A core ontology for representing censorship events, the constraints they impose on creative works, the documented creative responses of creators, the strategies used in those responses, their outcomes, and the sources and claims that support them. The model is conditional, not deterministic: censorship may lead to suppression, modification, abandonment, or creative adaptation. Theoretical basis: R. Darnton (censorship as an institutional process), P. D. Stokes (creativity from constraints), B. D. Rosso (enabling and disabling effects of constraints)."@en ;
    owl:versionIRI <http://example.org/censorcreate/2.2> ;
    owl:versionInfo "v2.2 (merged: +5 cases, +Editor/+CreativePractice, performedBy->Agent, producesWork unified into resultsInWork)" ;
    skos:changeNote "v2: (1) domain of hasOutcome narrowed from Event to CreativeResponse; (2) English and Russian labels and English definitions added to all classes, properties and controlled values; (3) DistributionRestriction mechanism and a small set of documentation data properties added; (4) test individuals kept and marked as synthetic; (5) no real historical cases added. v2.1: data properties aligned with project documentation (eventDate, publicationYear); added resultsInWork, StylisticRestriction, Irony, ParatextualFraming, Fragmentation."@en .

cc:AdaptiveCreativeResponse a owl:Class ;
    rdfs:label "Adaptive creative response"@en,
        "Адаптивный творческий ответ"@ru ;
    rdfs:comment "A creative response that uses at least one creative strategy and has the outcome CreativeAdaptation. Membership is inferred by a reasoner."@en ;
    rdfs:subClassOf cc:CreativeResponse ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cc:CreativeResponse [ a owl:Restriction ;
                        owl:onProperty cc:usesStrategy ;
                        owl:someValuesFrom cc:CreativeStrategy ] [ a owl:Restriction ;
                        owl:hasValue cc:CreativeAdaptation ;
                        owl:onProperty cc:hasOutcome ] ) ] .

cc:CL_Ballo_Naples a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Ballo_NaplesCensorship1858 ;
    cc:aboutCreativeResponse cc:RE_Ballo_LeaveNaples ;
    cc:claimText "Ricordi's critical-edition documentation states that censorship demands were severe enough for Verdi to break the Naples contract; scholarship on Verdi's censorship confirms that Un ballo in maschera had been rejected elsewhere before its Roman premiere." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_Giger1999_Ballo,
        cc:SRC_Ricordi_BalloCritical .

cc:CL_Ballo_Transposition a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Ballo_RomeCensorship1858 ;
    cc:aboutCreativeResponse cc:RE_Ballo_Transposition ;
    cc:claimText "The Metropolitan Opera and Verdi critical-edition sources explicitly link the Boston setting and transformed characters to negotiations with the censors. This is a strong example of narrative transposition used to preserve a censored dramatic structure." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_Giger1999_Ballo,
        cc:SRC_Met_Ballo,
        cc:SRC_Ricordi_BalloCritical .

cc:CL_Bulgakov_Aesopian a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Bulgakov_LiterarySuppression1930s ;
    cc:aboutCreativeResponse cc:RE_Bulgakov_AesopianExpression ;
    cc:claimText "The link between Soviet censorship and Aesopian strategies is interpretative rather than a directly documented causal statement by Bulgakov. Rosenshield documents the suppression of Bulgakov's publication opportunities, while Pope discusses Aesopian readings of politically suggestive passages in the novel. This relation should therefore be represented as a Claim, not as unquestioned causality." ;
    cc:confidenceLevel "medium" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_Pope1977_Bulgakov,
        cc:SRC_Rosenshield1997_Bulgakov .

cc:CL_HKR_Distribution a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_HKR_DistributionStop ;
    cc:claimText "Distribution was stopped on 10 September 1985 (agent not named in the source); Höpcke was 'called on the carpet and given a formal censure'. No documented creative response to this second event." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_Darnton1991,
        cc:SRC_Lance_Metailie .

cc:CL_HKR_Irony a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_HKR_PrintApproval ;
    cc:aboutCreativeResponse cc:RE_HKR_IronicNarration ;
    cc:claimText "The preface to the French edition argues that Braun uses the ruse and irony of Enlightenment writers (Diderot's Jacques le fataliste) to pass subversive ideas; the narrator explicitly thematises why so much 'cannot be said directly'. This is an interpretation by the preface author, and the novel was written (1981) before the formal review began." ;
    cc:confidenceLevel "medium" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_Darnton1991,
        cc:SRC_Lance_Metailie .

cc:CL_HKR_Lesehilfe a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_HKR_PrintApproval ;
    cc:aboutCreativeResponse cc:RE_HKR_Lesehilfe ;
    cc:claimText "The 1985 GDR edition appeared with Schlenstedt's text, intended 'd'une part à amadouer la censure, d'autre part à guider le lecteur'; the Suhrkamp edition in the West was published without it." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_GuibertYeche,
        cc:SRC_Hoepcke1985,
        cc:SRC_Lance_Metailie,
        cc:SRC_bpb_Selbstzensur .

cc:CL_MasterMargarita_Publication a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_MasterMargarita_MoskvaCensorship1966 ;
    cc:aboutCreativeResponse cc:RE_MasterMargarita_TextRestoration ;
    cc:claimText "Curtis documents that the Moskva text was authorised with substantial politically and ideologically motivated cuts and describes the later route to full publication abroad; Pope explicitly distinguishes the censored Moskva edition from complete Russian versions. The posthumous response is performed by an editor/estate representative rather than by the original creator." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_Curtis2019_Bulgakov,
        cc:SRC_Pope1977_Bulgakov .

cc:CL_Nolde_Watercolours a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Nolde_ProfessionalBan1941 ;
    cc:aboutCreativeResponse cc:RE_Nolde_UnpaintedPictures ;
    cc:claimText "The Nolde Museum records the 1941 expulsion and professional ban followed by further small-format watercolours; the National Gallery of Ireland states that despite the ban he continued to create, turning to small watercolour compositions painted in secret. Because Nolde had already used this medium before 1941, the claim is about continuation/adaptation under constraint rather than the invention of a new medium." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_NGI_NoldeDegenerate,
        cc:SRC_NoldeMuseum_Artist .

cc:CL_Notorious_Character a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Notorious_PCAReview ;
    cc:claimText "The PCA found Alicia's characterisation unacceptable and listed 17 changes (25 July 1945). How each change was implemented is not yet documented here — to be checked in Billheimer, ch. 14." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_Billheimer2019 .

cc:CL_Notorious_Kiss a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Notorious_PCAReview ;
    cc:aboutCreativeResponse cc:RE_Notorious_FragmentedKiss ;
    cc:claimText "Hitchcock 'concocted' the kiss scene specifically to get around the supposed three-second rule; Bergman recalled that the censors 'couldn't and didn't cut the scene because we never at any one point kissed for more than three seconds'." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_Billheimer2019,
        cc:SRC_HitchZone_PCA .

cc:CL_Panahi_Restrictions a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Panahi_2010FilmmakingBan ;
    cc:aboutCreativeResponse cc:RE_Panahi_ThisIsNotAFilm ;
    cc:claimText "Cannes stated that Panahi and Rasoulof's films were made under semi-clandestine conditions and quoted Panahi that the desire to keep Iranian filmmaking alive motivated them to overcome the restrictions. This Is Not a Film directly documents Panahi's situation as a filmmaker forbidden to work." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_Cannes_Panahi2011,
        cc:SRC_Cannes_ThisIsNotAFilm2011,
        cc:SRC_CinemaIranica_TINAF,
        cc:SRC_IranHumanRights_Panahi2010 .

cc:CL_Shost_Fifth a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Pravda1936 ;
    cc:aboutCreativeResponse cc:RE_Shost_FifthSymphony ;
    cc:claimText "The Fifth Symphony is documented as Shostakovich's response to the 1936 criticism ('a Soviet artist's creative reply to just criticism') and led to his rehabilitation; whether the finale is sincere or ironic remains debated, so the Ambiguity strategy is an interpretation." ;
    cc:confidenceLevel "medium" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_FrolovaWalker2023,
        cc:SRC_Robinson_BSO,
        cc:SRC_Wiki_Muddle .

cc:CL_Streetcar_Cuts a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Streetcar_LegionCuts1951 ;
    cc:claimText "AFI records that the studio made twelve cuts without consulting Kazan and that Kazan believed some cuts changed the interpretation of the characters. This row represents a disabling/suppressive outcome rather than a creative response by the creators." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_AFI_Streetcar1951,
        cc:SRC_Szabo2019_Streetcar .

cc:CL_Streetcar_Rewrite a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Streetcar_PCAReview1950 ;
    cc:aboutCreativeResponse cc:RE_Streetcar_ScreenplayRewrite ;
    cc:claimText "AFI's production-history record documents the PCA objections and Williams's rewritten ending, while scholarship on the adaptation describes the film as preserving much of the play's meaning through alterations required by censorship." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_AFI_Streetcar1951,
        cc:SRC_Szabo2019_Streetcar .

cc:CL_Sym4_Withdrawal a cc:Claim,
        owl:NamedIndividual ;
    cc:aboutCensorshipEvent cc:EV_Sym4_Cancellation ;
    cc:aboutCreativeResponse cc:RE_Sym4_Withdrawal ;
    cc:claimText "The Fourth Symphony was withdrawn from rehearsal in 1936 and not performed until 1961; sources disagree on whether the withdrawal was voluntary or imposed, hence both SelfCensorship and Ban are recorded." ;
    cc:confidenceLevel "high" ;
    cc:dataProvenance "documented case" ;
    cc:supportedBy cc:SRC_FrolovaWalker2023,
        cc:SRC_Wiki_Sym4 .

cc:CensoredWork a owl:Class ;
    rdfs:label "Censored work"@en,
        "Цензурированное произведение"@ru ;
    rdfs:comment "A creative work that is the target of at least one censorship event. Membership is inferred by a reasoner."@en ;
    rdfs:subClassOf cc:CreativeWork ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( cc:CreativeWork [ a owl:Restriction ;
                        owl:onProperty cc:isTargetOf ;
                        owl:someValuesFrom cc:CensorshipEvent ] ) ] .

cc:Editor a owl:Class ;
    rdfs:label "Editor" ;
    rdfs:subClassOf cc:Agent .

cc:Euphemism a cc:CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Euphemism"@en,
        "Эвфемизм"@ru ;
    rdfs:comment "Replacement of a restricted word or expression with a milder or indirect one."@en .

cc:Metaphor a cc:CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Metaphor"@en,
        "Метафора"@ru ;
    rdfs:comment "Expression of a restricted idea through figurative comparison."@en .

cc:Modification a cc:OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Modification"@en,
        "Изменение"@ru ;
    rdfs:comment "The work was altered to comply with the constraint, without documented creative adaptation."@en .

cc:PublicationRestrictionConstraint a cc:ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Publication restriction constraint"@en ;
    rdfs:comment "A constraint that limits or prevents the publication of a creative work." .

cc:Streetcar1951_ReleaseCut a cc:WorkVersion,
        owl:NamedIndividual ;
    rdfs:label "A Streetcar Named Desire (1951 theatrical release with Legion/PCA cuts)"@en ;
    cc:createdBy cc:EliaKazan,
        cc:TennesseeWilliams ;
    cc:creationYear 1951 ;
    cc:dataProvenance "documented case" ;
    cc:title "A Streetcar Named Desire (1951 theatrical release with Legion/PCA cuts)" ;
    cc:versionOf cc:Streetcar1951 .

cc:TestEvent a cc:CensorshipEvent,
        owl:NamedIndividual ;
    rdfs:label "Test censorship event"@en ;
    cc:dataProvenance "synthetic test individual" ;
    cc:hasResponse cc:TestResponse ;
    cc:imposesConstraint cc:TestConstraint ;
    cc:targetsWork cc:TestFilm ;
    cc:usesMechanism cc:ModificationRequirement .

cc:VisualElement a owl:Class ;
    rdfs:label "Visual element"@en,
        "Визуальный элемент"@ru ;
    rdfs:comment "An image, shot, symbol, or other visual component of a creative work."@en ;
    rdfs:subClassOf cc:WorkElement .

cc:aboutCensorshipEvent a owl:ObjectProperty ;
    rdfs:label "about censorship event"@en,
        "о цензурном событии"@ru ;
    rdfs:comment "Links a claim to the censorship event it concerns."@en ;
    rdfs:domain cc:Claim ;
    rdfs:range cc:CensorshipEvent .

cc:aboutCreativeResponse a owl:ObjectProperty ;
    rdfs:label "about creative response"@en,
        "о творческом ответе"@ru ;
    rdfs:comment "Links a claim to the creative response it concerns."@en ;
    rdfs:domain cc:Claim ;
    rdfs:range cc:CreativeResponse .

cc:bibliographicCitation a owl:DatatypeProperty ;
    rdfs:label "bibliographic citation"@en,
        "библиографическая ссылка"@ru ;
    rdfs:comment "A full bibliographic reference for a source, including page numbers where relevant."@en ;
    rdfs:domain cc:Source ;
    rdfs:range xsd:string .

cc:claimText a owl:DatatypeProperty ;
    rdfs:label "claim text"@en,
        "текст утверждения"@ru ;
    rdfs:comment "The statement made by the claim, in plain language."@en ;
    rdfs:domain cc:Claim ;
    rdfs:range xsd:string .

cc:confidenceLevel a owl:DatatypeProperty ;
    rdfs:label "confidence level"@en,
        "уровень уверенности"@ru ;
    rdfs:comment "How strongly the sources support the claim: high, medium, or low."@en ;
    rdfs:domain cc:Claim ;
    rdfs:range xsd:string .

cc:constrainsElement a owl:ObjectProperty ;
    rdfs:label "constrains element"@en,
        "ограничивает элемент"@ru ;
    rdfs:comment "Links a censorship constraint to the specific element of a work it restricts."@en ;
    rdfs:domain cc:CensorshipConstraint ;
    rdfs:range cc:WorkElement .

cc:createdBy a owl:ObjectProperty ;
    rdfs:label "created by"@en,
        "создано"@ru ;
    rdfs:comment "Links a creative work to its creator."@en ;
    rdfs:domain cc:CreativeWork ;
    rdfs:range cc:Creator .

cc:creationYear a owl:DatatypeProperty ;
    rdfs:label "creation year"@en,
        "год создания"@ru ;
    rdfs:comment "The year a creative work was created or completed."@en ;
    rdfs:domain cc:CreativeWork ;
    rdfs:range xsd:integer .

cc:dataProvenance a owl:DatatypeProperty ;
    rdfs:label "data provenance"@en,
        "происхождение данных"@ru ;
    rdfs:comment "Marks whether an individual is documented (real case), synthetic (test or AI-generated), or a template."@en ;
    rdfs:range xsd:string .

cc:description a owl:DatatypeProperty ;
    rdfs:label "description"@en,
        "описание"@ru ;
    rdfs:comment "A short free-text description of an individual (event, response, constraint, element)."@en ;
    rdfs:range xsd:string .

cc:documentedBy a owl:ObjectProperty ;
    rdfs:label "documented by"@en,
        "задокументировано в"@ru ;
    rdfs:comment "Links a censorship event or creative response to a source that documents it."@en ;
    rdfs:domain cc:Event ;
    rdfs:range cc:Source .

cc:eventDate a owl:DatatypeProperty ;
    rdfs:label "event date"@en,
        "дата события"@ru ;
    rdfs:comment "The year a censorship event or creative response took place (recorded as a year)."@en ;
    rdfs:domain cc:Event ;
    rdfs:range xsd:integer .

cc:hasConstraintType a owl:ObjectProperty ;
    rdfs:label "has constraint type"@en,
        "имеет тип ограничения"@ru ;
    rdfs:comment "Classifies a censorship constraint by what it restricts."@en ;
    rdfs:domain cc:CensorshipConstraint ;
    rdfs:range cc:ConstraintType .

cc:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response"@en,
        "имеет ответ"@ru ;
    rdfs:comment "Links a censorship event to a documented creative response to it."@en ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CreativeResponse .

cc:imposedBy a owl:ObjectProperty ;
    rdfs:label "imposed by"@en,
        "наложено"@ru ;
    rdfs:comment "Links a censorship event to the censoring agent responsible for it."@en ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CensoringAgent .

cc:imposesConstraint a owl:ObjectProperty ;
    rdfs:label "imposes constraint"@en,
        "накладывает ограничение"@ru ;
    rdfs:comment "Links a censorship event to the constraint it creates for the creator."@en ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CensorshipConstraint .

cc:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by"@en,
        "выполнено"@ru ;
    rdfs:comment "Links a creative response to the creator who carried it out."@en ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:Agent .

cc:producesVersion a owl:ObjectProperty ;
    rdfs:label "produces version"@en,
        "создаёт версию"@ru ;
    rdfs:comment "Links a creative response to a new version of the work that resulted from it."@en ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:WorkVersion .

cc:publicationYear a owl:DatatypeProperty ;
    rdfs:label "publication year"@en,
        "год публикации"@ru ;
    rdfs:comment "The year a source was published."@en ;
    rdfs:domain cc:Source ;
    rdfs:range xsd:integer .

cc:respondsTo a owl:ObjectProperty ;
    rdfs:label "responds to"@en,
        "отвечает на"@ru ;
    rdfs:comment "Links a creative response to the censorship constraint it reacts to."@en ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:CensorshipConstraint .

cc:resultsInWork a owl:ObjectProperty ;
    rdfs:label "results in work"@en,
        "приводит к произведению"@ru ;
    rdfs:comment "Links a creative response to a new, separate creative work that resulted from it (for a new version of the same work use producesVersion). Added in v2.1."@en ;
    rdfs:domain cc:CreativeResponse ;
    rdfs:range cc:CreativeWork .

cc:sourceTitle a owl:DatatypeProperty ;
    rdfs:label "source title"@en,
        "название источника"@ru ;
    rdfs:comment "The title of a source."@en ;
    rdfs:domain cc:Source ;
    rdfs:range xsd:string .

cc:sourceURL a owl:DatatypeProperty ;
    rdfs:label "source URL"@en,
        "URL источника"@ru ;
    rdfs:comment "A web address where the source can be accessed."@en ;
    rdfs:domain cc:Source ;
    rdfs:range xsd:anyURI .

cc:supportedBy a owl:ObjectProperty ;
    rdfs:label "supported by"@en,
        "подтверждается"@ru ;
    rdfs:comment "Links a claim to a source that supports it."@en ;
    rdfs:domain cc:Claim ;
    rdfs:range cc:Source .

cc:targetsPractice a owl:ObjectProperty ;
    rdfs:label "targetsPractice" ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CreativePractice .

cc:title a owl:DatatypeProperty ;
    rdfs:label "title"@en,
        "название"@ru ;
    rdfs:comment "The title of a creative work."@en ;
    rdfs:domain cc:CreativeWork ;
    rdfs:range xsd:string .

cc:usesMechanism a owl:ObjectProperty ;
    rdfs:label "uses mechanism"@en,
        "использует механизм"@ru ;
    rdfs:comment "Links a censorship event to the mechanism through which censorship was applied."@en ;
    rdfs:domain cc:CensorshipEvent ;
    rdfs:range cc:CensorshipMechanism .

cc:versionOf a owl:ObjectProperty ;
    rdfs:label "version of"@en,
        "версия произведения"@ru ;
    rdfs:comment "Links a work version to the original creative work."@en ;
    rdfs:domain cc:WorkVersion ;
    rdfs:range cc:CreativeWork .

dcterms:title a owl:AnnotationProperty .

skos:changeNote a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

cc:Abandonment a cc:OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Abandonment"@en,
        "Отказ от замысла"@ru ;
    rdfs:comment "The creator abandoned the work or project."@en .

cc:AesopianLanguage a cc:CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Aesopian language"@en ;
    rdfs:comment "A strategy of expressing sensitive meanings indirectly through coded or ambiguous language." .

cc:Allegory a cc:CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Allegory"@en,
        "Аллегория"@ru ;
    rdfs:comment "An extended narrative or image in which the surface story stands for another, restricted meaning."@en .

cc:AlternativePublication a cc:CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Alternative publication"@en ;
    rdfs:comment "A strategy of publishing a work through an alternative channel when normal publication is restricted." .

cc:AudioElement a owl:Class ;
    rdfs:label "Audio element"@en,
        "Аудиоэлемент"@ru ;
    rdfs:comment "A sound, musical passage, or spoken audio component of a creative work."@en ;
    rdfs:subClassOf cc:WorkElement .

cc:BookChapter a owl:Class ;
    rdfs:label "Book chapter"@en,
        "Глава книги"@ru ;
    rdfs:comment "A chapter in an edited or collected volume used as a source. Added in v2.1."@en ;
    rdfs:subClassOf cc:Source .

cc:CON_HKR_Distribution a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Circulation of the already published novel halted." ;
    cc:hasConstraintType cc:ContentRestriction .

cc:CON_Notorious_Character a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Notorious_AliciaCharacter ;
    cc:dataProvenance "documented case" ;
    cc:description "Alicia must not appear as a 'grossly immoral woman'; any suggestion of sexual promiscuity to be avoided; the word 'tramp' to be removed." ;
    cc:hasConstraintType cc:SubjectRestriction .

cc:CON_Streetcar_ReleaseCuts a cc:CensorshipConstraint,
        owl:NamedIndividual ;
    cc:constrainsElement cc:EL_Streetcar_CutScenes ;
    cc:dataProvenance "documented case" ;
    cc:description "Sexual and 'carnal' material had to be reduced or removed for release without condemnation." ;
    cc:hasConstraintType cc:ContentRestriction .

cc:CatholicLegionOfDecency a cc:CensoringAgent,
        owl:NamedIndividual ;
    rdfs:label "Catholic Legion of Decency, with MPAA involvement"@en ;
    cc:dataProvenance "documented case" .

cc:CharacterTransformation a cc:CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Character transformation"@en ;
    rdfs:comment "A strategy of changing a character’s identity, role, or status to meet censorship constraints." .

cc:Circumvention a cc:CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Circumvention"@en ;
    rdfs:comment "A strategy of finding a way around a censorship restriction without directly complying with it." .

cc:Constraint a owl:Class ;
    rdfs:label "Constraint"@en,
        "Ограничение"@ru ;
    rdfs:comment "A limitation on the range of available solutions in a creative process. Constraints may be technical, economic, social, legal, or institutional."@en .

cc:DistributionRestriction a cc:CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Distribution restriction"@en,
        "Ограничение распространения"@ru ;
    rdfs:comment "A limitation on the circulation, screening, sale, or audience of a work (added in v2)."@en .

cc:EL_Ballo_RegicidePlot a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "The historical regicide plot based on the assassination of King Gustav III of Sweden." .

cc:EL_Ballo_SettingCharacters a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Historical setting, political status of the protagonist, character identities, and context of the assassination." .

cc:EL_Bulgakov_PoliticalSatire a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Satirical and political treatment of Soviet institutions and social life." .

cc:EL_HKR_PartyPrivilegeSatire a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Ironic portrayal of a Party functionary (Kunze) and his chauffeur (Hinze); apparatchik privilege at the heart of the plot." .

cc:EL_MasterMargarita_CutPassages a cc:TextualElement,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Politically sensitive passages, references to arrests and the secret police, attacks on the Soviet literary establishment, sexual/nudity material, and other excised text." .

cc:EL_Nolde_ArtMaking a cc:CreativeActivity,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Professional production and public circulation of visual art." .

cc:EL_Notorious_AliciaCharacter a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Characterisation of Alicia Huberman's sexual morality." .

cc:EL_Notorious_KissScene a cc:Scene,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Love scene between Devlin (Cary Grant) and Alicia (Ingrid Bergman) in her Rio apartment." .

cc:EL_Panahi_FilmmakingActivity a cc:CreativeActivity,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Film directing and screenplay writing." .

cc:EL_Shost_ModernistIdiom a cc:AudioElement,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Dissonant, modernist musical idiom of Lady Macbeth (and of the Fourth Symphony in progress)." .

cc:EL_Streetcar_CutScenes a cc:Scene,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Several scenes and lines, including the Stella stairway sequence and dialogue surrounding Stanley's attack on Blanche." .

cc:EL_Streetcar_SexualThemes a cc:Theme,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Allan Grey's homosexuality, Blanche's sexuality, Stanley's rape of Blanche, and the moral consequences of Stanley's actions." .

cc:EV_Ballo_NaplesCensorship1858 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "The opera intended for Teatro San Carlo in Naples encountered censorial objections to a plot based on the assassination of a monarch. The demanded changes became so extensive that Verdi broke the contract with the Naples theatre and took the project elsewhere." ;
    cc:documentedBy cc:SRC_Giger1999_Ballo,
        cc:SRC_Ricordi_BalloCritical ;
    cc:eventDate 1858 ;
    cc:hasResponse cc:RE_Ballo_LeaveNaples ;
    cc:imposedBy cc:NeapolitanCensors ;
    cc:imposesConstraint cc:CON_Ballo_Regicide ;
    cc:targetsWork cc:GustavoIII_OperaProject ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

cc:EV_Ballo_RomeCensorship1858 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "The project also underwent censorship in papal Rome. The final compromise relocated the action outside Europe to colonial Boston and transformed the historical Swedish king into the fictional Governor Riccardo, with corresponding changes to character names and political context." ;
    cc:documentedBy cc:SRC_Giger1999_Ballo,
        cc:SRC_Met_Ballo,
        cc:SRC_Ricordi_BalloCritical ;
    cc:eventDate 1858 ;
    cc:hasResponse cc:RE_Ballo_Transposition ;
    cc:imposedBy cc:PapalRomanCensors ;
    cc:imposesConstraint cc:CON_Ballo_SovereignRepresentation ;
    cc:targetsWork cc:GustavoIII_OperaProject ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

cc:EV_Bulgakov_LiterarySuppression1930s a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "By the late 1920s and 1930s Bulgakov's prospects for publishing original fiction had sharply deteriorated; scholarly accounts describe him as no longer able to publish original fiction while he continued work on The Master and Margarita." ;
    cc:documentedBy cc:SRC_Pope1977_Bulgakov,
        cc:SRC_Rosenshield1997_Bulgakov ;
    cc:eventDate "1930s" ;
    cc:hasResponse cc:RE_Bulgakov_AesopianExpression ;
    cc:imposedBy cc:SovietLiteraryEstablishment ;
    cc:imposesConstraint cc:CON_Bulgakov_PoliticalExpression ;
    cc:targetsWork cc:MasterAndMargarita ;
    cc:usesMechanism cc:PublicationRestriction .

cc:EV_HKR_DistributionStop a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "After publication and hostile reviews (Neues Deutschland; critic Anneliese Löffler), distribution of the novel in the GDR was stopped on 10 September 1985; Höpcke received a formal Party censure. A new GDR edition appeared only in 1988." ;
    cc:documentedBy cc:SRC_Darnton1991,
        cc:SRC_Lance_Metailie ;
    cc:eventDate 1985 ;
    cc:imposesConstraint cc:CON_HKR_Distribution ;
    cc:targetsWork cc:HinzeKunzeRoman ;
    cc:usesMechanism cc:DistributionRestriction .

cc:EV_MasterMargarita_MoskvaCensorship1966 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "The novel's first Soviet publication in Moskva (1966-1967) was authorised only in a heavily cut form. Political and ideological passages, references to the secret police and arrests, attacks on the Soviet literary establishment, and other material were removed." ;
    cc:documentedBy cc:SRC_Curtis2019_Bulgakov,
        cc:SRC_Pope1977_Bulgakov ;
    cc:eventDate "1966-1967" ;
    cc:hasResponse cc:RE_MasterMargarita_TextRestoration ;
    cc:imposedBy cc:SovietCensorship_Moskva ;
    cc:imposesConstraint cc:CON_MasterMargarita_PublicationCuts ;
    cc:targetsWork cc:MasterAndMargarita ;
    cc:usesMechanism cc:PublicationRestriction,
        cc:Redaction .

cc:EV_Nolde_ProfessionalBan1941 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "In 1941 Nolde was expelled from the Reich Chamber of Fine Arts and subjected to a professional ban. Official museum sources record that he nevertheless continued producing small-format watercolours, the so-called Unpainted Pictures." ;
    cc:documentedBy cc:SRC_NGI_NoldeDegenerate,
        cc:SRC_NoldeMuseum_Artist ;
    cc:eventDate 1941 ;
    cc:hasResponse cc:RE_Nolde_UnpaintedPictures ;
    cc:imposedBy cc:ReichChamberFineArts ;
    cc:imposesConstraint cc:CON_Nolde_ProfessionalPractice ;
    cc:targetsPractice cc:NoldeArtisticPractice ;
    cc:usesMechanism cc:Ban .

cc:EV_Panahi_2010FilmmakingBan a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "On 20 December 2010, Panahi was sentenced to six years in prison and a 20-year ban on making films, writing screenplays, giving interviews, and travelling abroad. In 2011, Cannes described This Is Not a Film as made under semi-clandestine conditions while the ban was in force." ;
    cc:documentedBy cc:SRC_Cannes_Panahi2011,
        cc:SRC_Cannes_ThisIsNotAFilm2011,
        cc:SRC_CinemaIranica_TINAF,
        cc:SRC_IranHumanRights_Panahi2010 ;
    cc:eventDate 2010 ;
    cc:hasResponse cc:RE_Panahi_ThisIsNotAFilm ;
    cc:imposedBy cc:TehranRevolutionaryCourt_Branch26 ;
    cc:imposesConstraint cc:CON_Panahi_Filmmaking ;
    cc:targetsPractice cc:PanahiFilmmakingPractice ;
    cc:usesMechanism cc:Ban .

cc:EV_Pravda1936 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Unsigned Pravda editorial 'Muddle Instead of Music' (28 January 1936), two days after Stalin attended the opera; further Pravda attacks followed; the opera disappeared from the repertoire (last performance 11 March 1936)." ;
    cc:documentedBy cc:SRC_FrolovaWalker2023,
        cc:SRC_Robinson_BSO,
        cc:SRC_Wiki_Muddle ;
    cc:eventDate 1936 ;
    cc:hasResponse cc:RE_Shost_FifthSymphony ;
    cc:imposedBy cc:Pravda ;
    cc:imposesConstraint cc:CON_Shost_Formalism ;
    cc:targetsWork cc:LadyMacbethMtsensk ;
    cc:usesMechanism cc:Ban,
        cc:Removal .

cc:EV_Streetcar_LegionCuts1951 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "After the film was completed, the Catholic Legion of Decency condemned it. Warner Bros., working with the MPAA and without consulting Kazan, made twelve cuts totalling roughly three to four minutes to obtain an acceptable rating." ;
    cc:documentedBy cc:SRC_AFI_Streetcar1951,
        cc:SRC_Szabo2019_Streetcar ;
    cc:eventDate 1951 ;
    cc:hasOutcome cc:Suppression ;
    cc:imposedBy cc:CatholicLegionOfDecency ;
    cc:imposesConstraint cc:CON_Streetcar_ReleaseCuts ;
    cc:targetsWork cc:Streetcar1951 ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:Removal .

cc:EV_Streetcar_PCAReview1950 a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "During Production Code Administration review in 1950, the screenplay was challenged over three principal issues: the homosexuality of Blanche's late husband, Blanche's sexual behaviour, and the rape. The PCA proposed plot and dialogue changes before approval." ;
    cc:documentedBy cc:SRC_AFI_Streetcar1951,
        cc:SRC_Szabo2019_Streetcar ;
    cc:eventDate 1950 ;
    cc:hasResponse cc:RE_Streetcar_ScreenplayRewrite ;
    cc:imposedBy cc:PCA ;
    cc:imposesConstraint cc:CON_Streetcar_SexualContent ;
    cc:targetsWork cc:Streetcar1951 ;
    cc:usesMechanism cc:ModificationRequirement,
        cc:PriorApproval .

cc:EV_Sym4_Cancellation a cc:CensorshipEvent,
        owl:NamedIndividual ;
    cc:dataProvenance "documented case" ;
    cc:description "Premiere planned for 11 December 1936 (Leningrad Philharmonic, Stiedry) cancelled after rehearsals; officially presented as the composer's withdrawal, while other accounts (Glikman) report pressure from Party and Composers' Union officials." ;
    cc:documentedBy cc:SRC_FrolovaWalker2023,
        cc:SRC_Wiki_Sym4 ;
    cc:eventDate 1936 ;
    cc:hasResponse cc:RE_Sym4_Withdrawal ;
    cc:imposedBy cc:SovietComposersUnion ;
    cc:imposesConstraint cc:CON_Shost_Formalism ;
    cc:targetsWork cc:ShostakovichSymphony4 ;
    cc:usesMechanism cc:Ban,
        cc:SelfCensorship .

