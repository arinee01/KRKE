    cc:sourceURL "https://editions-metailie.com/livre/le-roman-de-hinze-et-kunze/"^^xsd:anyURI .

cc:WorkElement a owl:Class ;
    rdfs:label "Work element"@en,
        "Элемент произведения"@ru ;
    rdfs:comment "A part or aspect of a creative work that can be targeted by a constraint."@en .

cc:WorkVersion a owl:Class ;
    rdfs:label "Work version"@en,
        "Версия произведения"@ru ;
    rdfs:comment "A specific version of a creative work, for example a revised, cut, re-edited, or alternative version produced in response to censorship."@en ;
    rdfs:subClassOf cc:CreativeWork .

cc:CensoringAuthority a owl:Class ;
    rdfs:label "Censoring authority"@en,
        "Цензурный орган"@ru ;
    rdfs:comment "An institutional censoring agent with formal power to approve, restrict, or prohibit creative works, such as a state censorship office or official board."@en ;
    rdfs:subClassOf cc:CensoringAgent .

cc:CensorshipMechanism a owl:Class ;
    rdfs:label "Censorship mechanism"@en,
        "Механизм цензуры"@ru ;
    rdfs:comment "A method through which censorship is applied to a creative work, such as a ban, removal, or required modification."@en .

cc:ConstraintType a owl:Class ;
    rdfs:label "Constraint type"@en,
        "Тип ограничения"@ru ;
    rdfs:comment "A controlled category describing what a censorship constraint restricts, for example content, subject, or direct representation."@en .

cc:CreativeAdaptation a cc:OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Creative adaptation"@en,
        "Творческая адаптация"@ru ;
    rdfs:comment "The creator found an alternative form of expression that preserved or transformed the restricted meaning."@en .

cc:Source a owl:Class ;
    rdfs:label "Source"@en,
        "Источник"@ru ;
    rdfs:comment "A documentary or scholarly source (book, article, archival document, interview, etc.) that provides evidence about events and responses."@en .

cc:CreativeWork a owl:Class ;
    rdfs:label "Creative work"@en,
        "Творческое произведение"@ru ;
    rdfs:comment "A product of creative activity, such as a literary work, film, musical work, or visual artwork."@en .

cc:Creator a owl:Class ;
    rdfs:label "Creator"@en,
        "Создатель"@ru ;
    rdfs:comment "An agent who creates a creative work: an author, filmmaker, composer, visual artist, or similar."@en ;
    rdfs:subClassOf cc:Agent .

cc:WebSource a owl:Class ;
    rdfs:label "Web source"@en,
        "Веб-источник"@ru ;
    rdfs:comment "A web page such as a publisher page, programme note, or encyclopedia entry. Tertiary web sources are used for orientation only. Added in v2.1."@en ;
    rdfs:subClassOf cc:Source .

cc:CensorshipConstraint a owl:Class ;
    rdfs:label "Censorship constraint"@en,
        "Цензурное ограничение"@ru ;
    rdfs:comment "A constraint imposed by a censorship event. Not every constraint is censorship; this class covers only constraints resulting from censorship."@en ;
    rdfs:subClassOf cc:Constraint .

cc:Claim a owl:Class ;
    rdfs:label "Claim"@en,
        "Утверждение"@ru ;
    rdfs:comment "A statement linking a censorship event and a creative response, supported by one or more sources. Used to make the evidence for each relation explicit."@en .

cc:CensorshipEvent a owl:Class ;
    rdfs:label "Censorship event"@en,
        "Цензурное событие"@ru ;
    rdfs:comment "A documented act or process of censorship affecting a creative work, carried out by a censoring agent through a censorship mechanism."@en ;
    rdfs:subClassOf cc:Event .

cc:CreativeResponse a owl:Class ;
    rdfs:label "Creative response"@en,
        "Творческий ответ"@ru ;
    rdfs:comment "A documented action of a creator in reaction to a censorship constraint, for example revising, encoding, relocating, or abandoning a work."@en ;
    rdfs:subClassOf cc:Event .

cc:CreativeStrategy a owl:Class ;
    rdfs:label "Creative strategy"@en,
        "Творческая стратегия"@ru ;
    rdfs:comment "A method of expression a creator uses within a creative response, such as allegory, metaphor, or indirect representation."@en .

