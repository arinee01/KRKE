:CON_Ballo_Regicide a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_Ballo_RegicidePlot ;
    :dataProvenance "documented case" ;
    :description "A royal assassination and the sovereign status of the protagonist could not be represented in the proposed form." ;
    :hasConstraintType :DirectRepresentationRestriction,
        :SubjectRestriction .

:CON_Ballo_SovereignRepresentation a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_Ballo_SettingCharacters ;
    :dataProvenance "documented case" ;
    :description "The central assassination plot could remain only after the sovereign and European political context were transformed." ;
    :hasConstraintType :DirectRepresentationRestriction,
        :SubjectRestriction .

:CON_Bulgakov_PoliticalExpression a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_Bulgakov_PoliticalSatire ;
    :dataProvenance "documented case" ;
    :description "Political and satirical expression had to be developed in an environment in which Bulgakov could not expect normal publication of original fiction." ;
    :hasConstraintType :ExpressionRestriction,
        :PublicationRestriction .

:CON_MasterMargarita_PublicationCuts a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_MasterMargarita_CutPassages ;
    :dataProvenance "documented case" ;
    :description "Only a substantially abridged version of the novel could appear in the Soviet journal." ;
    :hasConstraintType :ContentRestriction .

:CON_Nolde_ProfessionalPractice a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_Nolde_ArtMaking ;
    :dataProvenance "documented case" ;
    :description "The professional ban prevented Nolde from officially practising, exhibiting, and selling art and limited his access to normal artistic materials and channels." ;
    :hasConstraintType :MaterialRestriction,
        :ProfessionalPracticeRestriction .

:CON_Notorious_Kissing a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_Notorious_KissScene ;
    :dataProvenance "documented case" ;
    :description "Production Code: 'Excessive and lustful kissing ... are not to be shown'; enforced through an unofficial rule of thumb that a screen kiss should not exceed about three seconds." ;
    :hasConstraintType :ContentRestriction,
        :DirectRepresentationRestriction .

:CON_Panahi_Filmmaking a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_Panahi_FilmmakingActivity ;
    :dataProvenance "documented case" ;
    :description "Panahi was prohibited from making or directing films and from writing screenplays for twenty years." ;
    :hasConstraintType :ExpressionRestriction,
        :ProfessionalPracticeRestriction .

:CON_Streetcar_SexualContent a :CensorshipConstraint,
        owl:NamedIndividual ;
    :constrainsElement :EL_Streetcar_SexualThemes ;
    :dataProvenance "documented case" ;
    :description "The adaptation could not directly represent or clearly state several sexual themes in the same form as the play, and the filmmakers were pressed to alter their treatment." ;
    :hasConstraintType :ContentRestriction,
        :DirectRepresentationRestriction,
        :SubjectRestriction .

:DieterSchlenstedt a :Creator,
