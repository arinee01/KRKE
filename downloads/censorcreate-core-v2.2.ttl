@prefix : <http://example.org/censorcreate#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/censorcreate> a owl:Ontology ;
    rdfs:label "ConCreCen — Core Ontology v2"@en ;
    dcterms:title "Censorship and Creative Response Core Ontology"@en ;
    rdfs:comment "A core ontology for representing censorship events, the constraints they impose on creative works, the documented creative responses of creators, the strategies used in those responses, their outcomes, and the sources and claims that support them. The model is conditional, not deterministic: censorship may lead to suppression, modification, abandonment, or creative adaptation. Theoretical basis: R. Darnton (censorship as an institutional process), P. D. Stokes (creativity from constraints), B. D. Rosso (enabling and disabling effects of constraints)."@en ;
    owl:versionIRI <http://example.org/censorcreate/2.2> ;
    owl:versionInfo "v2.2 (merged: +5 cases, +Editor/+CreativePractice, performedBy->Agent, producesWork unified into resultsInWork)" ;
    skos:changeNote "v2: (1) domain of hasOutcome narrowed from Event to CreativeResponse; (2) English and Russian labels and English definitions added to all classes, properties and controlled values; (3) DistributionRestriction mechanism and a small set of documentation data properties added; (4) test individuals kept and marked as synthetic; (5) no real historical cases added. v2.1: data properties aligned with project documentation (eventDate, publicationYear); added resultsInWork, StylisticRestriction, Irony, ParatextualFraming, Fragmentation."@en .

:Abandonment a :OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Abandonment"@en,
        "Отказ от замысла"@ru ;
    rdfs:comment "The creator abandoned the work or project."@en .

:AdaptiveCreativeResponse a owl:Class ;
    rdfs:label "Adaptive creative response"@en,
        "Адаптивный творческий ответ"@ru ;
    rdfs:comment "A creative response that uses at least one creative strategy and has the outcome CreativeAdaptation. Membership is inferred by a reasoner."@en ;
    rdfs:subClassOf :CreativeResponse ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :CreativeResponse [ a owl:Restriction ;
                        owl:onProperty :usesStrategy ;
                        owl:someValuesFrom :CreativeStrategy ] [ a owl:Restriction ;
                        owl:hasValue :CreativeAdaptation ;
                        owl:onProperty :hasOutcome ] ) ] .

:AesopianLanguage a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Aesopian language" ;
    rdfs:comment "A strategy of expressing sensitive meanings indirectly through coded or ambiguous language." .

:Allegory a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Allegory"@en,
        "Аллегория"@ru ;
    rdfs:comment "An extended narrative or image in which the surface story stands for another, restricted meaning."@en .

:AlternativePublication a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Alternative publication" ;
    rdfs:comment "A strategy of publishing a work through an alternative channel when normal publication is restricted." .

:AlternativeVersionProduced a :OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Alternative version produced"@en,
        "Создана альтернативная версия"@ru ;
    rdfs:comment "A separate version of the work was produced, for example for a different audience or country."@en .

:Ambiguity a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Ambiguity"@en,
        "Двусмысленность"@ru ;
    rdfs:comment "Deliberate openness of meaning that allows several readings, including a restricted one."@en .

:AudioElement a owl:Class ;
    rdfs:label "Audio element"@en,
        "Аудиоэлемент"@ru ;
    rdfs:comment "A sound, musical passage, or spoken audio component of a creative work."@en ;
    rdfs:subClassOf :WorkElement .

:Ban a :CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Ban"@en,
        "Запрет"@ru ;
    rdfs:comment "Complete prohibition of publication, performance, distribution, or access."@en .

:Book a owl:Class ;
    rdfs:label "Book"@en,
        "Книга"@ru ;
    rdfs:comment "A monograph or edited volume used as a source. Added in v2.1."@en ;
    rdfs:subClassOf :Source .

:BookChapter a owl:Class ;
    rdfs:label "Book chapter"@en,
        "Глава книги"@ru ;
    rdfs:comment "A chapter in an edited or collected volume used as a source. Added in v2.1."@en ;
    rdfs:subClassOf :Source .

:CensoredWork a owl:Class ;
    rdfs:label "Censored work"@en,
        "Цензурированное произведение"@ru ;
    rdfs:comment "A creative work that is the target of at least one censorship event. Membership is inferred by a reasoner."@en ;
    rdfs:subClassOf :CreativeWork ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :CreativeWork [ a owl:Restriction ;
                        owl:onProperty :isTargetOf ;
                        owl:someValuesFrom :CensorshipEvent ] ) ] .

:CensoringAuthority a owl:Class ;
    rdfs:label "Censoring authority"@en,
        "Цензурный орган"@ru ;
    rdfs:comment "An institutional censoring agent with formal power to approve, restrict, or prohibit creative works, such as a state censorship office or official board."@en ;
    rdfs:subClassOf :CensoringAgent .

:CharacterTransformation a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Character transformation" ;
    rdfs:comment "A strategy of changing a character’s identity, role, or status to meet censorship constraints." .

:Circumvention a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Circumvention" ;
    rdfs:comment "A strategy of finding a way around a censorship restriction without directly complying with it." .

:ContentRestriction a :ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Content restriction"@en,
        "Ограничение содержания"@ru ;
    rdfs:comment "A constraint on specific content (passages, images, scenes) that may appear in a work."@en .

:DistributionRestriction a :CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Distribution restriction"@en,
        "Ограничение распространения"@ru ;
    rdfs:comment "A limitation on the circulation, screening, sale, or audience of a work (added in v2)."@en .

:Editor a owl:Class ;
    rdfs:label "Editor" ;
    rdfs:subClassOf :Agent .

:Euphemism a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Euphemism"@en,
        "Эвфемизм"@ru ;
    rdfs:comment "Replacement of a restricted word or expression with a milder or indirect one."@en .

:ExpressionRestriction a :ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Expression restriction" ;
    rdfs:comment "A constraint that limits how ideas, themes, or meanings may be expressed." .

:Fragmentation a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Fragmentation"@en,
        "Фрагментация"@ru ;
    rdfs:comment "Breaking a restricted action or representation into a series of short units, each of which stays within the permitted limit. Added in v2.1."@en .

:HistoricalDisplacement a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Historical displacement" ;
    rdfs:comment "Moving sensitive content to another historical context to reduce its directness." .

:IndirectRepresentation a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Indirect representation"@en,
        "Косвенное изображение"@ru ;
    rdfs:comment "Showing a restricted subject through suggestion, displacement, or implication rather than directly."@en .

:InstitutionalCircumvention a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Institutional circumvention" ;
    rdfs:comment "Avoiding or bypassing the institution imposing the restriction." .

:Irony a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Irony"@en,
        "Ирония"@ru ;
    rdfs:comment "Saying one thing while meaning another, so that criticism is conveyed under an outwardly acceptable surface. Added in v2.1."@en .

:LiteraryWork a owl:Class ;
    rdfs:label "Literary work"@en,
        "Литературное произведение"@ru ;
    rdfs:comment "A creative work expressed primarily in written language: novel, poem, play, essay, and similar."@en ;
    rdfs:subClassOf :CreativeWork .

:MaterialRestriction a :ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Material restriction" ;
    rdfs:comment "A constraint that limits the materials or technical means available for creative work." .

:MediumAdaptation a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Medium adaptation" ;
    rdfs:comment "Сhanging the artistic medium or technique in response to a constraint." .

:Metaphor a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Metaphor"@en,
        "Метафора"@ru ;
    rdfs:comment "Expression of a restricted idea through figurative comparison."@en .

:MinimalProduction a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Minimal production" ;
    rdfs:comment "Reducing production scale or resources to continue creating under restrictions." .

:Modification a :OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Modification"@en,
        "Изменение"@ru ;
    rdfs:comment "The work was altered to comply with the constraint, without documented creative adaptation."@en .

:MusicalWork a owl:Class ;
    rdfs:label "Musical work"@en,
        "Музыкальное произведение"@ru ;
    rdfs:comment "A creative work expressed primarily through music, with or without lyrics."@en ;
    rdfs:subClassOf :CreativeWork .

:NarrativeModification a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Narrative modification" ;
    rdfs:comment "Altering plot, dialogue, or story structure in response to censorship." .

:NarrativeTransposition a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Narrative transposition" ;
    rdfs:comment "Relocating a narrative to a different setting or context while preserving its core structure." .

:ParatextualFraming a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Paratextual framing"@en,
        "Паратекстуальное обрамление"@ru ;
    rdfs:comment "Adding a preface, afterword, commentary, or other accompanying text that guides interpretation and makes the work acceptable to censors. Added in v2.1."@en .

:PeriodicalArticle a owl:Class ;
    rdfs:label "Periodical article"@en,
        "Статья в периодике"@ru ;
    rdfs:comment "An article in a journal, review, magazine, or newspaper. Added in v2.1."@en ;
    rdfs:subClassOf :Source .

:PriorApproval a :CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Prior approval"@en,
        "Предварительное одобрение"@ru ;
    rdfs:comment "A requirement that a work be reviewed and approved by an authority before release."@en .

:ProfessionalPracticeRestriction a :ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Professional practice restriction" ;
    rdfs:comment "A constraint that limits or prohibits a creator from carrying out their professional creative activity." .

:PublicationRestriction a :CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Publication restriction"@en,
        "Ограничение публикации"@ru ;
    rdfs:comment "A limitation on whether, when, or in what form a work may be published."@en .

:PublicationRestrictionConstraint a :ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Publication restriction сonstraint" ;
    rdfs:comment "A constraint that limits or prevents the publication of a creative work." .

:Redaction a :CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Redaction"@en,
        "Вымарывание"@ru ;
    rdfs:comment "Deletion or obscuring of specific passages, scenes, or elements of a work."@en .

:Removal a :CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Removal"@en,
        "Изъятие"@ru ;
    rdfs:comment "Withdrawal of a work, or of a part of it, from circulation, display, or a collection."@en .

:Satire a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Satire" ;
    rdfs:comment "Using irony, exaggeration, or ridicule to express criticism indirectly." .

:Scene a owl:Class ;
    rdfs:label "Scene"@en,
        "Сцена"@ru ;
    rdfs:comment "A distinct scene or episode of a film, play, or narrative."@en ;
    rdfs:subClassOf :WorkElement .

:SecretProduction a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Secret production" ;
    rdfs:comment "Creating a work privately or clandestinely when public production is prohibited." .

:SelfCensorship a :CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Self-censorship"@en,
        "Самоцензура"@ru ;
    rdfs:comment "Restriction of expression by the creator in anticipation of censorship or sanctions."@en .

:SelfReflexivity a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Self-reflexivity" ;
    rdfs:comment "A strategy in which the work explicitly reflects on its own creation, form, or conditions of production." .

:StylisticRestriction a :ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Stylistic restriction"@en,
        "Стилистическое ограничение"@ru ;
    rdfs:comment "A constraint on the artistic style, form, or idiom of a work (for example, condemnation of 'formalism'), rather than on its subject. Added in v2.1."@en .

:SubjectRestriction a :ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Subject restriction"@en,
        "Ограничение темы"@ru ;
    rdfs:comment "A constraint on which topics or subjects a work may address."@en .

:Suppression a :OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Suppression"@en,
        "Подавление"@ru ;
    rdfs:comment "The expression was effectively suppressed and did not reach its audience in the intended form."@en .

:TestEvent a :CensorshipEvent,
        owl:NamedIndividual ;
    rdfs:label "Test censorship event"@en ;
    :dataProvenance "synthetic test individual" ;
    :hasResponse :TestResponse ;
    :imposesConstraint :TestConstraint ;
    :targetsWork :TestFilm ;
    :usesMechanism :ModificationRequirement .

:TextualElement a owl:Class ;
    rdfs:label "Textual element"@en,
        "Текстовый элемент"@ru ;
    rdfs:comment "A word, passage, line, title, or lyric within a creative work."@en ;
    rdfs:subClassOf :WorkElement .

:TextualRestoration a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Textual restoration" ;
    rdfs:comment "Restoring material removed or altered by censorship." .

:Theme a owl:Class ;
    rdfs:label "Theme"@en,
        "Тема"@ru ;
    rdfs:comment "A subject, idea, or topic addressed by a creative work."@en ;
    rdfs:subClassOf :WorkElement .

:UnpublishedWork a :OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Unpublished work"@en,
        "Неопубликованное произведение"@ru ;
    rdfs:comment "The work remained unpublished, unreleased, or unexhibited as a result of censorship."@en .

:VisualArtwork a owl:Class ;
    rdfs:label "Visual artwork"@en,
        "Произведение изобразительного искусства"@ru ;
    rdfs:comment "A creative work expressed primarily through visual means: painting, drawing, photograph, sculpture, installation, and similar."@en ;
    rdfs:subClassOf :CreativeWork .

:VisualElement a owl:Class ;
    rdfs:label "Visual element"@en,
        "Визуальный элемент"@ru ;
    rdfs:comment "An image, shot, symbol, or other visual component of a creative work."@en ;
    rdfs:subClassOf :WorkElement .

:WebSource a owl:Class ;
    rdfs:label "Web source"@en,
        "Веб-источник"@ru ;
    rdfs:comment "A web page such as a publisher page, programme note, or encyclopedia entry. Tertiary web sources are used for orientation only. Added in v2.1."@en ;
    rdfs:subClassOf :Source .

:aboutCensorshipEvent a owl:ObjectProperty ;
    rdfs:label "about censorship event"@en,
        "о цензурном событии"@ru ;
    rdfs:comment "Links a claim to the censorship event it concerns."@en ;
    rdfs:domain :Claim ;
    rdfs:range :CensorshipEvent .

:aboutCreativeResponse a owl:ObjectProperty ;
    rdfs:label "about creative response"@en,
        "о творческом ответе"@ru ;
    rdfs:comment "Links a claim to the creative response it concerns."@en ;
    rdfs:domain :Claim ;
    rdfs:range :CreativeResponse .

:bibliographicCitation a owl:DatatypeProperty ;
    rdfs:label "bibliographic citation"@en,
        "библиографическая ссылка"@ru ;
    rdfs:comment "A full bibliographic reference for a source, including page numbers where relevant."@en ;
    rdfs:domain :Source ;
    rdfs:range xsd:string .

:claimText a owl:DatatypeProperty ;
    rdfs:label "claim text"@en,
        "текст утверждения"@ru ;
    rdfs:comment "The statement made by the claim, in plain language."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:string .

:confidenceLevel a owl:DatatypeProperty ;
    rdfs:label "confidence level"@en,
        "уровень уверенности"@ru ;
    rdfs:comment "How strongly the sources support the claim: high, medium, or low."@en ;
    rdfs:domain :Claim ;
    rdfs:range xsd:string .

:constrainsElement a owl:ObjectProperty ;
    rdfs:label "constrains element"@en,
        "ограничивает элемент"@ru ;
    rdfs:comment "Links a censorship constraint to the specific element of a work it restricts."@en ;
    rdfs:domain :CensorshipConstraint ;
    rdfs:range :WorkElement .

:createdBy a owl:ObjectProperty ;
    rdfs:label "created by"@en,
        "создано"@ru ;
    rdfs:comment "Links a creative work to its creator."@en ;
    rdfs:domain :CreativeWork ;
    rdfs:range :Creator .

:creationYear a owl:DatatypeProperty ;
    rdfs:label "creation year"@en,
        "год создания"@ru ;
    rdfs:comment "The year a creative work was created or completed."@en ;
    rdfs:domain :CreativeWork ;
    rdfs:range xsd:integer .

:dataProvenance a owl:DatatypeProperty ;
    rdfs:label "data provenance"@en,
        "происхождение данных"@ru ;
    rdfs:comment "Marks whether an individual is documented (real case), synthetic (test or AI-generated), or a template."@en ;
    rdfs:range xsd:string .

:description a owl:DatatypeProperty ;
    rdfs:label "description"@en,
        "описание"@ru ;
    rdfs:comment "A short free-text description of an individual (event, response, constraint, element)."@en ;
    rdfs:range xsd:string .

:documentedBy a owl:ObjectProperty ;
    rdfs:label "documented by"@en,
        "задокументировано в"@ru ;
    rdfs:comment "Links a censorship event or creative response to a source that documents it."@en ;
    rdfs:domain :Event ;
    rdfs:range :Source .

:eventDate a owl:DatatypeProperty ;
    rdfs:label "event date"@en,
        "дата события"@ru ;
    rdfs:comment "The year a censorship event or creative response took place (recorded as a year)."@en ;
    rdfs:domain :Event ;
    rdfs:range xsd:integer .

:hasConstraintType a owl:ObjectProperty ;
    rdfs:label "has constraint type"@en,
        "имеет тип ограничения"@ru ;
    rdfs:comment "Classifies a censorship constraint by what it restricts."@en ;
    rdfs:domain :CensorshipConstraint ;
    rdfs:range :ConstraintType .

:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response"@en,
        "имеет ответ"@ru ;
    rdfs:comment "Links a censorship event to a documented creative response to it."@en ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CreativeResponse .

:imposedBy a owl:ObjectProperty ;
    rdfs:label "imposed by"@en,
        "наложено"@ru ;
    rdfs:comment "Links a censorship event to the censoring agent responsible for it."@en ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CensoringAgent .

:imposesConstraint a owl:ObjectProperty ;
    rdfs:label "imposes constraint"@en,
        "накладывает ограничение"@ru ;
    rdfs:comment "Links a censorship event to the constraint it creates for the creator."@en ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CensorshipConstraint .

:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by"@en,
        "выполнено"@ru ;
    rdfs:comment "Links a creative response to the creator who carried it out."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :Agent .

:producesVersion a owl:ObjectProperty ;
    rdfs:label "produces version"@en,
        "создаёт версию"@ru ;
    rdfs:comment "Links a creative response to a new version of the work that resulted from it."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :WorkVersion .

:publicationYear a owl:DatatypeProperty ;
    rdfs:label "publication year"@en,
        "год публикации"@ru ;
    rdfs:comment "The year a source was published."@en ;
    rdfs:domain :Source ;
    rdfs:range xsd:integer .

:respondsTo a owl:ObjectProperty ;
    rdfs:label "responds to"@en,
        "отвечает на"@ru ;
    rdfs:comment "Links a creative response to the censorship constraint it reacts to."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :CensorshipConstraint .

:resultsInWork a owl:ObjectProperty ;
    rdfs:label "results in work"@en,
        "приводит к произведению"@ru ;
    rdfs:comment "Links a creative response to a new, separate creative work that resulted from it (for a new version of the same work use producesVersion). Added in v2.1."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :CreativeWork .

:sourceTitle a owl:DatatypeProperty ;
    rdfs:label "source title"@en,
        "название источника"@ru ;
    rdfs:comment "The title of a source."@en ;
    rdfs:domain :Source ;
    rdfs:range xsd:string .

:sourceURL a owl:DatatypeProperty ;
    rdfs:label "source URL"@en,
        "URL источника"@ru ;
    rdfs:comment "A web address where the source can be accessed."@en ;
    rdfs:domain :Source ;
    rdfs:range xsd:anyURI .

:supportedBy a owl:ObjectProperty ;
    rdfs:label "supported by"@en,
        "подтверждается"@ru ;
    rdfs:comment "Links a claim to a source that supports it."@en ;
    rdfs:domain :Claim ;
    rdfs:range :Source .

:targetsPractice a owl:ObjectProperty ;
    rdfs:label "targetsPractice" ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CreativePractice .

:title a owl:DatatypeProperty ;
    rdfs:label "title"@en,
        "название"@ru ;
    rdfs:comment "The title of a creative work."@en ;
    rdfs:domain :CreativeWork ;
    rdfs:range xsd:string .

:usesMechanism a owl:ObjectProperty ;
    rdfs:label "uses mechanism"@en,
        "использует механизм"@ru ;
    rdfs:comment "Links a censorship event to the mechanism through which censorship was applied."@en ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CensorshipMechanism .

:versionOf a owl:ObjectProperty ;
    rdfs:label "version of"@en,
        "версия произведения"@ru ;
    rdfs:comment "Links a work version to the original creative work."@en ;
    rdfs:domain :WorkVersion ;
    rdfs:range :CreativeWork .

dcterms:title a owl:AnnotationProperty .

skos:changeNote a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

:Constraint a owl:Class ;
    rdfs:label "Constraint"@en,
        "Ограничение"@ru ;
    rdfs:comment "A limitation on the range of available solutions in a creative process. Constraints may be technical, economic, social, legal, or institutional."@en .

:CreativePractice a owl:Class .

:Creator a owl:Class ;
    rdfs:label "Creator"@en,
        "Создатель"@ru ;
    rdfs:comment "An agent who creates a creative work: an author, filmmaker, composer, visual artist, or similar."@en ;
    rdfs:subClassOf :Agent .

:DirectRepresentationRestriction a :ConstraintType,
        owl:NamedIndividual ;
    rdfs:label "Direct representation restriction"@en,
        "Запрет прямого изображения"@ru ;
    rdfs:comment "A constraint that forbids showing or naming something directly, while indirect reference may remain possible."@en .

:Film a owl:Class ;
    rdfs:label "Film"@en,
        "Фильм"@ru ;
    rdfs:comment "A creative work expressed as a motion picture."@en ;
    rdfs:subClassOf :CreativeWork .

:ModificationRequirement a :CensorshipMechanism,
        owl:NamedIndividual ;
    rdfs:label "Modification requirement"@en,
        "Требование изменений"@ru ;
    rdfs:comment "A demand that the creator alter a work as a condition for approval or release."@en .

:Symbolism a :CreativeStrategy,
        owl:NamedIndividual ;
    rdfs:label "Symbolism"@en,
        "Символизм"@ru ;
    rdfs:comment "Use of objects, images, or signs that stand for restricted ideas."@en .

:TestFilm a :Film,
        owl:NamedIndividual ;
    rdfs:label "Test film"@en ;
    :dataProvenance "synthetic test individual" ;
    :title "Test Film" .

:TestResponse a :CreativeResponse,
        owl:NamedIndividual ;
    rdfs:label "Test creative response"@en ;
    :dataProvenance "synthetic test individual" ;
    :hasOutcome :CreativeAdaptation ;
    :respondsTo :TestConstraint ;
    :usesStrategy :Symbolism .

:hasOutcome a owl:ObjectProperty ;
    rdfs:label "has outcome"@en,
        "имеет результат"@ru ;
    rdfs:comment "Links a creative response to its outcome. In v2 the domain is CreativeResponse (previously Event)."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :OutcomeType .

:isTargetOf a owl:ObjectProperty ;
    rdfs:label "is target of"@en,
        "является объектом"@ru ;
    rdfs:comment "Inverse of targetsWork: links a creative work to a censorship event that affects it."@en ;
    rdfs:domain :CreativeWork ;
    rdfs:range :CensorshipEvent ;
    owl:inverseOf :targetsWork .

:targetsWork a owl:ObjectProperty ;
    rdfs:label "targets work"@en,
        "направлено на произведение"@ru ;
    rdfs:comment "Links a censorship event to the creative work it affects."@en ;
    rdfs:domain :CensorshipEvent ;
    rdfs:range :CreativeWork .

:usesStrategy a owl:ObjectProperty ;
    rdfs:label "uses strategy"@en,
        "использует стратегию"@ru ;
    rdfs:comment "Links a creative response to the creative strategy used in it."@en ;
    rdfs:domain :CreativeResponse ;
    rdfs:range :CreativeStrategy .

:CensoringAgent a owl:Class ;
    rdfs:label "Censoring agent"@en,
        "Цензурирующий агент"@ru ;
    rdfs:comment "An agent who imposes or carries out censorship, such as a censor, editor, publisher, board, or platform."@en ;
    rdfs:subClassOf :Agent .

:CreativeAdaptation a :OutcomeType,
        owl:NamedIndividual ;
    rdfs:label "Creative adaptation"@en,
        "Творческая адаптация"@ru ;
    rdfs:comment "The creator found an alternative form of expression that preserved or transformed the restricted meaning."@en .

:TestConstraint a :CensorshipConstraint,
        owl:NamedIndividual ;
    rdfs:label "Test constraint"@en ;
    :dataProvenance "synthetic test individual" ;
    :hasConstraintType :DirectRepresentationRestriction .

:WorkVersion a owl:Class ;
    rdfs:label "Work version"@en,
        "Версия произведения"@ru ;
    rdfs:comment "A specific version of a creative work, for example a revised, cut, re-edited, or alternative version produced in response to censorship."@en ;
    rdfs:subClassOf :CreativeWork .

:Agent a owl:Class ;
    rdfs:label "Agent"@en,
        "Агент"@ru ;
    rdfs:comment "A person, group, or institution that can act in a censorship or creative process."@en .

:Event a owl:Class ;
    rdfs:label "Event"@en,
        "Событие"@ru ;
    rdfs:comment "Something that happens at a certain time and involves agents and creative works."@en .

:CensorshipConstraint a owl:Class ;
    rdfs:label "Censorship constraint"@en,
        "Цензурное ограничение"@ru ;
    rdfs:comment "A constraint imposed by a censorship event. Not every constraint is censorship; this class covers only constraints resulting from censorship."@en ;
    rdfs:subClassOf :Constraint .

:Claim a owl:Class ;
    rdfs:label "Claim"@en,
        "Утверждение"@ru ;
    rdfs:comment "A statement linking a censorship event and a creative response, supported by one or more sources. Used to make the evidence for each relation explicit."@en .

:WorkElement a owl:Class ;
    rdfs:label "Work element"@en,
        "Элемент произведения"@ru ;
    rdfs:comment "A part or aspect of a creative work that can be targeted by a constraint."@en .

:OutcomeType a owl:Class ;
    rdfs:label "Outcome type"@en,
        "Тип результата"@ru ;
    rdfs:comment "A controlled category describing the result of a creative response, ranging from suppression to creative adaptation."@en .

:CensorshipMechanism a owl:Class ;
    rdfs:label "Censorship mechanism"@en,
        "Механизм цензуры"@ru ;
    rdfs:comment "A method through which censorship is applied to a creative work, such as a ban, removal, or required modification."@en .

:ConstraintType a owl:Class ;
    rdfs:label "Constraint type"@en,
        "Тип ограничения"@ru ;
    rdfs:comment "A controlled category describing what a censorship constraint restricts, for example content, subject, or direct representation."@en .

:CensorshipEvent a owl:Class ;
    rdfs:label "Censorship event"@en,
        "Цензурное событие"@ru ;
    rdfs:comment "A documented act or process of censorship affecting a creative work, carried out by a censoring agent through a censorship mechanism."@en ;
    rdfs:subClassOf :Event .

:Source a owl:Class ;
    rdfs:label "Source"@en,
        "Источник"@ru ;
    rdfs:comment "A documentary or scholarly source (book, article, archival document, interview, etc.) that provides evidence about events and responses."@en .

:CreativeResponse a owl:Class ;
    rdfs:label "Creative response"@en,
        "Творческий ответ"@ru ;
    rdfs:comment "A documented action of a creator in reaction to a censorship constraint, for example revising, encoding, relocating, or abandoning a work."@en ;
    rdfs:subClassOf :Event .

:CreativeWork a owl:Class ;
    rdfs:label "Creative work"@en,
        "Творческое произведение"@ru ;
    rdfs:comment "A product of creative activity, such as a literary work, film, musical work, or visual artwork."@en .

:CreativeStrategy a owl:Class ;
    rdfs:label "Creative strategy"@en,
        "Творческая стратегия"@ru ;
    rdfs:comment "A method of expression a creator uses within a creative response, such as allegory, metaphor, or indirect representation."@en .

